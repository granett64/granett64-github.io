  <desc>GrandHotelsOfA1</desc>
  <url>https://labs.geocaching.com/goto/41e6db47-55b2-4547-bd52-86378f12a5f9</url>
  <urlname>Grand Hotels of Albany : S1 The Albany Hotel by MummaBear5</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1199" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Grand Hotels of Albany : S1 The Albany Hotel</groundspeak:name>
   <groundspeak:placed_by>MummaBear5</groundspeak:placed_by>
   <groundspeak:owner id="">MummaBear5</groundspeak:owner>
