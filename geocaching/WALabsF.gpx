  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99000426" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Views from Victoria Gardens : S5 Niche Wall Mural</groundspeak:name>
   <groundspeak:placed_by>Paskersfind</groundspeak:placed_by>
   <groundspeak:owner id="">Paskersfind</groundspeak:owner>
