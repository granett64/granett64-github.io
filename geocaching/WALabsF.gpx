  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-43" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] The Lake Dumbleyung : S3 The Campbells are coming!</groundspeak:name>
   <groundspeak:placed_by>Everlasting</groundspeak:placed_by>
   <groundspeak:owner id="">Everlasting</groundspeak:owner>
