  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476912231" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>An Excursion around Perth's Queens Gardens : S4 The Gazebo</groundspeak:name>
