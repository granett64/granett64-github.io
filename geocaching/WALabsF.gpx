  <url>https://labs.geocaching.com/goto/65dc793a-8aaf-4175-81a7-53e90db1229c</url>
  <urlname>WAQuokka AdLab Art #071 : S5 The Norfolk Hotel Carving by The Machman</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918815" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #071 : S5 The Norfolk Hotel Carving</groundspeak:name>
   <groundspeak:placed_by>The Machman</groundspeak:placed_by>
   <groundspeak:owner id="">The Machman</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
