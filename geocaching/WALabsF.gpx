   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #036&lt;/h3&gt;&lt;h4&gt;Welcome Walls stage 1&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/53c83958-e60d-4d16-ae9f-11404bf951c6"&gt;https://labs.geocaching.com/goto/53c83958-e60d-4d16-ae9f-11404bf951c6&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;When was the first stage of the Welcome Walls launched&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/b1fbc488-9bd9-41e5-8f92-9e947e101c7a" /&gt;&lt;/p&gt;&lt;p&gt;Located adjacent to the Western Australian Museum – Maritime at Victoria Quay, Fremantle, the Welcome Walls pay tribute to some 45,000 immigrants to Western Australia.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/49172e36-4272-4049-9fd7-596fa5283260" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.

This AdLab explores the Welcome Walls which can be found outside the Western Australian Maritime Museum and on their website.



&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.0529" lon="115.738267">
  <ele>1.0</ele>
  <time>2025-05-26T08:00:00Z</time>
  <name>LBi3hv-02</name>
  <desc>WAQuokkaAdLa03l</desc>
  <url>https://labs.geocaching.com/goto/53c83958-e60d-4d16-ae9f-11404bf951c6</url>
  <urlname>WAQuokka AdLab Art #036 : S2 Welcome Walls Stage 2 by WA K Team</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1573" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #036 : S2 Welcome Walls Stage 2</groundspeak:name>
   <groundspeak:placed_by>WA K Team</groundspeak:placed_by>
   <groundspeak:owner id="">WA K Team</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #036&lt;/h3&gt;&lt;h4&gt;Welcome Walls Stage 2&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/53c83958-e60d-4d16-ae9f-11404bf951c6"&gt;https://labs.geocaching.com/goto/53c83958-e60d-4d16-ae9f-11404bf951c6&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many inscriptions are on the Welcome Walls in Fremantle&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/5219c8f9-3dea-4f35-a33a-f7adf97d6604" /&gt;&lt;/p&gt;&lt;p&gt;More than one third of Western Australia’s population was born overseas. The Welcome Walls projects pay tribute to those migrants who arrived by sea, landing at Fremantle or Albany, and to the many benefits they gave to their new home, enriching the lives of all Western Australians&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/49172e36-4272-4049-9fd7-596fa5283260" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.

This AdLab explores the Welcome Walls which can be found outside the Western Australian Maritime Museum and on their website.



&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.052917" lon="115.73825">
  <ele>1.0</ele>
  <time>2025-05-26T08:00:00Z</time>
  <name>LBi3hv-03</name>
  <desc>WAQuokkaAdLa03c</desc>
  <url>https://labs.geocaching.com/goto/53c83958-e60d-4d16-ae9f-11404bf951c6</url>
  <urlname>WAQuokka AdLab Art #036 : S3 Welcome Walls Stage 3 by WA K Team</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1574" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #036 : S3 Welcome Walls Stage 3</groundspeak:name>
   <groundspeak:placed_by>WA K Team</groundspeak:placed_by>
   <groundspeak:owner id="">WA K Team</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #036&lt;/h3&gt;&lt;h4&gt;Welcome Walls Stage 3&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/53c83958-e60d-4d16-ae9f-11404bf951c6"&gt;https://labs.geocaching.com/goto/53c83958-e60d-4d16-ae9f-11404bf951c6&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What other Western Australian City has a set of Welcome Walls&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/f96ba757-7f7a-433c-8499-e988634012c3" /&gt;&lt;/p&gt;&lt;p&gt;The Welcome Walls began as a one-off project in 2004 as part of the commemoration of the 175th anniversary of the founding of the Swan River Colony. It was originally planned to display about 2,000 inscriptions.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/49172e36-4272-4049-9fd7-596fa5283260" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.

This AdLab explores the Welcome Walls which can be found outside the Western Australian Maritime Museum and on their website.



&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.052933" lon="115.738233">
  <ele>1.0</ele>
  <time>2025-05-26T08:00:00Z</time>
  <name>LBi3hv-04</name>
  <desc>WAQuokkaAdLa03m</desc>
  <url>https://labs.geocaching.com/goto/53c83958-e60d-4d16-ae9f-11404bf951c6</url>
  <urlname>WAQuokka AdLab Art #036 : S4 Welcome Walls Stage 4 by WA K Team</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1575" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #036 : S4 Welcome Walls Stage 4</groundspeak:name>
   <groundspeak:placed_by>WA K Team</groundspeak:placed_by>
   <groundspeak:owner id="">WA K Team</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #036&lt;/h3&gt;&lt;h4&gt;Welcome Walls Stage 4&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/53c83958-e60d-4d16-ae9f-11404bf951c6"&gt;https://labs.geocaching.com/goto/53c83958-e60d-4d16-ae9f-11404bf951c6&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What ship did William &amp; Elizabeth ADAMS arrive on in 1930&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/d16aaa61-4e38-447b-93d8-23dfba9187a8" /&gt;&lt;/p&gt;&lt;p&gt;Western Australia’s migration history is fascinating. Millions of migrants have come to Western Australia by sailing ship, steamship, naval vessel and ocean liner either in transit to other Australian ports or as immigrants intending to make Western Australia their home. Immigrants from all over the world have made Australia a very culturally diverse society.
The Port of Fremantle is integral to this history. Situated at the mouth of the Swan River, it is the maritime gateway to Western Australia. Aboriginal people call this place 'Manjaree', meaning 'gathering place', where locals and visitors engaged in trade and cultural exchange before Europeans arrived. It has continued to be a place of meetings greetings and farewells.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/49172e36-4272-4049-9fd7-596fa5283260" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.

This AdLab explores the Welcome Walls which can be found outside the Western Australian Maritime Museum and on their website.



&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.052917" lon="115.738283">
  <ele>1.0</ele>
  <time>2025-05-26T08:00:00Z</time>
  <name>LBi3hv-05</name>
  <desc>WAQuokkaAdLa03a</desc>
  <url>https://labs.geocaching.com/goto/53c83958-e60d-4d16-ae9f-11404bf951c6</url>
