  <desc>WASportsVenues1</desc>
  <url>https://labs.geocaching.com/goto/cf865ebe-2e5a-448a-bb62-82715ec2a2cc</url>
  <urlname>WA Sports Venues : S1 Perth HPC by J2V</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918495" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WA Sports Venues : S1 Perth HPC</groundspeak:name>
