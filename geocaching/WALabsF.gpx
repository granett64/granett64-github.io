  <url>https://labs.geocaching.com/goto/3dce4f37-4ff8-47a6-bbea-488c43e48fb9</url>
  <urlname>WAQuokka AdLab Art #020 : S5 Mark of the Century by Kapelula</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1796" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #020 : S5 Mark of the Century</groundspeak:name>
   <groundspeak:placed_by>Kapelula</groundspeak:placed_by>
   <groundspeak:owner id="">Kapelula</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
