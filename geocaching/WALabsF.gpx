 <wpt lat="-32.026933" lon="115.763767">
  <ele>8.0</ele>
  <time>2026-03-28T08:00:00Z</time>
  <name>LBR82P-5</name>
  <desc>HMASPerthIMemo5</desc>
  <url>https://labs.geocaching.com/goto/e715a649-b6be-4fa4-af24-49d7bbda33c1</url>
  <urlname>HMAS Perth (I) Memorial : S5 In memory by cravo10</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9722761" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>HMAS Perth (I) Memorial : S5 In memory</groundspeak:name>
   <groundspeak:placed_by>cravo10</groundspeak:placed_by>
   <groundspeak:owner id="">cravo10</groundspeak:owner>
