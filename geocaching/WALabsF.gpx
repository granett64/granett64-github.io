  <name>LBNYeb-05</name>
  <desc>TurquoiseWayPa5</desc>
  <url>https://labs.geocaching.com/goto/a686750b-5c7f-432e-8e55-2399a75d2552</url>
  <urlname>Turquoise Way Path- Jurien Bay : S5 Fauntleroy Park by neva2old</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99000346" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Turquoise Way Path- Jurien Bay : S5 Fauntleroy Park</groundspeak:name>
   <groundspeak:placed_by>neva2old</groundspeak:placed_by>
   <groundspeak:owner id="">neva2old</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Turquoise Way Path- Jurien Bay&lt;/h3&gt;&lt;h4&gt;Fauntleroy Park&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/a686750b-5c7f-432e-8e55-2399a75d2552"&gt;https://labs.geocaching.com/goto/a686750b-5c7f-432e-8e55-2399a75d2552&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Who painted the mural? ( 3 words)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/71851c4b-f3fb-4100-8a71-645b4a845fd2" /&gt;&lt;/p&gt;&lt;p&gt;Fauntleroy Park is a hub for local activities, Sunday markets, festivals, picnics and many community events.  There is also a great piece of street art  you should check out.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c2f40ad7-e469-4443-a865-1ec5ebc4c973" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to The Turquoise Way Path which starts at the Jurien Bay Boat Harbour and extends 13.5km to the mouth of the Hill River. The path is fully sealed and suitable of  walking, running, cycling, skating, prams and scooters and will take  you along the beautiful coastline.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/0e356060-96ac-4d00-a76f-bc31f381e45c" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Well done!  Thankyou for taking the time to come and visit Jurien Bay :)&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-30.302783" lon="115.0373">
  <ele>2.0</ele>
  <time>2021-09-27T08:00:00Z</time>
  <name>LBNYeb-04</name>
  <desc>TurquoiseWayPa4</desc>
  <url>https://labs.geocaching.com/goto/a686750b-5c7f-432e-8e55-2399a75d2552</url>
  <urlname>Turquoise Way Path- Jurien Bay : S4 The Jetty by neva2old</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99000344" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Turquoise Way Path- Jurien Bay : S4 The Jetty</groundspeak:name>
   <groundspeak:placed_by>neva2old</groundspeak:placed_by>
   <groundspeak:owner id="">neva2old</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Turquoise Way Path- Jurien Bay&lt;/h3&gt;&lt;h4&gt;The Jetty&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/a686750b-5c7f-432e-8e55-2399a75d2552"&gt;https://labs.geocaching.com/goto/a686750b-5c7f-432e-8e55-2399a75d2552&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What country ?   ( its near the top of the sign)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/8f91b701-62f0-496f-955f-35aa4da3af81" /&gt;&lt;/p&gt;&lt;p&gt;The Jurien Bay community foreshore and jetty project is an iconic and large scale outdoor visitor and community facility. The foreshore and jetty project has redeveloped the foreshore and jetty area to create an experiential community and visitor experience. In terms of recreation, it has enhanced a whole range of activities in this area, incuding squid and shoreline fishing,&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c2f40ad7-e469-4443-a865-1ec5ebc4c973" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to The Turquoise Way Path which starts at the Jurien Bay Boat Harbour and extends 13.5km to the mouth of the Hill River. The path is fully sealed and suitable of  walking, running, cycling, skating, prams and scooters and will take  you along the beautiful coastline.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/55c71840-a9a1-4cfe-8daf-e015929d3db7" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Thats another one down, good job!!
Go on take a walk along the jetty, you may even want to swim out to the Pontoon&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-30.3023" lon="115.037633">
  <ele>1.0</ele>
  <time>2021-09-27T08:00:00Z</time>
  <name>LBNYeb-03</name>
  <desc>TurquoiseWayPa3</desc>
  <url>https://labs.geocaching.com/goto/a686750b-5c7f-432e-8e55-2399a75d2552</url>
  <urlname>Turquoise Way Path- Jurien Bay : S3 Jurien Bay Marine Park by neva2old</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99000342" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Turquoise Way Path- Jurien Bay : S3 Jurien Bay Marine Park</groundspeak:name>
   <groundspeak:placed_by>neva2old</groundspeak:placed_by>
   <groundspeak:owner id="">neva2old</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Turquoise Way Path- Jurien Bay&lt;/h3&gt;&lt;h4&gt;Jurien Bay Marine Park&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/a686750b-5c7f-432e-8e55-2399a75d2552"&gt;https://labs.geocaching.com/goto/a686750b-5c7f-432e-8e55-2399a75d2552&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many island in and near Jurien Bay Marine Park are key Sealion breeding sites?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/2a568ed0-4669-4f64-a869-615f46b776dd" /&gt;&lt;/p&gt;&lt;p&gt;The Jurien Bay Marine Park is a protected marine park that is located 200 to 300 kilometres north of Perth, off the coastal tip of the Wheatbelt region of Western Australia. The 82,375-hectare marine park was formally declared on 31 August 2003 and is situated along the Indian Ocean Drive that extends south from Green Head to the southern boundary of Nambung National Park.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c2f40ad7-e469-4443-a865-1ec5ebc4c973" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to The Turquoise Way Path which starts at the Jurien Bay Boat Harbour and extends 13.5km to the mouth of the Hill River. The path is fully sealed and suitable of  walking, running, cycling, skating, prams and scooters and will take  you along the beautiful coastline.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/f0f3b2fd-1408-4c64-8688-5206ff6bbcb0" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Excellent work!  I hope your enjoying the scenery and the nearby playground and coffee van&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-30.30115" lon="115.038183">
  <ele>1.0</ele>
  <time>2021-09-27T08:00:00Z</time>
  <name>LBNYeb-02</name>
  <desc>TurquoiseWayPa2</desc>
  <url>https://labs.geocaching.com/goto/a686750b-5c7f-432e-8e55-2399a75d2552</url>
  <urlname>Turquoise Way Path- Jurien Bay : S2 Underwater Interaptive Trail by neva2old</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99000340" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Turquoise Way Path- Jurien Bay : S2 Underwater Interaptive Trail</groundspeak:name>
   <groundspeak:placed_by>neva2old</groundspeak:placed_by>
   <groundspeak:owner id="">neva2old</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Turquoise Way Path- Jurien Bay&lt;/h3&gt;&lt;h4&gt;Underwater Interaptive Trail&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/a686750b-5c7f-432e-8e55-2399a75d2552"&gt;https://labs.geocaching.com/goto/a686750b-5c7f-432e-8e55-2399a75d2552&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How long is the trail circuit? (in Metres)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/fc744570-6d11-42b1-80e0-5b1c6a936a14" /&gt;&lt;/p&gt;&lt;p&gt;The Jurien Bay Underwater Interpretive Trail is an artificial underwater habitat that was a first of its kind in Western Australia. It starts approximately 25 metres out from the Jurien Bay beach at the end of the old jetty piles, and varies from 2.5 to 6 metres in depth.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c2f40ad7-e469-4443-a865-1ec5ebc4c973" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to The Turquoise Way Path which starts at the Jurien Bay Boat Harbour and extends 13.5km to the mouth of the Hill River. The path is fully sealed and suitable of  walking, running, cycling, skating, prams and scooters and will take  you along the beautiful coastline.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/96000ce3-97de-43e2-b9f9-656809d71c2b" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Good Job!  I hope you remembered to SLIP SLOP SLAP!&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-30.296617" lon="115.040583">
