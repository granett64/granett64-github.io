  <urlname>WAQuokka AdLab Art #099 : S5 BIG EMU - Nannup WA by Snoopy1976</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918932" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #099 : S5 BIG EMU - Nannup WA</groundspeak:name>
