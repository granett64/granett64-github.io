   <groundspeak:name>[L] The Perth-fect Race : S5 Heirisson Island</groundspeak:name>
   <groundspeak:placed_by>Cirrus_WA</groundspeak:placed_by>
   <groundspeak:owner id="">Cirrus_WA</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
