   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Fremantle Line (Transperth)&lt;/h3&gt;&lt;h4&gt;Fremantle Station &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/2dd70f6e-870c-43ef-acc6-582fe8369255"&gt;https://labs.geocaching.com/goto/2dd70f6e-870c-43ef-acc6-582fe8369255&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many platforms are at Fremantle?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/34415d52-909d-4769-86b4-e12608713f24" /&gt;&lt;/p&gt;&lt;p&gt;Fremantle Station is the terminus of the Fremantle Line. It is located in zone 2 on the Transperth Network, It is served by some very important bus routes such as 999, 998, 915 and 910. All of which are High Frequency routes. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/9167c011-5506-4743-8851-7bc3196b5250" /&gt;&lt;/p&gt;&lt;p&gt;The Fremantle Line is one of Perth's suburban rail lines running from Perth Station to Fremantle Station. The Line originally opened on the 1st March 1881 and since then it has undergone major changes like the electrification of the line which took place in the early 1990's. It is now one of Perth's busiest rail lines carrying around 5 million passengers per year. &lt;/p&gt;</groundspeak:long_description>
