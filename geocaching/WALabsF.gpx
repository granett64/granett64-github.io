   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Visit Collie&lt;/h3&gt;&lt;h4&gt;Trails&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/7daca72b-534f-405b-9d53-da4e5e1b0d19"&gt;https://labs.geocaching.com/goto/7daca72b-534f-405b-9d53-da4e5e1b0d19&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;There is a bike rack at this location, what trail is mentioned on the end of the bike rack? Single word answer. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/0708a6c2-5242-45a1-bdf6-7e59935d7c95" /&gt;&lt;/p&gt;&lt;p&gt;A number of trails either pass through Collie, or are around town. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/800f5ebc-30b3-461c-b444-c75ba469f54b" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the Collie Visitors Centre. This adventure lab will take you around the visitors centre precinct. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/6dabb7cc-3641-4efb-98ab-06447b94eae5" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Congratulations&lt;/p&gt;</groundspeak:long_description>
