 <wpt lat="-31.89135" lon="116.768233">
  <ele>185.0</ele>
  <time>2023-09-30T08:00:00Z</time>
  <name>LBPa36-01</name>
  <desc>HistoricalBuil1</desc>
  <url>https://labs.geocaching.com/goto/210b90f7-9f08-4918-bace-bbcd0fe8fbcb</url>
  <urlname>Historical Buildings of York : S1 York Town Hall by Diadem</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-171" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Historical Buildings of York : S1 York Town Hall</groundspeak:name>
   <groundspeak:placed_by>Diadem</groundspeak:placed_by>
   <groundspeak:owner id="">Diadem</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Historical Buildings of York&lt;/h3&gt;&lt;h4&gt;York Town Hall&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/210b90f7-9f08-4918-bace-bbcd0fe8fbcb"&gt;https://labs.geocaching.com/goto/210b90f7-9f08-4918-bace-bbcd0fe8fbcb&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What are the initials and surname of the Mayoress  (no punctuation but spaces needed)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/edb2a5c0-875f-4e9b-a738-09e05fc1e4e6" /&gt;&lt;/p&gt;&lt;p&gt;York is the oldest inland town in Western Australia, situated on the Avon River, 97 kilometres east of Perth in the Wheatbelt, on Ballardong Nyoongar land, and is the seat of the Shire of York.  

Avon Terrace it is the main street of the town of York, Western Australia, and is lined with heritage buildings.

York's historic Town Hall was built in 1911.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/94280119-1063-4deb-b9db-c357eafa6346" /&gt;&lt;/p&gt;&lt;p&gt;York is the oldest inland town in Western Australia, situated on the Avon River, 97 kilometres east of Perth in the Wheatbelt, on Ballardong Nyoongar land, and is the seat of the Shire of York.  

Avon Terrace it is the main street of the town of York, Western Australia, and is lined with heritage buildings.&lt;/p&gt;</groundspeak:long_description>
