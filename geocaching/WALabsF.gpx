  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476910035" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Rockingham Ramble : S2 Floating Rock Sphere</groundspeak:name>
