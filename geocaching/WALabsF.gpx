  <desc>BeautyOfFitzg34</desc>
  <url>https://labs.geocaching.com/goto/cf729cac-9d38-42eb-b7a3-224538fd48e2</url>
  <urlname>The Beauty of Fitzgerald National Park : S3 4 Mile Beach by Chrisval7</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9666128" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>The Beauty of Fitzgerald National Park : S3 4 Mile Beach</groundspeak:name>
   <groundspeak:placed_by>Chrisval7</groundspeak:placed_by>
   <groundspeak:owner id="">Chrisval7</groundspeak:owner>
