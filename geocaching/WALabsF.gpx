  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918889" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #094 : S3 Surf’s Up - Preverly</groundspeak:name>
   <groundspeak:placed_by>geogypsys</groundspeak:placed_by>
   <groundspeak:owner id="">geogypsys</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
