   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Eric Singleton Bird Sanctuary &lt;/h3&gt;&lt;h4&gt;Entrance&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/679f672b-34aa-4634-a8ed-46b9c46fd043"&gt;https://labs.geocaching.com/goto/679f672b-34aa-4634-a8ed-46b9c46fd043&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many hectares is the sanctuary? (word)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/0d6fce99-c6e1-4d8c-ad31-424644b7cc80" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the Bird Sanctuary!&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/014274ec-d393-4067-a19c-7be4d90b1419" /&gt;&lt;/p&gt;&lt;p&gt;Eric Singleton Bird Sanctuary is an important feeding, resting and breeding area for birds and other fauna. It also provides a unique natural space in our urban catchment for walking, bird watching, and a place for quiet contemplation.

Eric Singleton and his family were avid birdwatchers and observed over 70 species in this area. The wetland was declared a nature reserve in 1977.

Please note, this is a dog free zone.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
