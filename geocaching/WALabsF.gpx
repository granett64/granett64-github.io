   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #063&lt;/h3&gt;&lt;h4&gt;Beaches&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/88b248a6-b78b-4089-b480-73b188d92210"&gt;https://labs.geocaching.com/goto/88b248a6-b78b-4089-b480-73b188d92210&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the longest beach in WA?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/30717867-8d70-4e5d-999b-fefe3c4d7310" /&gt;&lt;/p&gt;&lt;p&gt;Western Australian beaches are regularly voted among the best in the world, and with good reason. Along its 12,500kms (7,767mi) of coastline, you’ll find everything from the most stunning World Heritage scenery, wide sweeping bays, once-in-a-lifetime wildlife encounters and picture-perfect hidden coves.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/79f52816-70e6-4713-9929-b5327d247bd3" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.

To join this project, please contact the project Admins on WAQuokkaAdLab@gmail.com
&lt;/p&gt;</groundspeak:long_description>
