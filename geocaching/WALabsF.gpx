   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #052&lt;/h3&gt;&lt;h4&gt;Kings Park&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/9415d44b-02bd-47cb-bc72-5d3510666b87"&gt;https://labs.geocaching.com/goto/9415d44b-02bd-47cb-bc72-5d3510666b87&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many hectares is Kings Park?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c1acc9d7-3645-4eb6-9c85-a74ecf54c57e" /&gt;&lt;/p&gt;&lt;p&gt;Kings Park spans about 400 hectares and ranks as one of the world's largest urban parks. A mixture of manicured lawns, botanical gardens, and protected bushland, the park is bigger by 148 acres than New York City's Central Park.
Kings Park overlooks the Swan River and Perth's central business district, providing visitors with panoramic views. It is also an ideal spot for scenic hikes, picnics, relaxation, and nature exploration, with over 3,000 species of fauna and 30 bird varieties. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/23d691a8-a479-4c3d-8128-a93d3a462fe7" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.

To join this project, please contact the project Admins on WAQuokkaAdLab@gmail.com
&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.052783" lon="115.739317">
