  <urlname>WAQuokka AdLab Art #061 : S1 WA's floral emblem by ullyssia</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1483" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
