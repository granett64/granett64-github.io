   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Eagle Bay to Dunsborough coastal trail&lt;/h3&gt;&lt;h4&gt;Meelup&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/a54c0df8-64b7-4bfb-a777-7e4c38979501"&gt;https://labs.geocaching.com/goto/a54c0df8-64b7-4bfb-a777-7e4c38979501&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What centre prepared the information on the plaque (one word)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c8999979-988d-4027-932a-247d5f7de821" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the land of the Wardandi people. Find the commemorative plaque to learn the meaning of the words meelup, meeka and wattern.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/bd32bbf8-f562-41c9-8be7-396cd98bec60" /&gt;&lt;/p&gt;&lt;p&gt;Start at Eagle Bay and walk or run 8-9 kms on marked trails to Dunsborough boat ramp. Learn some local history, spot a whale (at the right time of year) and enjoy stunning coastal scenery. The trail is mainly flat, with some rocky and narrow sections. Wear sturdy shoes. The AdLab can be completed by car.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-33.580717" lon="115.094667">
  <ele>12.0</ele>
  <time>2022-11-05T08:00:00Z</time>
  <name>LB7o32-04</name>
  <desc>EagleBayToDuns4</desc>
  <url>https://labs.geocaching.com/goto/a54c0df8-64b7-4bfb-a777-7e4c38979501</url>
  <urlname>Eagle Bay to Dunsborough coastal trail : S4 Castle Bay whaling station by J2V</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476910097" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Eagle Bay to Dunsborough coastal trail : S4 Castle Bay whaling station</groundspeak:name>
   <groundspeak:placed_by>J2V</groundspeak:placed_by>
   <groundspeak:owner id="">J2V</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Eagle Bay to Dunsborough coastal trail&lt;/h3&gt;&lt;h4&gt;Castle Bay whaling station&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/a54c0df8-64b7-4bfb-a777-7e4c38979501"&gt;https://labs.geocaching.com/goto/a54c0df8-64b7-4bfb-a777-7e4c38979501&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the date at the base of the cairn?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/93cab5b2-05e2-46ac-8506-3efbb1976e43" /&gt;&lt;/p&gt;&lt;p&gt;The Castle Bay Whaling Company operated on this site from 1845 to 1872. Harpooned whales were brought ashore and whale oil was obtained by boiling their blubber in huge cauldrons stirred with long handled spoons. The oil was then poured into casks for shipping. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/bd32bbf8-f562-41c9-8be7-396cd98bec60" /&gt;&lt;/p&gt;&lt;p&gt;Start at Eagle Bay and walk or run 8-9 kms on marked trails to Dunsborough boat ramp. Learn some local history, spot a whale (at the right time of year) and enjoy stunning coastal scenery. The trail is mainly flat, with some rocky and narrow sections. Wear sturdy shoes. The AdLab can be completed by car.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-33.602483" lon="115.105117">
  <ele>5.0</ele>
  <time>2022-11-05T08:00:00Z</time>
  <name>LB7o32-05</name>
  <desc>EagleBayToDuns5</desc>
  <url>https://labs.geocaching.com/goto/a54c0df8-64b7-4bfb-a777-7e4c38979501</url>
  <urlname>Eagle Bay to Dunsborough coastal trail : S5 Old Dunsborough by J2V</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476910099" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Eagle Bay to Dunsborough coastal trail : S5 Old Dunsborough</groundspeak:name>
   <groundspeak:placed_by>J2V</groundspeak:placed_by>
   <groundspeak:owner id="">J2V</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Eagle Bay to Dunsborough coastal trail&lt;/h3&gt;&lt;h4&gt;Old Dunsborough&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/a54c0df8-64b7-4bfb-a777-7e4c38979501"&gt;https://labs.geocaching.com/goto/a54c0df8-64b7-4bfb-a777-7e4c38979501&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What year was the Dunsborough water supply opened?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/59b3cc11-2499-4814-8325-737b503b3fcb" /&gt;&lt;/p&gt;&lt;p&gt;The area around Dunsborough boat ramp is called Old Dunsborough as it was the first area developed between the 1930s and 1950s. In summer each year a shark proof fence is installed to allow people to swim safely.
&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/bd32bbf8-f562-41c9-8be7-396cd98bec60" /&gt;&lt;/p&gt;&lt;p&gt;Start at Eagle Bay and walk or run 8-9 kms on marked trails to Dunsborough boat ramp. Learn some local history, spot a whale (at the right time of year) and enjoy stunning coastal scenery. The trail is mainly flat, with some rocky and narrow sections. Wear sturdy shoes. The AdLab can be completed by car.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-34.3977" lon="119.379567">
  <ele>30.0</ele>
  <time>2022-11-05T08:00:00Z</time>
  <name>LBfi1G-01</name>
  <desc>HistoricalBrem1</desc>
  <url>https://labs.geocaching.com/goto/87822f78-0883-409c-a2b7-befbdce41fcb</url>
  <urlname>Historical Bremer Bay : S1 Bremer Bay Telegraph Station by familysteiner</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-101" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Historical Bremer Bay : S1 Bremer Bay Telegraph Station</groundspeak:name>
   <groundspeak:placed_by>familysteiner</groundspeak:placed_by>
   <groundspeak:owner id="">familysteiner</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Historical Bremer Bay&lt;/h3&gt;&lt;h4&gt;Bremer Bay Telegraph Station&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/87822f78-0883-409c-a2b7-befbdce41fcb"&gt;https://labs.geocaching.com/goto/87822f78-0883-409c-a2b7-befbdce41fcb&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What two words can you see vertically on the right hand side gate post as you enter the property? (2, 4)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a64bcb47-cb94-4fd1-bbaf-0de5eccb6725" /&gt;&lt;/p&gt;&lt;p&gt;On the 1st of January 1875 Frederick Weld, the Governor of Albany at the time, erected the first telegraph pole which would carry the telegraph to Eucla, thus “connecting” Western Australia with the rest of the continent and, via Darwin, the rest of the world. The line to Bremer Bay was completed by October 1875, but did not formally open for traffic until the 8th March 1876 due to a lack of personnel to operate the station. Mary Wellstead, daughter of John Snr, was the first operator in Bremer Bay and quite possibly the first telegraphist in Australia, until the new appointments at the end of 1877. 

The first Bremer Bay Telegraph Station was built in 1875 from timber and had a shingle roof. However the original telegraph station was burnt down and the new telegraph station, which you see now, was erected in 1896. This time, local stone was used and the building became a well known landmark.

The telegraph station has been a private dwelling since the 1930s. It is currently operating as a cafe/restaurant&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/36c81093-73eb-4c20-b79e-149b14ad7cb5" /&gt;&lt;/p&gt;&lt;p&gt;Bremer Bay is situated 180km by road south-east of Albany within the Shire of Jerramungup. The bay, after which the town derives its name, is believed to have been named by the Surveyor General John Septimus Roe, who visited the area in 1848. It is assumed that Roe named the bay after James John Gordon Bremer, captain of the “TAMAR”, under whom he served between 1824 and 1827. 

Bremer Bay was originally named Wellstead in 1951 but locals petitioned to have the town renamed in 1962. The Wellstead family settled in the area in 1860 and held grazing land between Cape Riche and Bremer Bay.

This Adventure Lab will take you to some of Bremer Bay's historical sites. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-34.411783" lon="119.379583">
  <ele>17.0</ele>
  <time>2022-11-05T08:00:00Z</time>
  <name>LBfi1G-03</name>
  <desc>HistoricalBrem3</desc>
  <url>https://labs.geocaching.com/goto/87822f78-0883-409c-a2b7-befbdce41fcb</url>
  <urlname>Historical Bremer Bay : S3 Bremer Bay Cemetery by familysteiner</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-103" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Historical Bremer Bay : S3 Bremer Bay Cemetery</groundspeak:name>
   <groundspeak:placed_by>familysteiner</groundspeak:placed_by>
   <groundspeak:owner id="">familysteiner</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Historical Bremer Bay&lt;/h3&gt;&lt;h4&gt;Bremer Bay Cemetery&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/87822f78-0883-409c-a2b7-befbdce41fcb"&gt;https://labs.geocaching.com/goto/87822f78-0883-409c-a2b7-befbdce41fcb&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many of John Walton Wellstead's grandchildren are named on the gravestone? (word)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/18819277-6bc4-4645-99f8-8c4ec953ec31" /&gt;&lt;/p&gt;&lt;p&gt;John Wellstead (Senior) was one of the pioneering settlers of the Bremer region. He and his wife Ann settled in the area in 1860 and together had twelve children.  John Snr. died in Albany in 1896, however his son John Jnr. continued the family pastoral interests in the area.

There is a Pioneer Gravesite elsewhere in the area (resting place of John Snr's daughter Barbara, and grandson George), however these coordinates will take you to the burial site of a more contemporary descendant of the Wellstead clan. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/36c81093-73eb-4c20-b79e-149b14ad7cb5" /&gt;&lt;/p&gt;&lt;p&gt;Bremer Bay is situated 180km by road south-east of Albany within the Shire of Jerramungup. The bay, after which the town derives its name, is believed to have been named by the Surveyor General John Septimus Roe, who visited the area in 1848. It is assumed that Roe named the bay after James John Gordon Bremer, captain of the “TAMAR”, under whom he served between 1824 and 1827. 

Bremer Bay was originally named Wellstead in 1951 but locals petitioned to have the town renamed in 1962. The Wellstead family settled in the area in 1860 and held grazing land between Cape Riche and Bremer Bay.

This Adventure Lab will take you to some of Bremer Bay's historical sites. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-34.435083" lon="119.36195">
  <ele>62.0</ele>
  <time>2022-11-05T08:00:00Z</time>
  <name>LBfi1G-05</name>
  <desc>HistoricalBrem5</desc>
  <url>https://labs.geocaching.com/goto/87822f78-0883-409c-a2b7-befbdce41fcb</url>
  <urlname>Historical Bremer Bay : S5 Wellstead Heritage Museum by familysteiner</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-105" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Historical Bremer Bay : S5 Wellstead Heritage Museum</groundspeak:name>
   <groundspeak:placed_by>familysteiner</groundspeak:placed_by>
   <groundspeak:owner id="">familysteiner</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Historical Bremer Bay&lt;/h3&gt;&lt;h4&gt;Wellstead Heritage Museum&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/87822f78-0883-409c-a2b7-befbdce41fcb"&gt;https://labs.geocaching.com/goto/87822f78-0883-409c-a2b7-befbdce41fcb&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the make of the large red scales you see in the garden next to the Museum? (one word, five letters)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/f17f5529-127f-49da-ab64-573aebe5ca68" /&gt;&lt;/p&gt;&lt;p&gt;The Wellstead Heritage Museum was opened at the old family farm in 2003 by family descendant Max Wellstead. It is home to thousands of pieces of Australian history.

The history of the Wellstead family as farmers on the South Coast stretches back over 180 years. Historic farming tools and machinery tell of a time when physical strength and perseverance were essential ingredients in farming and self-sufficiency.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/36c81093-73eb-4c20-b79e-149b14ad7cb5" /&gt;&lt;/p&gt;&lt;p&gt;Bremer Bay is situated 180km by road south-east of Albany within the Shire of Jerramungup. The bay, after which the town derives its name, is believed to have been named by the Surveyor General John Septimus Roe, who visited the area in 1848. It is assumed that Roe named the bay after James John Gordon Bremer, captain of the “TAMAR”, under whom he served between 1824 and 1827. 

Bremer Bay was originally named Wellstead in 1951 but locals petitioned to have the town renamed in 1962. The Wellstead family settled in the area in 1860 and held grazing land between Cape Riche and Bremer Bay.

This Adventure Lab will take you to some of Bremer Bay's historical sites. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-34.434383" lon="119.363967">
  <ele>63.0</ele>
  <time>2022-11-05T08:00:00Z</time>
  <name>LBfi1G-04</name>
  <desc>HistoricalBrem4</desc>
  <url>https://labs.geocaching.com/goto/87822f78-0883-409c-a2b7-befbdce41fcb</url>
  <urlname>Historical Bremer Bay : S4 Peppermint Grove Farm by familysteiner</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-104" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Historical Bremer Bay : S4 Peppermint Grove Farm</groundspeak:name>
   <groundspeak:placed_by>familysteiner</groundspeak:placed_by>
   <groundspeak:owner id="">familysteiner</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Historical Bremer Bay&lt;/h3&gt;&lt;h4&gt;Peppermint Grove Farm &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/87822f78-0883-409c-a2b7-befbdce41fcb"&gt;https://labs.geocaching.com/goto/87822f78-0883-409c-a2b7-befbdce41fcb&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What type of calves did John Wellstead (Snr) release into the area in the 1840s to see if they would survive?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/46c6be09-e341-4c2e-8c4d-749d503a4f9f" /&gt;&lt;/p&gt;&lt;p&gt;At Peppermint Grove, John Wellstead (Snr), his wife Anne and their subsequent twelve children grew vegetables, fruit, grazed sheep and cattle and established a dairy, milking 70 head of cows by hand twice a day. The cottages were originally built from local stone, lime mortar sourced and burnt on the property and pit sawn timber also sourced and produced on the property. 

Boobook Cottage was built in 1854 and was originally used as sheep pens. When the second generation of Wellstead daughters matured, the largest of the pens was built up to provide a separate sleeping accommodation unit due to overcrowding in the house, and was then called The Girls Room.

The Currawong was built in 1864 as separate sleeping quarters for the second generation of Wellstead boys and was known as The Boys Room. After falling into disrepair and almost a total loss it was rescued and restored by 4th generation Wellstead and current owner Mr Max Wellstead.

At the coordinates you will find an information sign.

&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/36c81093-73eb-4c20-b79e-149b14ad7cb5" /&gt;&lt;/p&gt;&lt;p&gt;Bremer Bay is situated 180km by road south-east of Albany within the Shire of Jerramungup. The bay, after which the town derives its name, is believed to have been named by the Surveyor General John Septimus Roe, who visited the area in 1848. It is assumed that Roe named the bay after James John Gordon Bremer, captain of the “TAMAR”, under whom he served between 1824 and 1827. 

Bremer Bay was originally named Wellstead in 1951 but locals petitioned to have the town renamed in 1962. The Wellstead family settled in the area in 1860 and held grazing land between Cape Riche and Bremer Bay.

This Adventure Lab will take you to some of Bremer Bay's historical sites. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-34.395817" lon="119.40675">
  <ele>19.0</ele>
  <time>2022-11-05T08:00:00Z</time>
  <name>LBfi1G-02</name>
  <desc>HistoricalBrem2</desc>
  <url>https://labs.geocaching.com/goto/87822f78-0883-409c-a2b7-befbdce41fcb</url>
  <urlname>Historical Bremer Bay : S2 Cuneo Drive Rock Cairn by familysteiner</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-102" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Historical Bremer Bay : S2 Cuneo Drive Rock Cairn</groundspeak:name>
   <groundspeak:placed_by>familysteiner</groundspeak:placed_by>
   <groundspeak:owner id="">familysteiner</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Historical Bremer Bay&lt;/h3&gt;&lt;h4&gt;Cuneo Drive Rock Cairn&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/87822f78-0883-409c-a2b7-befbdce41fcb"&gt;https://labs.geocaching.com/goto/87822f78-0883-409c-a2b7-befbdce41fcb&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What are the FIRST names of the four men involved in the cairn's rebuilding (in order as listed on the plaque)?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/dc4779f5-4704-4cb4-b561-b61b7874bad0" /&gt;&lt;/p&gt;&lt;p&gt;The original rock cairn on this site was built by the Wellstead family under Government maritime supervision as a means of alerting visiting coastal ships when there were travellers or cargo to go aboard. By means of a white day flag  or a lantern at the head of the central pole the crew would know that there could be, for example, wool, tree bark or produce to be picked up for one or other of the ports around the south coast which they visited regularly. 

This service was phased out in the early 1930’s when shipping ceased and road transport took over. In the 1980’s the local Progress Association, together with the then active Tourism Committee, decided to reconstruct the cairn as something of historical interest. Building of the cairn was completed in the late 1980s albeit in a slightly different form from the original.

Locate and read the brass plaque on the side on the cairn to answer the question.

 &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/36c81093-73eb-4c20-b79e-149b14ad7cb5" /&gt;&lt;/p&gt;&lt;p&gt;Bremer Bay is situated 180km by road south-east of Albany within the Shire of Jerramungup. The bay, after which the town derives its name, is believed to have been named by the Surveyor General John Septimus Roe, who visited the area in 1848. It is assumed that Roe named the bay after James John Gordon Bremer, captain of the “TAMAR”, under whom he served between 1824 and 1827. 

Bremer Bay was originally named Wellstead in 1951 but locals petitioned to have the town renamed in 1962. The Wellstead family settled in the area in 1860 and held grazing land between Cape Riche and Bremer Bay.

This Adventure Lab will take you to some of Bremer Bay's historical sites. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.5319" lon="115.7146">
  <time>2022-11-24T08:00:00Z</time>
  <name>LBG16L-01</name>
  <desc>MandurahsWeste1</desc>
  <url>https://labs.geocaching.com/goto/a5faf733-574a-4f1c-953b-b4d30e2a09f1</url>
  <urlname>Mandurah’s Western Foreshore : S1 War Memorial by hunterzed</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-895" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Mandurah’s Western Foreshore : S1 War Memorial</groundspeak:name>
   <groundspeak:placed_by>hunterzed</groundspeak:placed_by>
   <groundspeak:owner id="">hunterzed</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Mandurah’s Western Foreshore&lt;/h3&gt;&lt;h4&gt;War Memorial&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/a5faf733-574a-4f1c-953b-b4d30e2a09f1"&gt;https://labs.geocaching.com/goto/a5faf733-574a-4f1c-953b-b4d30e2a09f1&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Found engraved on one of the 4 tallest pillars, complete this sentence. ‘the med student at __________’ &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/3c2edac7-286f-4d03-b723-43c15d2dd62c" /&gt;&lt;/p&gt;&lt;p&gt;The War Memorial is an iconic symbol honouring the enormous contribution of Australian servicemen and women and others who served, suffered or died in conflicts of war. It is a place of reflection and rest where people of all nationalities and beliefs can mourn the loss of loved ones during conflict or war.
Water flowing through the monument and into the estuary echoes the lapping of the tide at Anzac Cove. The pillars rising from the water recreates the physical journey and emotional tension of the soldiers who courageously stormed the beaches, and rose from the trenches to face the conflict that confronted them.

***You’ll find the answer to the next question engraved on one of the four tallest pillars***
&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/03e30169-31d8-442d-bc07-e652a663c4cf" /&gt;&lt;/p&gt;&lt;p&gt;Mandurah’s Western Foreshore has recently undergone a transformation with the inclusion of a play space that is a hub for families and friends to meet, play and rest. 

Designed for people of all ages and abilities, the new play space will be full of fun and activity year-round. It is a place for people to gather, celebrate and explore in the beauty of Mandurah’s Western Foreshore.

The play space design is inspired by Mandurah’s heritage, character and world-renowned natural environment. It connects the land and water by featuring elements from Mandurah’s iconic waterways including boating and estuary themed sculptural play.

This recreation precinct also includes a skate and activity space, 
large picnic tables, drinking fountains, a seating deck and new toilet facilities. 

With so much on offer here, I invite you to spend a little while exploring the area. Enjoy! 

**There is a bonus cache to find once the adventure is complete so remember to note down the clues after each completed location. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.53445" lon="115.716217">
  <ele>5.0</ele>
  <time>2022-11-24T08:00:00Z</time>
  <name>LBG16L-03</name>
  <desc>MandurahsWeste3</desc>
  <url>https://labs.geocaching.com/goto/a5faf733-574a-4f1c-953b-b4d30e2a09f1</url>
  <urlname>Mandurah’s Western Foreshore : S3 Time to Climb by hunterzed</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-897" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Mandurah’s Western Foreshore : S3 Time to Climb</groundspeak:name>
   <groundspeak:placed_by>hunterzed</groundspeak:placed_by>
   <groundspeak:owner id="">hunterzed</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Mandurah’s Western Foreshore&lt;/h3&gt;&lt;h4&gt;Time to Climb &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/a5faf733-574a-4f1c-953b-b4d30e2a09f1"&gt;https://labs.geocaching.com/goto/a5faf733-574a-4f1c-953b-b4d30e2a09f1&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Hop in the top pod and look up. You will see a plate with rings of holes. How many holes make up the outer-most ring? &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/fb50b414-3ed2-4fb5-a2c7-9df29a897a6b" /&gt;&lt;/p&gt;&lt;p&gt;This 12-metre high play tower, with ramp access to 3 metres, is inspired by the local Sheoak tree and  takes centre stage of the world-class play area, which also comprises a swing zone, climbing zone, sand and music play zones, balancing logs, spinning carousel and human hamster wheel. 

Be sure to spy what’s happening on the Eastern shorefront with the fixed tower viewers located in the pods on the way up. 

You’ll need to reach the top to answer the next question. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/03e30169-31d8-442d-bc07-e652a663c4cf" /&gt;&lt;/p&gt;&lt;p&gt;Mandurah’s Western Foreshore has recently undergone a transformation with the inclusion of a play space that is a hub for families and friends to meet, play and rest. 

Designed for people of all ages and abilities, the new play space will be full of fun and activity year-round. It is a place for people to gather, celebrate and explore in the beauty of Mandurah’s Western Foreshore.

The play space design is inspired by Mandurah’s heritage, character and world-renowned natural environment. It connects the land and water by featuring elements from Mandurah’s iconic waterways including boating and estuary themed sculptural play.

This recreation precinct also includes a skate and activity space, 
large picnic tables, drinking fountains, a seating deck and new toilet facilities. 

With so much on offer here, I invite you to spend a little while exploring the area. Enjoy! 

**There is a bonus cache to find once the adventure is complete so remember to note down the clues after each completed location. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
