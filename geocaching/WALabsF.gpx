  <desc>BridgetownHeri3</desc>
  <url>https://labs.geocaching.com/goto/91d23bcf-074c-446a-9f3c-7db52232c85a</url>
  <urlname>Bridgetown Heritage Walk : S3 Bridgetown Train Station by I C Nothing</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99001497" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Bridgetown Heritage Walk : S3 Bridgetown Train Station</groundspeak:name>
   <groundspeak:placed_by>I C Nothing</groundspeak:placed_by>
   <groundspeak:owner id="">I C Nothing</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
