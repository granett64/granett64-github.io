  <groundspeak:cache id="-539" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Where in the WAFL 2? : S4 Peel Thunder Football Club</groundspeak:name>
