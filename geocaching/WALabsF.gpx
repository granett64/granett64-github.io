  <name>LBDNZJ-05</name>
  <desc>StarSwampHeri56</desc>
  <url>https://labs.geocaching.com/goto/897fd310-db34-4a5d-b2d3-c9bc18418f78</url>
  <urlname>Star Swamp Heritage Trail : S5 Site 6: Marl Quarry by iluvtrekking</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1000" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Star Swamp Heritage Trail : S5 Site 6: Marl Quarry</groundspeak:name>
   <groundspeak:placed_by>iluvtrekking</groundspeak:placed_by>
   <groundspeak:owner id="">iluvtrekking</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Star Swamp Heritage Trail&lt;/h3&gt;&lt;h4&gt;Site 6: Marl Quarry &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/897fd310-db34-4a5d-b2d3-c9bc18418f78"&gt;https://labs.geocaching.com/goto/897fd310-db34-4a5d-b2d3-c9bc18418f78&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is Marl? &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/45b0bbec-2a3f-4de1-91f7-2c8e96afa86d" /&gt;&lt;/p&gt;&lt;p&gt;Marl was quarried from this part of Star Swamp; it was used to seal newly constructed limestone tracks which formed part of the first housing subdivision in 1919.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/47bb10d8-7327-409e-83ad-192611d95825" /&gt;&lt;/p&gt;&lt;p&gt;Star Swamp Bushland Reserve provides countless opportunities for birdwatching, spotting native wildflowers and orchids, chance encounters with Quenda and Rainbow Bee Eaters, and photography, all situated in the middle of suburbia.

It has been the site of many bushfires. The most recent occurred on 21 March 2023 and burnt approximately 6.5 hectares of the 96 hectare reserve. The fire was believed to be deliberately lit.

This Adventure Lab has been prepared with children in mind, it encourages bushwalking, highlights conservation and offers an opportunity to learn some local history.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
