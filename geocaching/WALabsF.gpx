   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WA Sports Venues&lt;/h3&gt;&lt;h4&gt;WA Athletics Stadium&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/cf865ebe-2e5a-448a-bb62-82715ec2a2cc"&gt;https://labs.geocaching.com/goto/cf865ebe-2e5a-448a-bb62-82715ec2a2cc&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;On the memorial plaque, what was the last name of the Director General, Department of Sport and Recreation?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/2221b2f0-6b46-422a-b9a9-970e49961064" /&gt;&lt;/p&gt;&lt;p&gt;Opened in 2009, the athletics facility replaced Perry Lakes Stadium which had been in use since the 1962 Commonwealth Games. The track and field venue hosts international, national, state and local athletics meets including a lot of school carnivals.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/6c9238ae-200c-4c14-9bb3-3be0e4166fb6" /&gt;&lt;/p&gt;&lt;p&gt;This adventure takes you around some of the State sports venues in Mt Claremont. The five stops are at Bendat Basketball Centre, WA Athletics Stadium, Perth High Performance Centre, WA Institute of Sport and an unusual memorial in the bush. 

You can drive between the locations or take a walk. For an added challenge, find the path through the bush that links the basketball centre to the oval (and the WAIS building). After completing the adventure there is a bonus traditional geocache to fine nearby.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.964145" lon="115.891818">
  <ele>7.0</ele>
  <time>2025-02-09T08:00:00Z</time>
  <name>LBCpi5-05</name>
  <desc>CinemaS5GoodWil</desc>
  <url>https://labs.geocaching.com/goto/a0d6dde3-dddc-4a90-b3be-551ebb2a8dd6</url>
  <urlname>Cinema  : S5 Good Will Hunting by SirFancy</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918511" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Cinema  : S5 Good Will Hunting</groundspeak:name>
   <groundspeak:placed_by>SirFancy</groundspeak:placed_by>
   <groundspeak:owner id="">SirFancy</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Cinema &lt;/h3&gt;&lt;h4&gt;Good Will Hunting&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/a0d6dde3-dddc-4a90-b3be-551ebb2a8dd6"&gt;https://labs.geocaching.com/goto/a0d6dde3-dddc-4a90-b3be-551ebb2a8dd6&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Who is Will's best friend? (one word name)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c75dfa4c-9bc3-4377-b8db-e312f4602cb0" /&gt;&lt;/p&gt;&lt;p&gt;Good Will Hunting is a 1997 American drama film directed by Gus Van Sant and written by Ben Affleck and Matt Damon. It stars Robin Williams, Damon, Affleck, Stellan Skarsgård and Minnie Driver. The film tells the story of janitor Will Hunting, whose mathematical genius is discovered by a professor at MIT.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/4b16a94f-1d8f-4df0-8837-787ffd37f359" /&gt;&lt;/p&gt;&lt;p&gt;This Lab is a walk down memory lane for me, places ive seen films and some of my favourite films. there are no answers to be found at the locations, but the answers are easily found on google. 

The locations must be visted to open the Questions and all the questions are related to films.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.1253" lon="115.851983">
  <ele>26.0</ele>
  <time>2025-02-09T08:00:00Z</time>
  <name>LBYTcU-01</name>
  <desc>CockburnMemori1</desc>
  <url>https://labs.geocaching.com/goto/bc5b718a-92a7-4c2e-b83d-5f492f7ac708</url>
  <urlname>Cockburn Memorial Walk : S1 The Battle of Long Tan by I C Nothing</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918513" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Cockburn Memorial Walk : S1 The Battle of Long Tan</groundspeak:name>
   <groundspeak:placed_by>I C Nothing</groundspeak:placed_by>
   <groundspeak:owner id="">I C Nothing</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Cockburn Memorial Walk&lt;/h3&gt;&lt;h4&gt;The Battle of Long Tan&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/bc5b718a-92a7-4c2e-b83d-5f492f7ac708"&gt;https://labs.geocaching.com/goto/bc5b718a-92a7-4c2e-b83d-5f492f7ac708&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many enemy casualties were later recovered from the battlefield ? &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/d97ae44c-765e-4440-9bf2-d90ae9f2eb73" /&gt;&lt;/p&gt;&lt;p&gt;During the Vietnam War, the Australian ground forces were based near the village of Long Tan in the Phuoc Tuy Province. On 18 August 1966 Australian Forces were attached in strength by an enemy force of around 2000. The attack primarily fell upon the 100 men of "D" company of the sixth Battalion, Royal Australian Regiment who with considerable artillery support held off and defeated the attacking Viet Cong Force.
As a result, enemy forces did not again mount any major attacks against Australian Forces for the remainder of the war.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/009c0441-3e95-4e68-ad10-2f810fb4e0cc" /&gt;&lt;/p&gt;&lt;p&gt;Cockburn's Memorial Walk is set along Veterans Avenue close to Cockburn Arc Sporting Arena.
The walk consists of 36 informative plinths located on both sides of Veteran Avenue.
The plinths are dedicated to a particular conflict or theatre of war in which Australian Forces fought.

Take the time to learn a little bit of our military history as you walk along Veterans Avenue. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.125467" lon="115.852133">
  <ele>25.0</ele>
  <time>2025-02-09T08:00:00Z</time>
  <name>LBYTcU-04</name>
  <desc>CockburnMemori4</desc>
  <url>https://labs.geocaching.com/goto/bc5b718a-92a7-4c2e-b83d-5f492f7ac708</url>
  <urlname>Cockburn Memorial Walk : S4 Second Anglo Boer War by I C Nothing</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918519" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Cockburn Memorial Walk : S4 Second Anglo Boer War</groundspeak:name>
   <groundspeak:placed_by>I C Nothing</groundspeak:placed_by>
   <groundspeak:owner id="">I C Nothing</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Cockburn Memorial Walk&lt;/h3&gt;&lt;h4&gt;Second Anglo Boer War&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/bc5b718a-92a7-4c2e-b83d-5f492f7ac708"&gt;https://labs.geocaching.com/goto/bc5b718a-92a7-4c2e-b83d-5f492f7ac708&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many casualties died from disease?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/5d58aca5-b172-4e24-9ae5-5e8abcce9c56" /&gt;&lt;/p&gt;&lt;p&gt;The Boer War began on 11 October 1899 after the Southern African Republics of the Orange Free State and Transvaal declared war on the British Empire. Gold, Diamonds, land and independence were the main reasons behind the conflict with six Australian Colonial Governments sending contingents to serve with the first troops arriving in Cape Town on 26th November 1899. The conflict finished in May 1902.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/009c0441-3e95-4e68-ad10-2f810fb4e0cc" /&gt;&lt;/p&gt;&lt;p&gt;Cockburn's Memorial Walk is set along Veterans Avenue close to Cockburn Arc Sporting Arena.
The walk consists of 36 informative plinths located on both sides of Veteran Avenue.
The plinths are dedicated to a particular conflict or theatre of war in which Australian Forces fought.

Take the time to learn a little bit of our military history as you walk along Veterans Avenue. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.125817" lon="115.852133">
  <ele>25.0</ele>
  <time>2025-02-09T08:00:00Z</time>
  <name>LBYTcU-03</name>
  <desc>CockburnMemori3</desc>
  <url>https://labs.geocaching.com/goto/bc5b718a-92a7-4c2e-b83d-5f492f7ac708</url>
  <urlname>Cockburn Memorial Walk : S3 Battle of the Cocos Islands by I C Nothing</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918517" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Cockburn Memorial Walk : S3 Battle of the Cocos Islands</groundspeak:name>
   <groundspeak:placed_by>I C Nothing</groundspeak:placed_by>
   <groundspeak:owner id="">I C Nothing</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Cockburn Memorial Walk&lt;/h3&gt;&lt;h4&gt;Battle of the Cocos Islands&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/bc5b718a-92a7-4c2e-b83d-5f492f7ac708"&gt;https://labs.geocaching.com/goto/bc5b718a-92a7-4c2e-b83d-5f492f7ac708&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;At a range of how many miles did H.M.A.S Sydney engage and destroy the Emden?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/7ecb7ed7-c6f9-404a-969e-f4f0b2ec3d5b" /&gt;&lt;/p&gt;&lt;p&gt;In November 1914, the Australian Imperial Force left Albany WA bound for England. During the outward journey, the escort cruiser H.M.A.S Sydney was ordered to investigate reports of the German Raider Ship S.M.S  Emden in the vicinity of the Cocos Islands. Sydney engaged and destroyed the Emden. This was the first ever major combat action of the Royal Australian Navy and one of the first naval actions of the war.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/009c0441-3e95-4e68-ad10-2f810fb4e0cc" /&gt;&lt;/p&gt;&lt;p&gt;Cockburn's Memorial Walk is set along Veterans Avenue close to Cockburn Arc Sporting Arena.
The walk consists of 36 informative plinths located on both sides of Veteran Avenue.
The plinths are dedicated to a particular conflict or theatre of war in which Australian Forces fought.

Take the time to learn a little bit of our military history as you walk along Veterans Avenue. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
