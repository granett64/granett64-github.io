 <wpt lat="-32.054467" lon="115.746383">
  <ele>9.0</ele>
  <time>2024-06-14T08:00:00Z</time>
  <name>LBdYvX-05</name>
  <desc>FremantleHotel5</desc>
  <url>https://labs.geocaching.com/goto/14be8ef5-980a-486f-9d2f-5298a641fbd8</url>
  <urlname>Fremantle Hotels : S5 National Hotel by jinta29</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1019" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Fremantle Hotels : S5 National Hotel</groundspeak:name>
   <groundspeak:placed_by>jinta29</groundspeak:placed_by>
   <groundspeak:owner id="">jinta29</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Fremantle Hotels&lt;/h3&gt;&lt;h4&gt;National Hotel&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/14be8ef5-980a-486f-9d2f-5298a641fbd8"&gt;https://labs.geocaching.com/goto/14be8ef5-980a-486f-9d2f-5298a641fbd8&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What shapes are the glass features, in the dome structure, high up on the building?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/5e2f7376-877e-4c0d-85a6-f5f570f3f443" /&gt;&lt;/p&gt;&lt;p&gt;The site was first used as a shop in 1868, then during the 1870s (possibly 1880) it became the National Bank. In 1886 the bank branch relocated further along High St.
By late 1886 the National Hotel opened, taking its name from the bank that formerly occupied the site.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/b2366708-2100-41fe-afd3-ed6e32096f35" /&gt;&lt;/p&gt;&lt;p&gt;This Adventure Lab will take you to some of the existing and former hotels dotted around Freo. 
Please note that parking fees may apply in some areas.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.054767" lon="115.74545">
