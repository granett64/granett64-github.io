  <desc>WoodanillingH14</desc>
  <url>https://labs.geocaching.com/goto/71c0ff60-43b7-4697-8c23-780a79189d85</url>
  <urlname>Woodanilling Heritage Walk 1 : S4 CWA by Leg5</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9769954" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Woodanilling Heritage Walk 1 : S4 CWA</groundspeak:name>
   <groundspeak:placed_by>Leg5</groundspeak:placed_by>
   <groundspeak:owner id="">Leg5</groundspeak:owner>
