 <wpt lat="-31.931617" lon="117.7591">
  <ele>288.0</ele>
  <time>2025-07-31T08:00:00Z</time>
  <name>LBj6Cs-02</name>
  <desc>KwolyinWanderi2</desc>
  <url>https://labs.geocaching.com/goto/68d1766b-682d-4ead-9842-7c43e41c4786</url>
  <urlname>Kwolyin Wandering : S2 Out of this World by Booksgecko</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476919027" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Kwolyin Wandering : S2 Out of this World</groundspeak:name>
   <groundspeak:placed_by>Booksgecko</groundspeak:placed_by>
   <groundspeak:owner id="">Booksgecko</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Kwolyin Wandering&lt;/h3&gt;&lt;h4&gt;Out of this World&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/68d1766b-682d-4ead-9842-7c43e41c4786"&gt;https://labs.geocaching.com/goto/68d1766b-682d-4ead-9842-7c43e41c4786&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Look to your right a you will see this specimen. It’s No 70 on the board. (Common name only. One word, ten letters)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/093e054f-cb73-4985-a1ee-dcfda477e672" /&gt;&lt;/p&gt;&lt;p&gt;A Biodiverse Landscape&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/3575d9f4-a6c3-4c75-a20f-752699d03746" /&gt;&lt;/p&gt;&lt;p&gt;Kwolyin was a thriving township on the rail line. When water came to the area, via pipeline, Kwolyin missed out and the local town became Shackleton, only 5kms east. Buildings remained at Kwolyin until a bushfire raged through the area. Council repurposed the township into a free campground. Enjoy your wander.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.928933" lon="117.760583">
  <ele>279.0</ele>
  <time>2025-07-31T08:00:00Z</time>
  <name>LBj6Cs-04</name>
  <desc>KwolyinWanderi4</desc>
  <url>https://labs.geocaching.com/goto/68d1766b-682d-4ead-9842-7c43e41c4786</url>
  <urlname>Kwolyin Wandering : S4 Rural Sport by Booksgecko</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476919031" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Kwolyin Wandering : S4 Rural Sport</groundspeak:name>
   <groundspeak:placed_by>Booksgecko</groundspeak:placed_by>
   <groundspeak:owner id="">Booksgecko</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Kwolyin Wandering&lt;/h3&gt;&lt;h4&gt;Rural Sport&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/68d1766b-682d-4ead-9842-7c43e41c4786"&gt;https://labs.geocaching.com/goto/68d1766b-682d-4ead-9842-7c43e41c4786&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What sport do the fencing wire art objects represent? (One word)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/13f13007-e47d-4d81-b4dc-d382617d0260" /&gt;&lt;/p&gt;&lt;p&gt;Sport was a prominent pasttime even out in the bush.  This site is just one spot depicting evidence of the variety of sports played here, including cricket (the pitch still exists if you can find it) and football.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/3575d9f4-a6c3-4c75-a20f-752699d03746" /&gt;&lt;/p&gt;&lt;p&gt;Kwolyin was a thriving township on the rail line. When water came to the area, via pipeline, Kwolyin missed out and the local town became Shackleton, only 5kms east. Buildings remained at Kwolyin until a bushfire raged through the area. Council repurposed the township into a free campground. Enjoy your wander.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
