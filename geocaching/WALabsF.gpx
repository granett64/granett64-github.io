  <groundspeak:cache id="1476909926" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Pingelly, WA (2) : S1  Pingelly, Post Office.</groundspeak:name>
   <groundspeak:placed_by>Everlasting</groundspeak:placed_by>
   <groundspeak:owner id="">Everlasting</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
