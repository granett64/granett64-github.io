  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9653500" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Strickland Street Stroll : S3 Historic Tree</groundspeak:name>
