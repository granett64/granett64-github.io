   <groundspeak:placed_by>Granett</groundspeak:placed_by>
   <groundspeak:owner id="">Granett</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;The (old) Road to Bunbury&lt;/h3&gt;&lt;h4&gt;Pinjarra&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/c8032bc6-fa86-4ce5-9234-a06129c1e8fc"&gt;https://labs.geocaching.com/goto/c8032bc6-fa86-4ce5-9234-a06129c1e8fc&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Where are you?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/69376ad8-83f6-4d5b-b2bd-af9585a2e3a7" /&gt;&lt;/p&gt;&lt;p&gt;Pinjarra is an area rich in history, settled in the early 1830s, the town has retained much of its scenic countryside and timber milling heritage.

Catering to all who stop to enjoy Pinjarra's hospitality, many of the town's beautifully restored historic buildings now house cafes, tearooms, restaurants and charming accommodation.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/3de6cb8d-13fc-4aec-90e3-a2dd257ecc2d" /&gt;&lt;/p&gt;&lt;p&gt;Before the Forrest Hwy was opened in 2009 one of the main routes to Bunbury was along the South Western Hwy. The old road to Bunbury passes through several towns which this Adventure Lab will cause you to visit. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/04af858f-9b01-42e0-9ddf-813dc8dd3be4" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Well done!&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.8404" lon="115.920067">
