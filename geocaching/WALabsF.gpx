  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918917" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #062 : S2 Shades of Fremantle: South Fremantle</groundspeak:name>
   <groundspeak:placed_by>Lachlan1.77</groundspeak:placed_by>
