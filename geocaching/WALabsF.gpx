  <groundspeak:cache id="9783167" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Perth Railways 1 : S5 Midland Station</groundspeak:name>
   <groundspeak:placed_by>GHFB</groundspeak:placed_by>
   <groundspeak:owner id="">GHFB</groundspeak:owner>
