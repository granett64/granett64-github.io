   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Cinema &lt;/h3&gt;&lt;h4&gt;Groundhog day&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/a0d6dde3-dddc-4a90-b3be-551ebb2a8dd6"&gt;https://labs.geocaching.com/goto/a0d6dde3-dddc-4a90-b3be-551ebb2a8dd6&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the name of Phil the groundhog’s home? (two words)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/2f616c6e-c30b-45f2-b695-572cf2d31e40" /&gt;&lt;/p&gt;&lt;p&gt;Groundhog Day is a 1993 American fantasy comedy film directed by Harold Ramis from a screenplay by him and Danny Rubin. Starring Bill Murray, Andie MacDowell, and Chris Elliott, it tells the story of a cynical television weatherman covering the annual Groundhog Day event in Punxsutawney, Pennsylvania, who becomes trapped in a time loop, forcing him to relive February 2 repeatedly. The film also features Stephen Tobolowsky, Brian Doyle-Murray, Marita Geraghty, Angela Paton, Rick Ducommun, Rick Overton, and Robin Duke in supporting roles.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/4b16a94f-1d8f-4df0-8837-787ffd37f359" /&gt;&lt;/p&gt;&lt;p&gt;This Lab is a walk down memory lane for me, places ive seen films and some of my favourite films. there are no answers to be found at the locations, but the answers are easily found on google. 

The locations must be visted to open the Questions and all the questions are related to films.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.904661" lon="115.798048">
