   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Robinson Reserve 2&lt;/h3&gt;
    &lt;h4&gt;Cricket Nets&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/c6d33f30-ef20-4ab2-a2a4-549a74392710" target="_blank"&gt;https://labs.geocaching.com/goto/c6d33f30-ef20-4ab2-a2a4-549a74392710&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 20m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;How many cricket nets are there? (word)&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/f64c09b7-dad3-4e5c-9488-0221198cc097" /&gt;&lt;/p&gt;
    &lt;p&gt;Previously the cricket nets were situated at the opposite corner of the reserve. These new nets commenced construction in 2022.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/17c25eac-869d-420a-a38b-4bbd5e332256" /&gt;&lt;/p&gt;
    &lt;p&gt;Robinson Reserve is a seven-nectare reserve, adjacent to the Osborne Community Hub. It is bound by Royal, Park and Waterloo Streets in Tuart Hill. The reserve is classified as a district open space and provides valuable sporting and recreational opportunities for the community. It is home to the Osborne Agricultural Society and Osborne Park Cricket Club.
At the reserve you will find a playground, shelters, BBQ, public toilets, picnic tables, skate area, basketball half-court, cricket nets and an accessible path network circulating the park.
The reserve is named after William Edward Robinson (1880-1932), a well known dairyman in the area.
He established his dairy in 1905.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.896233" lon="115.831317">
  <ele>38.0</ele>
  <time>2025-11-16T08:00:00Z</time>
  <name>LBPJY4-4</name>
  <desc>RobinsonReser24</desc>
  <url>https://labs.geocaching.com/goto/c6d33f30-ef20-4ab2-a2a4-549a74392710</url>
  <urlname>Robinson Reserve 2 : S4 Robinson Reserve Clubroom by AndrewB1973</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9673607" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Robinson Reserve 2 : S4 Robinson Reserve Clubroom</groundspeak:name>
   <groundspeak:placed_by>AndrewB1973</groundspeak:placed_by>
   <groundspeak:owner id="">AndrewB1973</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Robinson Reserve 2&lt;/h3&gt;
    &lt;h4&gt;Robinson Reserve Clubroom&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/c6d33f30-ef20-4ab2-a2a4-549a74392710" target="_blank"&gt;https://labs.geocaching.com/goto/c6d33f30-ef20-4ab2-a2a4-549a74392710&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 20m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;When was the Robinson Reserve Clubroom officially opened? (Exactly how it is written on the plaque)&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/d7e7bfe1-ab24-4730-b487-e26d9aec1f66" /&gt;&lt;/p&gt;
    &lt;p&gt;Construction commenced in 2022 for a $1.2 million upgrade of the existing sporting club room facilities, cricket nets and pathway connections. The Clubrooms were officially opened by Deputy Mayor Stephanie Proud JP.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/17c25eac-869d-420a-a38b-4bbd5e332256" /&gt;&lt;/p&gt;
    &lt;p&gt;Robinson Reserve is a seven-nectare reserve, adjacent to the Osborne Community Hub. It is bound by Royal, Park and Waterloo Streets in Tuart Hill. The reserve is classified as a district open space and provides valuable sporting and recreational opportunities for the community. It is home to the Osborne Agricultural Society and Osborne Park Cricket Club.
At the reserve you will find a playground, shelters, BBQ, public toilets, picnic tables, skate area, basketball half-court, cricket nets and an accessible path network circulating the park.
The reserve is named after William Edward Robinson (1880-1932), a well known dairyman in the area.
He established his dairy in 1905.&lt;/p&gt;</groundspeak:long_description>
