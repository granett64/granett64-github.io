 <wpt lat="-31.960883" lon="115.8449">
  <ele>54.0</ele>
  <time>2022-06-09T08:00:00Z</time>
  <name>LBXsWP-05</name>
  <desc>StateWarMemori5</desc>
  <url>https://labs.geocaching.com/goto/7a6e9012-f72d-4f8e-bfb8-02ba69341b4a</url>
  <urlname>State War Memorial : S5 Mount Eliza by Barnzy12</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99003669" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>State War Memorial : S5 Mount Eliza</groundspeak:name>
   <groundspeak:placed_by>Barnzy12</groundspeak:placed_by>
   <groundspeak:owner id="">Barnzy12</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;State War Memorial&lt;/h3&gt;&lt;h4&gt;Mount Eliza&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/7a6e9012-f72d-4f8e-bfb8-02ba69341b4a"&gt;https://labs.geocaching.com/goto/7a6e9012-f72d-4f8e-bfb8-02ba69341b4a&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;There is a square plaque on the fence with a quote by Turkish Commander Ataturk …”johnnies and the …….” (One word seven letters)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/1877e7e9-ce67-49d5-9a35-6ba26912d637" /&gt;&lt;/p&gt;&lt;p&gt;Mount Eliza is a hill that overlooks the city of Perth, Western Australia and forms part of Kings Park.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/fb354e4e-60af-40f6-aaa8-cb25e295c76b" /&gt;&lt;/p&gt;&lt;p&gt;The State War Memorial Precinct is located on Mount Eliza overlooking Perth Water. The precinct comprises of the Cenotaph, Court of Contemplation, Flame of Remembrance and Pool of Reflection; with memorials to various battles, military units, prisoners of war and other groups found throughout the parklands.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/89f9ae36-4f8b-42fe-9dd6-0d23943ff68d" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Congratulations&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.96075" lon="115.844617">
  <ele>67.0</ele>
  <time>2022-06-09T08:00:00Z</time>
  <name>LBXsWP-04</name>
  <desc>StateWarMemori4</desc>
  <url>https://labs.geocaching.com/goto/7a6e9012-f72d-4f8e-bfb8-02ba69341b4a</url>
  <urlname>State War Memorial : S4 Cenotaph by Barnzy12</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99003667" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>State War Memorial : S4 Cenotaph</groundspeak:name>
   <groundspeak:placed_by>Barnzy12</groundspeak:placed_by>
   <groundspeak:owner id="">Barnzy12</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;State War Memorial&lt;/h3&gt;&lt;h4&gt;Cenotaph&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/7a6e9012-f72d-4f8e-bfb8-02ba69341b4a"&gt;https://labs.geocaching.com/goto/7a6e9012-f72d-4f8e-bfb8-02ba69341b4a&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;At the location is a crest, what 3 words are on the crest?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/9d177fc6-48f9-4f1e-832e-756d6ff1da22" /&gt;&lt;/p&gt;&lt;p&gt;An 18 metre granite obelisk honours all Western Australians who gave their lives in the service of their country. The design is almost a replica of the Australian Imperial Force Memorials erected in France and Belgium. The heavy concrete foundations are supplemented by heavy brick walls which enclose an inner crypt. The internal walls of the undercroft list the names of more than 7,000 members of the services killed in action or who died of wounds or illness in WWI.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/fb354e4e-60af-40f6-aaa8-cb25e295c76b" /&gt;&lt;/p&gt;&lt;p&gt;The State War Memorial Precinct is located on Mount Eliza overlooking Perth Water. The precinct comprises of the Cenotaph, Court of Contemplation, Flame of Remembrance and Pool of Reflection; with memorials to various battles, military units, prisoners of war and other groups found throughout the parklands.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/329d9d40-4c6f-4413-9693-c9a2ca54dfaa" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Congratulations&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.960633" lon="115.843917">
  <ele>72.0</ele>
  <time>2022-06-09T08:00:00Z</time>
  <name>LBXsWP-03</name>
  <desc>StateWarMemori3</desc>
  <url>https://labs.geocaching.com/goto/7a6e9012-f72d-4f8e-bfb8-02ba69341b4a</url>
  <urlname>State War Memorial : S3 Eternal Flame by Barnzy12</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99003665" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>State War Memorial : S3 Eternal Flame</groundspeak:name>
   <groundspeak:placed_by>Barnzy12</groundspeak:placed_by>
   <groundspeak:owner id="">Barnzy12</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;State War Memorial&lt;/h3&gt;&lt;h4&gt;Eternal Flame&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/7a6e9012-f72d-4f8e-bfb8-02ba69341b4a"&gt;https://labs.geocaching.com/goto/7a6e9012-f72d-4f8e-bfb8-02ba69341b4a&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What four words are written on the edge of the pool of remembrance &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/5c2048d3-e432-41bd-a317-30b5250b523d" /&gt;&lt;/p&gt;&lt;p&gt;A flame is widely accepted as a symbol of eternal life. An eternal flame at a war memorial symbolizes a nation's perpetual gratitude towards, and remembrance of, its war dead.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/fb354e4e-60af-40f6-aaa8-cb25e295c76b" /&gt;&lt;/p&gt;&lt;p&gt;The State War Memorial Precinct is located on Mount Eliza overlooking Perth Water. The precinct comprises of the Cenotaph, Court of Contemplation, Flame of Remembrance and Pool of Reflection; with memorials to various battles, military units, prisoners of war and other groups found throughout the parklands.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/2e51b116-6d9c-4956-8d2c-7a6ea5238e03" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Congratulations&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
