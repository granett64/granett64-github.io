   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Kununurra Stars&lt;/h3&gt;&lt;h4&gt;Currently WA's Premier Star&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/3b29f6c4-2c3c-4184-801a-a11c5aa6b157"&gt;https://labs.geocaching.com/goto/3b29f6c4-2c3c-4184-801a-a11c5aa6b157&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What date did Mark McGowan plant this tree? (exactly as shown on plaque)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/2d561ba7-0437-451d-9cf3-eee28b5214af" /&gt;&lt;/p&gt;&lt;p&gt;Check out the plaque for the current (2021) State Premier - Mark McGowan&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/5f6ac709-80eb-4b23-b845-5a1a0c1931e8" /&gt;&lt;/p&gt;&lt;p&gt;It's time WA spread its AdLab wings and headed to the far north - here you will find a short pleasant wander around Kununurra's Celebrity Tree Park finding the famous folk who have planted trees.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/d58faa7c-59e8-4e4c-aaaa-7dd3d69d8d07" /&gt;&lt;/p&gt;</groundspeak:long_description>
