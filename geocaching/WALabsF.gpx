   <groundspeak:owner id="">iluvtrekking</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Welcome to Onslow&lt;/h3&gt;
    &lt;h4&gt;Drill Baby Drill&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/5f07649d-933f-4128-b4bb-e7953cbcd28a" target="_blank"&gt;https://labs.geocaching.com/goto/5f07649d-933f-4128-b4bb-e7953cbcd28a&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 25m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;What is the last name embossed on the blades?&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/7b3ed4c0-fbfb-4819-ad77-ebbcae36eb79" /&gt;&lt;/p&gt;
    &lt;p&gt;We were unable to find any information on these drill heads. 
If anyone knows anything, we would be pleased to have the information.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/35901638-ae2e-4afc-8627-8adb9c14a1dc" /&gt;&lt;/p&gt;
    &lt;p&gt;Onslow is a coastal town located in the Pilbara region of Western Australia, situated roughly 1,386 kilometres north of Perth. Positioned on a unique peninsula in Beadon Bay, it is one of the few places in Australia where you can watch the sun rise and set over the ocean. The town serves as a dual hub for massive resource projects such as Onslow Salt and Chevron&amp;#039;s Wheatstone LNG project, while remaining a relaxed, hidden gem for holidaymakers.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-21.6363" lon="115.113917">
  <ele>9.0</ele>
  <time>2026-06-21T08:00:00Z</time>
  <name>LBTAKN-1</name>
  <desc>WelcomeToOnslo1</desc>
  <url>https://labs.geocaching.com/goto/5f07649d-933f-4128-b4bb-e7953cbcd28a</url>
  <urlname>Welcome to Onslow : S1 Paparazzi Dogs by iluvtrekking</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9754996" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Welcome to Onslow : S1 Paparazzi Dogs</groundspeak:name>
   <groundspeak:placed_by>iluvtrekking</groundspeak:placed_by>
   <groundspeak:owner id="">iluvtrekking</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Welcome to Onslow&lt;/h3&gt;
    &lt;h4&gt;Paparazzi Dogs&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/5f07649d-933f-4128-b4bb-e7953cbcd28a" target="_blank"&gt;https://labs.geocaching.com/goto/5f07649d-933f-4128-b4bb-e7953cbcd28a&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 24m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;Onslow’s Paparazzi Dogs are strategically positioned, looking out across the water. What are they waiting for?&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/9e5d6847-73f5-448a-bd13-2e472d292660" /&gt;&lt;/p&gt;
    &lt;p&gt;Gillie and Marc’s Paparazzi Dogs are the world’s most notorious photographers. The bronze Dogmen have sniffed out the rich and famous in Melbourne’s Federation Square, Woolloomooloo Wharf in Sydney, the Jing’an Sculpture Park in Shanghai, outside Raffles City Shops in Singapore, New York’s Brooklyn and Greenwich Village and even little old Onslow in Western Australia. People from all over the world are eager to pose with the Pap Dogs.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/35901638-ae2e-4afc-8627-8adb9c14a1dc" /&gt;&lt;/p&gt;
    &lt;p&gt;Onslow is a coastal town located in the Pilbara region of Western Australia, situated roughly 1,386 kilometres north of Perth. Positioned on a unique peninsula in Beadon Bay, it is one of the few places in Australia where you can watch the sun rise and set over the ocean. The town serves as a dual hub for massive resource projects such as Onslow Salt and Chevron&amp;#039;s Wheatstone LNG project, while remaining a relaxed, hidden gem for holidaymakers.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.369167" lon="117.003633">
