  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9754999" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Welcome to Onslow : S4 4 Mile Creek</groundspeak:name>
   <groundspeak:placed_by>iluvtrekking</groundspeak:placed_by>
   <groundspeak:owner id="">iluvtrekking</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Welcome to Onslow&lt;/h3&gt;
    &lt;h4&gt;4 Mile Creek&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/5f07649d-933f-4128-b4bb-e7953cbcd28a" target="_blank"&gt;https://labs.geocaching.com/goto/5f07649d-933f-4128-b4bb-e7953cbcd28a&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 25m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;The sign warns you to keep away from the water’s edge. Why? [two words]&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/8de8004b-ac14-412f-be3c-f6591dcabf35" /&gt;&lt;/p&gt;
    &lt;p&gt;Located 8km from the Onslow town centre, 4 Mile Creek is a popular local spot for fishing, mud crabbing, picnicking and beach 4WDing. It features a shaded day-use rest area with gas BBQs, picnic tables and a dirt boat ramp.
&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/35901638-ae2e-4afc-8627-8adb9c14a1dc" /&gt;&lt;/p&gt;
    &lt;p&gt;Onslow is a coastal town located in the Pilbara region of Western Australia, situated roughly 1,386 kilometres north of Perth. Positioned on a unique peninsula in Beadon Bay, it is one of the few places in Australia where you can watch the sun rise and set over the ocean. The town serves as a dual hub for massive resource projects such as Onslow Salt and Chevron&amp;#039;s Wheatstone LNG project, while remaining a relaxed, hidden gem for holidaymakers.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
