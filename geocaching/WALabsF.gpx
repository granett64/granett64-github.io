   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Discover Pemberton&lt;/h3&gt;&lt;h4&gt;A Strange Tree?&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/91b9475f-dbd0-439d-b7bd-883bc8bfa5a9"&gt;https://labs.geocaching.com/goto/91b9475f-dbd0-439d-b7bd-883bc8bfa5a9&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What tree is planted at this location (1 word)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/569b5703-6592-4d27-b8e2-2648bbd0dc1f" /&gt;&lt;/p&gt;&lt;p&gt;Pemberton being a town surrounded by massive Karri Trees. Another tree was planted in the town.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/4595632c-5318-4829-ae8b-01b558120734" /&gt;&lt;/p&gt;&lt;p&gt;Pemberton is known for it's tall karri trees. There are a couple of fire lookout trees in the region you can still climb - Gloucester Tree and Dave Evans Bicentennial Tree. The area has some beautiful landscapes and popular for photographers. Having been a regular visitor to the town for 40 years - I encourage you to discover it for yourself.

Please note: There is paid entry to Gloucester Tree.
$15 National Parks Day Pass - per car
$8 Concession (or Motorbike) National Park Day Pass&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;Award Message:&lt;br /&gt;It is believed Albert knight planted this tree in 1929.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
