  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9653502" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Strickland Street Stroll : S5 Old Cottage</groundspeak:name>
   <groundspeak:placed_by>richlink</groundspeak:placed_by>
   <groundspeak:owner id="">richlink</groundspeak:owner>
