   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Bayswater Street Art&lt;/h3&gt;
    &lt;h4&gt;Take the Long Way Home&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/638fada0-31b3-40fe-a597-267587516da4" target="_blank"&gt;https://labs.geocaching.com/goto/638fada0-31b3-40fe-a597-267587516da4&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 50m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    multiple choice
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;Name a bird that appears in the mural?&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/ec3098dd-2629-41bc-a6bc-e760449537f3" /&gt;&lt;/p&gt;
    &lt;p&gt;Take the Long Way Home, a stunning 460-meter mural by Joanna Lamb. This vibrant artwork connects the new Bayswater Station to the METRONET Perth’s Ellenbrook line, drawing inspiration from the area’s rich and verdant landscapes.
 
Through thoughtful community engagement, Joanna has included a diverse range of plant and flower species from local gardens, alongside native birds, capturing the essence of the region in vibrant, expressive detail.
 
Take the Long Way Home invites viewers to slow down, walk along the mural, and immerse themselves in the natural beauty surrounding the train line. It serves as a reminder to appreciate the details of the journey, not just the destination.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/22ae7441-2c2e-4854-9dbb-cbf5ae33eb4b" /&gt;&lt;/p&gt;
    &lt;p&gt;The City of Bayswater is proud to be home to countless outdoor artworks from a range of talented homegrown artists. Take a stroll around Bayswater and you’ll find an array of colourful artwork splashed across laneways, walls and shopfronts. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
