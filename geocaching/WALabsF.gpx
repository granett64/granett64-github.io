   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Convoy Walk&lt;/h3&gt;&lt;h4&gt;Heritage Rose Garden&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/4e032777-9aa9-46e8-9ac2-eaeef28a5b6c"&gt;https://labs.geocaching.com/goto/4e032777-9aa9-46e8-9ac2-eaeef28a5b6c&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Fill in the blank on the sign: Pause and reflect in …..&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/88e6f393-d511-4fdc-a0d0-2d79d98223e7" /&gt;&lt;/p&gt;&lt;p&gt;The Heritage Rose Garden is dedicated to the strength and courage of women in wartime. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/1e12e854-31da-4051-ac06-61d3cb90eb9b" /&gt;&lt;/p&gt;&lt;p&gt;Situated in the Albany Heritage Park, The Convoy Walk and lookout on Mount Adelaide was officially opened on 1 November 2014. The Convoy Walk leads to the Convoy Lookout with a view over King George Sound where troops gathered on ships before departing for the First World War. The walk contains 21 markers containing information about the ships in the First and Second Convoys, including the names and images of the troopships and escorts, and where they embarked troops. The lookout includes a shelter and interpretive material relating to the vessels in the convoy.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-35.030467" lon="117.913267">
  <ele>109.0</ele>
  <time>2022-11-22T08:00:00Z</time>
  <name>LBcbpx-01</name>
  <desc>ConvoyWalkS1Lon</desc>
  <url>https://labs.geocaching.com/goto/4e032777-9aa9-46e8-9ac2-eaeef28a5b6c</url>
  <urlname>Convoy Walk : S1 Longing, Memory, Sight by Barnzy12</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-855" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Convoy Walk : S1 Longing, Memory, Sight</groundspeak:name>
   <groundspeak:placed_by>Barnzy12</groundspeak:placed_by>
