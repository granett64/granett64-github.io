  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1794" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #020 : S3 Air Commodore Sir Hughie Idwal Edwards</groundspeak:name>
   <groundspeak:placed_by>Kapelula</groundspeak:placed_by>
