   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;John Oldham Park&lt;/h3&gt;&lt;h4&gt;Who was John Oldham?&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/3b67a8de-59e9-4f20-b075-5c3509df2952"&gt;https://labs.geocaching.com/goto/3b67a8de-59e9-4f20-b075-5c3509df2952&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What was the occupation of John Oldham? (2 words)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/252e7503-c856-4229-bbe0-2c39c6438f8c" /&gt;&lt;/p&gt;&lt;p&gt;This Park was named after John Oldham after the Narrows Bridge and interchange was completed in the late 1950's.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a1dd3cce-a333-4b3c-97fc-1bbab4db19c8" /&gt;&lt;/p&gt;&lt;p&gt;This park was constructed when the Narrows Bridge was constructed over the Swan River in the 1950's. The park was designed between the interchanges and the Swan River, and would act as "green lungs", breathing life and oxygen into what would otherwise be an inhospitable traffic environment. This park was to be covered in exotic plants with a series of lakes and small waterfalls.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
