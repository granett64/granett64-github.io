  <name>LBMqK1-05</name>
  <desc>WAQuokkaAdLa034</desc>
  <url>https://labs.geocaching.com/goto/be6a3008-4f22-4f59-918c-f22daf5951be</url>
  <urlname>WAQuokka AdLab Art #002 : S5 Rottnest Snorkel Trail by pommieparkin2</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1417" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #002 : S5 Rottnest Snorkel Trail</groundspeak:name>
   <groundspeak:placed_by>pommieparkin2</groundspeak:placed_by>
   <groundspeak:owner id="">pommieparkin2</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #002&lt;/h3&gt;&lt;h4&gt;Rottnest Snorkel Trail&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/be6a3008-4f22-4f59-918c-f22daf5951be"&gt;https://labs.geocaching.com/goto/be6a3008-4f22-4f59-918c-f22daf5951be&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;The sanctuary zones on Rottnest Island are Armstrong Bay, Green Island, Parker Point, and West End Demersal, what is the name of the fifth one?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/3b4c1a3b-2eb9-40aa-8676-d9c4ab3dabf6" /&gt;&lt;/p&gt;&lt;p&gt;Fays Bay is a picturesque snorkelling spot featuring clear waters and an abundance of marine life. This is an excellent choice for snorkellers who want to enjoy both the underwater scenery and the tranquillity of a lesser-known location.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/36366556-3028-42d0-966c-12be5d9526e6" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab Art series - which intends to form a giant quokka off the coast of Perth.There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and Rottnest Ferry Terminal.

To join this project, please contact the project Admins on WAQuokkaAdLab@gmail.com

Every time we have Pommie visitors its a must to take them to Rottnest Island where there is so much to do for all age groups. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.052367" lon="115.740817">
  <ele>2.0</ele>
