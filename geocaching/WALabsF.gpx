  <url>https://labs.geocaching.com/goto/5f07649d-933f-4128-b4bb-e7953cbcd28a</url>
  <urlname>Welcome to Onslow : S2 Drill Baby Drill by iluvtrekking</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9754997" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Welcome to Onslow : S2 Drill Baby Drill</groundspeak:name>
