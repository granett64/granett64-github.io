  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918823" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #072 : S4 Waardong</groundspeak:name>
   <groundspeak:placed_by>atCatpacity</groundspeak:placed_by>
   <groundspeak:owner id="">atCatpacity</groundspeak:owner>
