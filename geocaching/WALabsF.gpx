  <groundspeak:cache id="99003705" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Welcome to Narrogin : S3 The Doll Factory</groundspeak:name>
   <groundspeak:placed_by>ebenie</groundspeak:placed_by>
   <groundspeak:owner id="">ebenie</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Welcome to Narrogin&lt;/h3&gt;&lt;h4&gt;The Doll Factory&lt;/h4&gt;&lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;linear&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/06cef230-1579-45bf-80d4-a688189fdcae"&gt;https://labs.geocaching.com/goto/06cef230-1579-45bf-80d4-a688189fdcae&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many girls worked in house&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/85bb0901-b645-4c98-bcd7-be74e66add11" /&gt;&lt;/p&gt;&lt;p&gt;This house is now a private residence.  Please don't walk on any gardens check answer from pathway  THANKYOU. This is to show how other services were in the town for locals to achieve something for themselves in doing piece working in this industry.  Also CWA was big then too

The house here in 1918-1923 made composition dolls with orders sent as far away as The Eastern States.  Employing local people and piece workers
&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/7da06754-2acf-4ffe-822b-df860ab943ce" /&gt;&lt;/p&gt;&lt;p&gt;A bit of the history of our town 
Of days gone by.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/dfd0d9bb-0631-4d80-a486-91cf954a2696" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Congratulations.  Well done!&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
