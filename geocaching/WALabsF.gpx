  <urlname>WAQuokka AdLab Art #006 : S1 Project APE by Leg5</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918704" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #006 : S1 Project APE</groundspeak:name>
