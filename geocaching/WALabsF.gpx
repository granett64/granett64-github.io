   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #107&lt;/h3&gt;&lt;h4&gt;Perth's Tall Buildings - Palace Tower&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/fe304deb-7b07-4465-a6c9-c89eee63b1cb"&gt;https://labs.geocaching.com/goto/fe304deb-7b07-4465-a6c9-c89eee63b1cb&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many floors in the building?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/d0bde7f3-4a8b-4dcd-95ba-6d287f1b04fd" /&gt;&lt;/p&gt;&lt;p&gt;108 St Georges Terrace, also Palace Tower and formerly the South32 Tower, Bankwest Tower, Bond Tower, and R&amp;I Tower, is a fifty-storey office building in Perth, Western Australia. The project was initiated in 1981 and completed in 1988, and the building measures 214 metres to its roof and 247 metres to the tip of its communications antenna. Upon completion, it was Perth's tallest building until Central Park surpassed it in 1992. It is the third-tallest building in Perth.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/080c6895-e4d0-4673-89de-434f8c4b1196" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
