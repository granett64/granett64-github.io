   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Meander thru the ages&lt;/h3&gt;&lt;h4&gt;Where they came from&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/337f3b26-6e4a-43ce-8fa9-ced5bb30a17b"&gt;https://labs.geocaching.com/goto/337f3b26-6e4a-43ce-8fa9-ced5bb30a17b&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many pioneers drowned&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c4fcfa38-eba1-443e-9fa0-c6f6c6adc77b" /&gt;&lt;/p&gt;&lt;p&gt;A visit here is an education into Augusta ,names will appear here that will be replicated all thru the townsite and thru to Busselton. You will learn the history of the ancestors and the hardships they endured to built the town. Across the road is the place to be on ANZAC day this is also worth a look. My own children(now grown) learnt the history of Augusta here.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/8ee60e45-60cf-4613-8de0-fa9bb99ee003" /&gt;&lt;/p&gt;&lt;p&gt;I have started this lab in an area that there are no others and to emphasis the uniqueness of the Southwest. From old to new and tourist places to points of interest that we found intriguing. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/fd46b6e4-9771-4bae-80fb-7e11cac59108" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Congratulations . Please have a look around and enjoy the beautiful surroundings.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
