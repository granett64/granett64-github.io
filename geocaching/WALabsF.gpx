  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1832" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #043 : S2 Lake Cave</groundspeak:name>
   <groundspeak:placed_by>BJA3</groundspeak:placed_by>
   <groundspeak:owner id="">BJA3</groundspeak:owner>
