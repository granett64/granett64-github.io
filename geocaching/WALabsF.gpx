  <desc>WelcomeToLanc13</desc>
  <url>https://labs.geocaching.com/goto/e06458f5-d6b2-49aa-9442-f11b86857195</url>
  <urlname>Welcome to Lancelin [1] : S3 Lest We Forget- Lancelin War Memorial by Paskersfind</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9733322" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Welcome to Lancelin [1] : S3 Lest We Forget- Lancelin War Memorial</groundspeak:name>
   <groundspeak:placed_by>Paskersfind</groundspeak:placed_by>
   <groundspeak:owner id="">Paskersfind</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Welcome to Lancelin [1]&lt;/h3&gt;
    &lt;h4&gt;Lest We Forget- Lancelin War Memorial&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/e06458f5-d6b2-49aa-9442-f11b86857195" target="_blank"&gt;https://labs.geocaching.com/goto/e06458f5-d6b2-49aa-9442-f11b86857195&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 20m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;What was the military rank of Tony Fletcher?&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/6aee75bf-8eff-459f-96c4-d96f24620244" /&gt;&lt;/p&gt;
    &lt;p&gt;On the day after Anzac Day, many fresh floral tributes to those who made the ultimate sacrifice served as a poignant reminder of the importance of this day for Australians and New Zealanders.  On the footpath in front of the memorial is a small brass plaque needed to answer to the location question.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/be487362-1c29-4460-8c50-a512cc7cd2a3" /&gt;&lt;/p&gt;
    &lt;p&gt;Lancelin is a small town located on Western Australia&amp;#039;s Turquoise Coast offering clean sandy beaches, crisp white sand dunes and a relaxed seaside lifestyle. Activities available in the area include sandboarding, 4-wheel drive adventures and of course fishing. It is located 127 kilometres north of Perth along the scenic Indian Ocean Drive.
This Adventure Lab is the first part of a 5-stop tour of the town, followed by a second lab and a final bonus cache.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
