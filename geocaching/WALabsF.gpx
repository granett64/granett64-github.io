   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #107&lt;/h3&gt;&lt;h4&gt;Perth's Tall Buildings - Central Park&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/fe304deb-7b07-4465-a6c9-c89eee63b1cb"&gt;https://labs.geocaching.com/goto/fe304deb-7b07-4465-a6c9-c89eee63b1cb&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many floors in the building?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/3871bedb-3520-4104-a2b9-31916df96aa5" /&gt;&lt;/p&gt;&lt;p&gt;Central Park measures 226 m from its base at St Georges Terrace to the roof, and 249 m to the tip of its communications mast. Upon its completion in 1992, the tower became the tallest building in Perth, and was the fourth-tallest in Australia from then till 2005.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/080c6895-e4d0-4673-89de-434f8c4b1196" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.&lt;/p&gt;</groundspeak:long_description>
