   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Pelham Reserve Lookout&lt;/h3&gt;&lt;h4&gt;James Drummond&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/322954f3-f5f0-42b9-8d0b-e50a16f6b21d"&gt;https://labs.geocaching.com/goto/322954f3-f5f0-42b9-8d0b-e50a16f6b21d&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many plant species are named after him?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/b3e9e294-6ffa-4b17-920e-8f135732be25" /&gt;&lt;/p&gt;&lt;p&gt;Born in Scotland Drummond was an avid Horticulturalist and plant collector. He was curator at Ireland's Cork Botanical gardens before migrating with his family to the Swan River Colony
• in 1829. He was appointed the first Government Botanist in Western Australia and also worked as Superintendent of Gardens. He conducted numerous, extensive expeditions in Western Australia and collected thousands of botanical specimens. Today, examples of his plant collection are found in herbaria across the world. He named many of Western Australia's native plants and 119 species are named after him.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/eb7daa58-1c64-4ffd-8265-9399959a97fe" /&gt;&lt;/p&gt;&lt;p&gt;This Adventure Lab is a based at the Pelham Reserve Lookout, with views across the town of Toodyay. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.557017" lon="116.468467">
  <ele>215.0</ele>
