  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1025" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Secret Playgrounds : S5 Lark Hill Playground.</groundspeak:name>
   <groundspeak:placed_by>rudi63</groundspeak:placed_by>
