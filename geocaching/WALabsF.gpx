   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;History of International Geocaching Day&lt;/h3&gt;
    &lt;h4&gt;Where it all began!&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/3555431c-ef2c-44c1-b28b-ef59611a44fe" target="_blank"&gt;https://labs.geocaching.com/goto/3555431c-ef2c-44c1-b28b-ef59611a44fe&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 500m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    multiple choice
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;What date was the first IGD&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/252242e3-4a13-4c8e-9b69-1c4d3142b27a" /&gt;&lt;/p&gt;
    &lt;p&gt;This year marks fifteen years since the first International Geocaching Day (IGD) on August 20, 2011. What started as an idea for another way to celebrate the 2011 Geocaching Block Party has turned into its own yearly tradition that celebrates our global game and the international community of geocachers that makes the game so special.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a040d62c-f1d1-49ee-9fb3-c7916fbeac94" /&gt;&lt;/p&gt;
    &lt;p&gt;2026 marks the 15th Anniversary of the first IGD event held all the way back on August 20th 2011.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
