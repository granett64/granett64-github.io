   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Grape Expectations!&lt;/h3&gt;&lt;h4&gt;Harewood&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/b578cad5-90ae-429c-9a01-2eeca4e3ab15"&gt;https://labs.geocaching.com/goto/b578cad5-90ae-429c-9a01-2eeca4e3ab15&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;On the Telecom box on the left hand side of the entry, on the bottom line what are the two digits after CB?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/59542828-a020-4850-bc81-9c9d5ec49a40" /&gt;&lt;/p&gt;&lt;p&gt;James Kellie purchased Harewood in 2003 after being the winemaker at Howard Park. Grapes are grown in select, low yielding vineyards to create wines that represent the best the region has to offer.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/ee5bcc84-5279-48b4-a276-9785f561e118" /&gt;&lt;/p&gt;&lt;p&gt;A wine lovers paradise. This stunning region offers over 20 wineries, all within close proximity to each other and in stunning locations. Award winning wines of many varieties, some vineyards have restaurants, play areas for the kids, unique gift ideas, hampers for picnics and live entertainment. So get out and explore 'our paradise' and breathe in some of the freshest air on the planet!!&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
