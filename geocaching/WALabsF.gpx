   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #086&lt;/h3&gt;&lt;h4&gt;Claire Hooper&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/fc0c18e4-cb6c-4f15-995e-4a16636e1b9a"&gt;https://labs.geocaching.com/goto/fc0c18e4-cb6c-4f15-995e-4a16636e1b9a&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;In what year did Claire first run for the Liberal Party in Kalgoorie?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/36911c17-9e6d-43af-b68f-5002f263543b" /&gt;&lt;/p&gt;&lt;p&gt;Claire Hooper is an Australian comedian, presenter, and writer, best known for co-hosting The Great Australian Bake Off with Mel Buttle. She was a team captain on the 2008 revival of Good News Week and a regular on The Sideshow with Paul McDermott. Since 2005, she has been a frequent performer at the Melbourne International Comedy Festival.
Born in Perth!&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/d32df207-a7f6-447f-a938-ac235d53a4cb" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.&lt;/p&gt;</groundspeak:long_description>
