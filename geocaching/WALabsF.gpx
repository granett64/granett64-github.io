   <groundspeak:placed_by>LOLOACacheIC</groundspeak:placed_by>
   <groundspeak:owner id="">LOLOACacheIC</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #45&lt;/h3&gt;&lt;h4&gt;Fish #5&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/088444e3-ad3d-479a-a28d-874872871882"&gt;https://labs.geocaching.com/goto/088444e3-ad3d-479a-a28d-874872871882&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What fish is this?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/1789ecea-97c7-45c8-85a7-3886f91fccfc" /&gt;&lt;/p&gt;&lt;p&gt;This fish is yellowish to pale silvery brown, with a dark band through the eye and 5 vertical lines on the upper 2/3 of its body, and a broad blackish brown band along the rear of the fish and on the anal fin. Its found along the North West Shelf off the coast of WA from Pilbara region down to Israelite Bay in the south. They grow to 13cm. They are omnivores, feeding on algae and zooplankton. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/be0c4763-e30d-4df6-953f-a8138b34f844" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the4 WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.
To join this project, please contact the project admins on WAQuokkaAdLab@gmail.com&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
