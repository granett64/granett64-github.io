   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Strickland Street Stroll&lt;/h3&gt;
    &lt;h4&gt;Old Cottage&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/1600c4e8-e348-4a9b-b415-a47db40ec638" target="_blank"&gt;https://labs.geocaching.com/goto/1600c4e8-e348-4a9b-b415-a47db40ec638&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 20m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;What is the current name of the cottage as listed on the plaque? (2 words)&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/4d5c514e-c023-4821-9bef-275040482069" /&gt;&lt;/p&gt;
    &lt;p&gt;This timber cottage was originally built by the Nockold Bros who came to Denmark in 1912 to establish a grocery store. The brothers were renowned for giving excellent service and during hard times they would extend credit to locals. 
The Nockolds were still resident in the 1960’s but thereafter it changed hands several times but amazingly remained virtually in original condition till approximately 2016 when the present owners completely renovated and extended the cottage. &lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a6cfb8bb-2945-4e49-a1df-48f93bf8983a" /&gt;&lt;/p&gt;
    &lt;p&gt;Denmark is a gorgeous coastal town located on Wilson Inlet in the Great Southern.
The Denmark River meanders through town and tall trees are a reminder of its past timber industry.
Take a relaxing saunter down the main street of town and learn a little more of our history.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-35.022983" lon="117.909167">
  <ele>8.0</ele>
  <time>2025-10-17T08:00:00Z</time>
  <name>LBNY0Q-2</name>
  <desc>EyreParkS2Entra</desc>
  <url>https://labs.geocaching.com/goto/fe56a042-435d-4f7f-aea6-909c4ed48dbb</url>
  <urlname>Eyre Park : S2 Entrance Sign by CrazyBear</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9653505" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Eyre Park : S2 Entrance Sign</groundspeak:name>
