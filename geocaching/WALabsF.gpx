  <name>LBa34Q-02</name>
  <desc>KununurraStars2</desc>
  <url>https://labs.geocaching.com/goto/3b29f6c4-2c3c-4184-801a-a11c5aa6b157</url>
  <urlname>Kununurra Stars : S2 From shark bait to the Olympics by olthomas</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99000057" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Kununurra Stars : S2 From shark bait to the Olympics</groundspeak:name>
   <groundspeak:placed_by>olthomas</groundspeak:placed_by>
   <groundspeak:owner id="">olthomas</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Kununurra Stars&lt;/h3&gt;&lt;h4&gt;From shark bait to the Olympics&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/3b29f6c4-2c3c-4184-801a-a11c5aa6b157"&gt;https://labs.geocaching.com/goto/3b29f6c4-2c3c-4184-801a-a11c5aa6b157&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is Sean's Classification on the plaque?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a076914f-0d79-45b0-b12e-09a5f93a39fe" /&gt;&lt;/p&gt;&lt;p&gt;Sean Pollard may not be the most famous Star in the park but I was working at RPH State MajorTrauma Unit when Sean was admitted after a shark removed both his hands (and more) during an attack off the coast of Esperance. He was a broken man. But Sean took his surfing and skateboarding skills to a new level when he represented Australia at the 2018 Paralympics in two snowboarding events ultimately coming 5th and 9th. He also has a bronze medal from the 2019 World Para Snowboard Championships in Finland.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/5f6ac709-80eb-4b23-b845-5a1a0c1931e8" /&gt;&lt;/p&gt;&lt;p&gt;It's time WA spread its AdLab wings and headed to the far north - here you will find a short pleasant wander around Kununurra's Celebrity Tree Park finding the famous folk who have planted trees.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/95d99b2e-82c2-4dc7-8335-97315840866b" /&gt;&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
