   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Golden Pipeline Trail: Ghooli &lt;/h3&gt;&lt;h4&gt;Bike Pump &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/707c666c-a724-4ee6-a2df-2550cc44b397"&gt;https://labs.geocaching.com/goto/707c666c-a724-4ee6-a2df-2550cc44b397&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;In what year(as written) were the men pictured part of the cycling club&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c97757d6-f7ea-4ad1-920c-cb188db53043" /&gt;&lt;/p&gt;&lt;p&gt;In the 1890's bicycles were a popular form of transport. Not needing food or water they were a more sensible choice than animals. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/69e3d017-c07f-4f84-8a3e-ae62ccb93bcb" /&gt;&lt;/p&gt;&lt;p&gt;Ghooli, Pump Station Number 6 on the Golden Pipeline Trail. 
Located 10km East of Southern Cross just off the main highway. 
A number of abandoned buildings here closed off to the public and containing asbestos so please follow the signage and warning signs. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
