   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;A Nutty Wander&lt;/h3&gt;
    &lt;h4&gt;Birds&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/b5965fce-4f7d-4630-a94f-71aff724ecf6" target="_blank"&gt;https://labs.geocaching.com/goto/b5965fce-4f7d-4630-a94f-71aff724ecf6&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 20m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    multiple choice
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;What sort of birds would you expect to find here at dusk?&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/ef9e2fde-15f3-4fff-9d5a-2c5748f460eb" /&gt;&lt;/p&gt;
    &lt;p&gt;I love walking through this forest at dusk when dozens of birds come home to roost for the night.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/b900aede-bd77-4645-9e96-7b6c207a7877" /&gt;&lt;/p&gt;
    &lt;p&gt;Take a wander through this beautiful part of Mundaring, enjoy the bush and maybe find a nutty cache or two along the way. (Remember to bring a pen with you!)
If you have time, you can continue your wander along a network of tracks.
If you&amp;#039;re lucky (and quietly patient), you might see and hear some local wildlife.
Enjoy!&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.906317" lon="116.1584">
  <ele>317.0</ele>
  <time>2026-05-24T08:00:00Z</time>
  <name>LBT22F-2</name>
  <desc>NuttyWanderS2Ju</desc>
  <url>https://labs.geocaching.com/goto/b5965fce-4f7d-4630-a94f-71aff724ecf6</url>
  <urlname>A Nutty Wander : S2 Junction by 15Moonbeams</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9746776" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>A Nutty Wander : S2 Junction</groundspeak:name>
   <groundspeak:placed_by>15Moonbeams</groundspeak:placed_by>
   <groundspeak:owner id="">15Moonbeams</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;A Nutty Wander&lt;/h3&gt;
    &lt;h4&gt;Junction &lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/b5965fce-4f7d-4630-a94f-71aff724ecf6" target="_blank"&gt;https://labs.geocaching.com/goto/b5965fce-4f7d-4630-a94f-71aff724ecf6&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 20m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    multiple choice
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;How many living trunks can you see at about 5 meters above the ground surrounding this dead tree?&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/6255b0c5-82b6-430c-8223-a07be5ad96f6" /&gt;&lt;/p&gt;
    &lt;p&gt;At the junction, on the fence side of the track, you will see a seemingly dead tree with a number of living trunks surrounding it. Shoots that grow around the very base of a tree or directly from the roots are often referred to as Basal Shoots or Lignotubers. The tree itself is not necessarily dead. Eucalypts are uniquely adapted to survive extreme stress (like fire, drought, or being cut down).&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/b900aede-bd77-4645-9e96-7b6c207a7877" /&gt;&lt;/p&gt;
    &lt;p&gt;Take a wander through this beautiful part of Mundaring, enjoy the bush and maybe find a nutty cache or two along the way. (Remember to bring a pen with you!)
If you have time, you can continue your wander along a network of tracks.
If you&amp;#039;re lucky (and quietly patient), you might see and hear some local wildlife.
Enjoy!&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
