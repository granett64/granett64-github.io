   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Horseyard Hill Trail &lt;/h3&gt;&lt;h4&gt;Horses of Walpole&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/2f5cf0f1-e9ab-40c3-b039-b34d6c9c4514"&gt;https://labs.geocaching.com/goto/2f5cf0f1-e9ab-40c3-b039-b34d6c9c4514&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the name of the Freebury horse? &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/f74279e4-3b10-48ce-bb67-02be88015432" /&gt;&lt;/p&gt;&lt;p&gt;Horseyard Hill was the name given to the area where horses were kept in the 1930s until they were passed on to the early settlers. Rewalked the trail recently and discovered my husband's family on the list. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a374ffc7-ce3e-4a95-9a01-c63f81f00edd" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to a hidden gem in Walpole. Located behind the visitor centre, Horseyard Hill is a 2.5 kilometre walk through beautiful bush. In Spring there is a variety of wildflowers to see and lots of birds to look out for. I suggest turning right at the end of the bridge to ensure downhill at the end :) Allow an hour. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.254217" lon="119.455983">
  <ele>413.0</ele>
  <time>2022-09-28T08:00:00Z</time>
