 <wpt lat="-33.252733" lon="115.839533">
  <ele>31.0</ele>
  <time>2022-05-07T08:00:00Z</time>
  <name>LBcM1w-05</name>
  <desc>OldRoadToBunbu5</desc>
  <url>https://labs.geocaching.com/goto/c8032bc6-fa86-4ce5-9234-a06129c1e8fc</url>
  <urlname>The (old) Road to Bunbury : S5 Brunswick Junction by Granett</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476909734" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>The (old) Road to Bunbury : S5 Brunswick Junction</groundspeak:name>
   <groundspeak:placed_by>Granett</groundspeak:placed_by>
   <groundspeak:owner id="">Granett</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;The (old) Road to Bunbury&lt;/h3&gt;&lt;h4&gt;Brunswick Junction&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/c8032bc6-fa86-4ce5-9234-a06129c1e8fc"&gt;https://labs.geocaching.com/goto/c8032bc6-fa86-4ce5-9234-a06129c1e8fc&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Where are you?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/fc7a905f-6a78-47cf-b867-2ad6bcb76a8f" /&gt;&lt;/p&gt;&lt;p&gt;Brunswick Junction is mainly known today for dairying, to which a large Friesian cow (nicknamed Daisy) stands testament in a park in the centre of town.

The town also hosts several historic buildings, including the shire hall, Catholic and Anglican churches and railway cottages, and the nearby Beela Valley has a scenic drive which takes in farming country east of the town as well as the Mornington forests.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/3de6cb8d-13fc-4aec-90e3-a2dd257ecc2d" /&gt;&lt;/p&gt;&lt;p&gt;Before the Forrest Hwy was opened in 2009 one of the main routes to Bunbury was along the South Western Hwy. The old road to Bunbury passes through several towns which this Adventure Lab will cause you to visit. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c411c0ce-28c9-40bf-955c-8b9bae17e06a" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Well done!&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
