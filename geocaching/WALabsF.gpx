  <url>https://labs.geocaching.com/goto/e247ea17-2884-4cd0-a895-5cb94449fa26</url>
  <urlname>WAQuokka AdLab Art #040 : S1 Dwellingup Railway History by dezzabills</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1880" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #040 : S1 Dwellingup Railway History</groundspeak:name>
   <groundspeak:placed_by>dezzabills</groundspeak:placed_by>
