  <urlname>[L] Melville Places 2 : S3 Heath Ledger Memorial by .tbh</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-619" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Melville Places 2 : S3 Heath Ledger Memorial</groundspeak:name>
   <groundspeak:placed_by>.tbh</groundspeak:placed_by>
   <groundspeak:owner id="">.tbh</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
