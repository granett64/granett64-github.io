 <wpt lat="-31.95925" lon="115.876383">
  <ele>6.0</ele>
  <time>2024-03-27T08:00:00Z</time>
  <name>LBpn88-02</name>
  <desc>AnExcursionAro2</desc>
  <url>https://labs.geocaching.com/goto/40268012-7f44-4352-96e2-ae97c70ea9c8</url>
  <urlname>An Excursion around Perth's Queens Gardens : S2 The Peter Pan Statue by Paskersfind</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476912227" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>An Excursion around Perth's Queens Gardens : S2 The Peter Pan Statue</groundspeak:name>
