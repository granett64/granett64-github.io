  <url>https://labs.geocaching.com/goto/798602c9-7976-4e1d-b1bf-89d262d721a4</url>
  <urlname>Harewood Forest Walk Trail : S2 Slow hard work by richlink</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918189" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Harewood Forest Walk Trail : S2 Slow hard work</groundspeak:name>
   <groundspeak:placed_by>richlink</groundspeak:placed_by>
   <groundspeak:owner id="">richlink</groundspeak:owner>
