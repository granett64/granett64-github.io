   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Bunbury Hidden Art &lt;/h3&gt;&lt;h4&gt;Your face is a mess&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/043949a8-b601-43a6-a32f-1ee304f3891b"&gt;https://labs.geocaching.com/goto/043949a8-b601-43a6-a32f-1ee304f3891b&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What male sang Rebel Rebel? Surname only &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/9186645b-5c70-4c0e-8cc4-fc61df4b0cba" /&gt;&lt;/p&gt;&lt;p&gt;A shortcut through an alley and more hidden artwork. Gemma O'Brien is the artist who created this mural. She is an internationally renowned designer and artist and her work has been commissioned by Apple, Nike, Tiffany &amp; Co, Google, and The New York Times.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/f09837e4-c26c-467b-ba85-94ea3e6f6d99" /&gt;&lt;/p&gt;&lt;p&gt;Down the alleyways and back streets of Bunbury you can find a wide range of murals by world renowned and local artists. This is only a small sample of the murals that dot the city.  So put on your walking shoes and get out or hire an e-scooter and enjoy your Adventure Lab. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/2ad9da1e-a868-4196-bc2f-4dc501d4108c" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Don't stop now :) &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
