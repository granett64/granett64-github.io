  <url>https://labs.geocaching.com/goto/d96b4b9c-0cc2-4033-8a39-641e7d60871b</url>
  <urlname>Merredin : S3 Pioneer Park by geotrakka</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-8" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Merredin : S3 Pioneer Park</groundspeak:name>
   <groundspeak:placed_by>geotrakka</groundspeak:placed_by>
   <groundspeak:owner id="">geotrakka</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Merredin&lt;/h3&gt;&lt;h4&gt;Pioneer Park&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/d96b4b9c-0cc2-4033-8a39-641e7d60871b"&gt;https://labs.geocaching.com/goto/d96b4b9c-0cc2-4033-8a39-641e7d60871b&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;The sculpture next to the horse is one of a man and what animal?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/64ef426e-8421-41a7-bdd7-706d66cd2964" /&gt;&lt;/p&gt;&lt;p&gt;These bronze sculptures honour the part played by the Clydesdale horses in opening up the Wheatbelt of Western Australia. It took some hard yakka to prepare the land in these areas. We pay tribute to not only the pioneers but also the animals used to achieve what we have today.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/3abdc620-6d7d-4535-914b-0d3179db3fb4" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to Merredin 'The Heart of The Wheatbelt'. Place of my birth and childhood memories. I hope you enjoy a small insight to the place I call home.

 The town’s name is derived from the Aboriginal word “merrit-in” the place of the merrit tree, a eucalypt used to make spears.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/60ddf1c5-e845-42dc-b6e7-f6ccf0c06725" /&gt;&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
