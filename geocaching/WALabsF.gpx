   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Wanneroo Heritage Artwork&lt;/h3&gt;
    &lt;h4&gt;Wanneroo Sam&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/cfb0219a-fee5-4492-a67c-d236997e6565" target="_blank"&gt;https://labs.geocaching.com/goto/cfb0219a-fee5-4492-a67c-d236997e6565&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 20m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;Looking at Sam to the left in the paving is a coloured tile. What is the word on the tile.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a4d1f40f-619f-4962-9531-95add34015f1" /&gt;&lt;/p&gt;
    &lt;p&gt;Samuele Danti (1922 - 2021), a local market gardener, posed for this life-size bronze. The artists created this to be a celebration of Wanneroo&amp;#039;s market gardeners and migrant population.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/02809708-7164-44e0-b816-533a7fae1177" /&gt;&lt;/p&gt;
    &lt;p&gt;A short tour of Artwork in the City of Wanneroo.  Share in some local history.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.751" lon="115.802533">
  <ele>51.0</ele>
  <time>2025-10-26T08:00:00Z</time>
