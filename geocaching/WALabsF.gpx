   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #036&lt;/h3&gt;&lt;h4&gt;Welcome Walls Stage 5&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/53c83958-e60d-4d16-ae9f-11404bf951c6"&gt;https://labs.geocaching.com/goto/53c83958-e60d-4d16-ae9f-11404bf951c6&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Charlotte Davis arrived on the Parmelia in 1829.  How did she get ashore?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/d88a029e-3ed3-44ee-a47b-10fad0c35584" /&gt;&lt;/p&gt;&lt;p&gt;There are many fascinating stories buried in the online search facility.  Try sorting by arrival year and see stories of some of Western Australia's first settlers.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/49172e36-4272-4049-9fd7-596fa5283260" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.

This AdLab explores the Welcome Walls which can be found outside the Western Australian Maritime Museum and on their website.



&lt;/p&gt;</groundspeak:long_description>
