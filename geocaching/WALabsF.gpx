   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #056&lt;/h3&gt;&lt;h4&gt;WA Science Hall of Fame &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/c6690439-3add-44b0-9671-2ee4ddfb87ed"&gt;https://labs.geocaching.com/goto/c6690439-3add-44b0-9671-2ee4ddfb87ed&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What year was Professor Carol Bower inducted into the Hall of Fame?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/9c8539b4-a259-4b7b-ade2-5b4d0e907ebd" /&gt;&lt;/p&gt;&lt;p&gt;Professor Carol Bower is an internationally recognised public health researcher. She has worked predominantly with the Telethon Kids Institute (previously the WA Institute for Child Health Research), of which she was a founding researcher and where she is currently Senior Principal Research Fellow, and Director of the Fetal Alcohol Spectrum Disorder (FASD) Research Australia – Centre for Research Excellence.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/d54eb30e-8c28-47f9-8fdd-df7f841ab9ea" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.

To join this project, please contact the project Admins on WAQuokkaAdLab@gmail.com
&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
