  <url>https://labs.geocaching.com/goto/becda599-1c24-4fb0-a674-0579489487b1</url>
  <urlname>Getting Around in Gidgegannup : S4 Gidgegannup Bakery by arnott.family</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476912249" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Getting Around in Gidgegannup : S4 Gidgegannup Bakery</groundspeak:name>
   <groundspeak:placed_by>arnott.family</groundspeak:placed_by>
   <groundspeak:owner id="">arnott.family</groundspeak:owner>
