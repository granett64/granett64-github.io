  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918927" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #014 : S2 Emergency Services - Fire Brigade</groundspeak:name>
