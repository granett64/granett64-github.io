   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Who Are The People In Your Neighborhood?&lt;/h3&gt;&lt;h4&gt;The Station Master&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/6dce6964-de36-492d-9cd1-8c6628373796"&gt;https://labs.geocaching.com/goto/6dce6964-de36-492d-9cd1-8c6628373796&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many chain links are on the Station Master's pocket watch?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/ff83248b-fe2c-4e89-ba52-ae972c7f870e" /&gt;&lt;/p&gt;&lt;p&gt;The station master is responsible for the management of other station employees and holds responsibility for safety and the efficient running of the station. The term was historically employed across stations of all sizes, leading to variation in the precise role.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a037284e-4393-41c6-8d6b-aee787df3fa1" /&gt;&lt;/p&gt;&lt;p&gt;On this adventure we will meet some interesting characters scattered around Midland.  The Midland Railway Workshops Sculptures commemorates those who have a connection with the Midland Railway Workshops.&lt;/p&gt;</groundspeak:long_description>
