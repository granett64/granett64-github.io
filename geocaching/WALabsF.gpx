  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918826" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #47 : S2 Home of the America’s Cup: The 1983 win!</groundspeak:name>
   <groundspeak:placed_by>m4yb</groundspeak:placed_by>
   <groundspeak:owner id="">m4yb</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
