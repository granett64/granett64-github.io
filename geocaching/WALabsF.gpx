   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Views from Victoria Gardens&lt;/h3&gt;&lt;h4&gt;Yoondoorup Boorna&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/9e9751cb-08fc-4aa6-a067-95ffb7755852"&gt;https://labs.geocaching.com/goto/9e9751cb-08fc-4aa6-a067-95ffb7755852&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many 'ducks' are there in the stump's title?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/2068810e-deda-4c59-a509-94a94a03e85f" /&gt;&lt;/p&gt;&lt;p&gt;Time to wander out to the point to where the Claisebrook Cove flows into the Swan River. This tree stump was once an old river gum that has been returned to this site at the request of the local Noongar people. More detailed information can be found on the nearby plaques.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/54f60d21-1384-489d-b0f3-125fb31b97b6" /&gt;&lt;/p&gt;&lt;p&gt;Now just might be a great time to visit beautiful Victoria Gardens in East Perth. Located on an elevated peninsula above Claisebrook Cove, these gardens were one of the earliest public parks in Perth and offer stunning views of the Swan River and its surrounds together with a variety of artworks that celebrate Indigenous history and the early culture of this area.  All five locations can be found within the immediate vicinity and can be done in any order as you stroll to  all corners of the park. 
&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a52f7107-e89e-4733-9ee8-e2d5abb6e951" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;A definite "view" point and another number to note!&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
