   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Gnarojin Park&lt;/h3&gt;&lt;h4&gt;the stone chimney metters stove&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/3ceca63a-26c5-46da-b133-8ce72c89dd30"&gt;https://labs.geocaching.com/goto/3ceca63a-26c5-46da-b133-8ce72c89dd30&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What year was the stove made?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/73808f86-6312-473a-8930-88c5db820baa" /&gt;&lt;/p&gt;&lt;p&gt;Newton family home, build in the early 1900's. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/ce526394-5db9-405a-b1f4-b5edb31147b3" /&gt;&lt;/p&gt;&lt;p&gt;Newton House Barbecue stands on the site of the original Newton family home, build in the early 1900's. It recreates the elements of a pioneer home - the stone chimney matters stove. water tank and kitchen table - representing comfort and shelter. surrounding the  house is an old fashioned country garden. 
&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/b7e277e4-10fe-40c4-b30f-27d2a318af43" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Congratulations on completing this stage. - well done.
Please check the bonus cache at GC9VXC4&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
