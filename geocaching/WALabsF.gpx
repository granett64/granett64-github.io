  <desc>ValleyOfTheGia1</desc>
  <url>https://labs.geocaching.com/goto/4fd4bfaa-5fba-4494-8c3c-c7e9053c07a1</url>
  <urlname>Valley of the Giants Ancient Empire Walk : S1 Red Tingle by allinaday</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476909965" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
