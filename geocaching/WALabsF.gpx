  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9708836" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Bayswater Street Art : S1 Take the Long Way Home</groundspeak:name>
   <groundspeak:placed_by>Guinness12</groundspeak:placed_by>
   <groundspeak:owner id="">Guinness12</groundspeak:owner>
