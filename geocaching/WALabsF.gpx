  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99002451" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Geocaching Muesum Adventure Lab : S1 Gallery 1: Traditional Cache</groundspeak:name>
