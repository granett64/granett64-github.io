  <urlname>WAQuokka AdLab Art #044 : S4 West Coast Blues ‘n’ Roots Festival 2012 by hunterzed</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918743" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
