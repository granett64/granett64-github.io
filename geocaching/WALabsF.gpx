  <groundspeak:cache id="9733323" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Welcome to Lancelin [1] : S4 War Artifact- The Propeller</groundspeak:name>
