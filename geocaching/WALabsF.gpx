 <wpt lat="-34.44765" lon="116.057283">
  <ele>213.0</ele>
  <time>2021-11-16T08:00:00Z</time>
  <name>LBCfmg-02</name>
  <desc>DiscoverPember2</desc>
  <url>https://labs.geocaching.com/goto/91b9475f-dbd0-439d-b7bd-883bc8bfa5a9</url>
  <urlname>Discover Pemberton : S2 Gloucester Tree by Leg5</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476910053" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Discover Pemberton : S2 Gloucester Tree</groundspeak:name>
   <groundspeak:placed_by>Leg5</groundspeak:placed_by>
