  <url>https://labs.geocaching.com/goto/317a7a01-6e9f-4977-a8bc-b2a84cc244c2</url>
  <urlname>WAQuokka AdLab Art #089 : S4 Noone wants to be called a ratbag..... by Dogwalk61</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1535" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #089 : S4 Noone wants to be called a ratbag.....</groundspeak:name>
   <groundspeak:placed_by>Dogwalk61</groundspeak:placed_by>
   <groundspeak:owner id="">Dogwalk61</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
