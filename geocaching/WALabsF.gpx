  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476910031" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Six Seasons : S5 Kambarang</groundspeak:name>
   <groundspeak:placed_by>Cirrus_WA</groundspeak:placed_by>
   <groundspeak:owner id="">Cirrus_WA</groundspeak:owner>
