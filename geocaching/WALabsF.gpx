  <desc>RockinghamMura3</desc>
  <url>https://labs.geocaching.com/goto/81a5109e-b9bb-46eb-abd6-34c8a0e01059</url>
  <urlname>Rockingham Mural Meander : S3 Rockingham Youth Centre - Land, Sea and US by Cirrus_WA</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476915783" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Rockingham Mural Meander : S3 Rockingham Youth Centre - Land, Sea and US</groundspeak:name>
   <groundspeak:placed_by>Cirrus_WA</groundspeak:placed_by>
   <groundspeak:owner id="">Cirrus_WA</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Rockingham Mural Meander&lt;/h3&gt;&lt;h4&gt;Rockingham Youth Centre - Land, Sea and US&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/81a5109e-b9bb-46eb-abd6-34c8a0e01059"&gt;https://labs.geocaching.com/goto/81a5109e-b9bb-46eb-abd6-34c8a0e01059&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Who was consulted to develop the concept for the mural? (4 words)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/9f257304-3d08-42a2-b3a8-465eb50d28a7" /&gt;&lt;/p&gt;&lt;p&gt;This mural represents the coast and land of the Rockingham area highlighting some of the great parts of the city.

The two figures represent young people in Rockingham, their hair flowing into the scenes representing their connection to the place and the land.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/365aa659-cb71-49bb-a2cb-42af0a723e82" /&gt;&lt;/p&gt;&lt;p&gt;Over the last few years the City of Rockingham has partnered with local and state based artists to create murals around the city.

This adventure will take you to some of these murals and talk about the stories of how they have been developed.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
