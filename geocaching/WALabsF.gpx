  <desc>NorthPerthHeri4</desc>
  <url>https://labs.geocaching.com/goto/b2844e9f-1136-4866-aacd-08282acd3d0e</url>
  <urlname>North Perth Heritage Buildings : S4 North Perth Town Hall (Lesser Hall) by familysteiner</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9705551" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
