   <groundspeak:name>Joondal-Up &amp; Down : S5 Nanika Park</groundspeak:name>
   <groundspeak:placed_by>atCatpacity</groundspeak:placed_by>
   <groundspeak:owner id="">atCatpacity</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
