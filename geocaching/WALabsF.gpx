   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #052&lt;/h3&gt;&lt;h4&gt;Isolated City&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/9415d44b-02bd-47cb-bc72-5d3510666b87"&gt;https://labs.geocaching.com/goto/9415d44b-02bd-47cb-bc72-5d3510666b87&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How far is Adelaide from Perth?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/b482b046-7006-476a-b2b6-2453bd971577" /&gt;&lt;/p&gt;&lt;p&gt;Did you know that if you were in Perth, you'd be nearer to Jakarta and Singapore then the national capital Canberra? In fact, Adelaide, the closest Australian city to Perth, is 2,200 kilometres away.
Perth is the most isolated city in the world because of its whopping distance from other major cities in the country. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/23d691a8-a479-4c3d-8128-a93d3a462fe7" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.

To join this project, please contact the project Admins on WAQuokkaAdLab@gmail.com
&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.05275" lon="115.739283">
  <ele>1.0</ele>
  <time>2025-06-01T08:00:00Z</time>
  <name>LBMZFM-05</name>
  <desc>WAQuokkaAdLa05F</desc>
  <url>https://labs.geocaching.com/goto/9415d44b-02bd-47cb-bc72-5d3510666b87</url>
  <urlname>WAQuokka AdLab Art #052 : S5 Fremantle Prison by MummaBear5</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1612" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #052 : S5 Fremantle Prison</groundspeak:name>
   <groundspeak:placed_by>MummaBear5</groundspeak:placed_by>
   <groundspeak:owner id="">MummaBear5</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #052&lt;/h3&gt;&lt;h4&gt;Fremantle Prison&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/9415d44b-02bd-47cb-bc72-5d3510666b87"&gt;https://labs.geocaching.com/goto/9415d44b-02bd-47cb-bc72-5d3510666b87&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What year did Fremantle Prison close?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/fae272e4-9c1c-4fc1-b021-4cc4c30ff8ac" /&gt;&lt;/p&gt;&lt;p&gt;The largest convict built building in WA, the Fremantle Prison, also referred to as Fremantle
Gaol or Fremantle Jail, closed in 1991, replaced by the new maximum-security Casuarina Prison. Nowadays you can do day - and night - tours to learn more about what life was like when you were incarcerated. It's pretty grim, but eye opening. In 2010, Fremantle Prison became the first building in Western Australia to be included on the World Heritage list.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/23d691a8-a479-4c3d-8128-a93d3a462fe7" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.

To join this project, please contact the project Admins on WAQuokkaAdLab@gmail.com
&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
