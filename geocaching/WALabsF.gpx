   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Thornlie Line (Transperth)&lt;/h3&gt;&lt;h4&gt;Oats Street Station&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/f1cda1c9-0338-41a6-b26a-89e488331950"&gt;https://labs.geocaching.com/goto/f1cda1c9-0338-41a6-b26a-89e488331950&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many bus routes serve Oats Street Station?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/29fe5499-cb19-46ea-9e5b-1990aae10133" /&gt;&lt;/p&gt;&lt;p&gt;Oats Street station opened in 1954. It serves both the Armadale and Thornlie Lines. The station has 2 side platforms rather than a single island platform. It is one of the few stations on the line to have Train-Bus Transfer. To answer this question go to the bus stands and count how many routes stop at the Station.(Including Rail Replacement Routes)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/1090b8f2-0079-422e-a018-f7649d4ef074" /&gt;&lt;/p&gt;&lt;p&gt;The Thornlie Line is one of the many Train Lines that are in Perth. It is my favourite line and I think Trains in Perth are really interesting. There are many facts about this line so I thought it would be a good idea to showcase them to others in the form of an Adventure Lab. Hope you enjoy! (Please note that during the Whole Line shutdown that lasts from Late 2023 to 2025 this Adventure Lab will not be available)&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
