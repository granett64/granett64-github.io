   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokkaAdLab Art #053&lt;/h3&gt;&lt;h4&gt;The Giant Ram&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/188a86ff-0595-4ab0-a35e-7fd2965f1150"&gt;https://labs.geocaching.com/goto/188a86ff-0595-4ab0-a35e-7fd2965f1150&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What colour is Bart the Giant Ram?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/b384faca-9f65-4d6a-9ac2-b945746f8c9b" /&gt;&lt;/p&gt;&lt;p&gt;The town of Wagin is known for its prospering wool and sheep industry. Bart is one of the towns major attractions. Standing at more than 9m tall, this white sheep is a sight.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a15b7fa4-c68f-4263-9af9-a3839e3f49fd" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.

To join this project, please contact the project Admins on WAQuokkaAdLab@gmail.com
&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
