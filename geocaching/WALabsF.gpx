  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476915756" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Nullarbor Plain ~ Travel Trivia : S2 Theme: S.O.S.</groundspeak:name>
   <groundspeak:placed_by>Ms Maddy</groundspeak:placed_by>
