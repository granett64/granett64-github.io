   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Queens Gardens - Bunbury&lt;/h3&gt;&lt;h4&gt;Tree Sculpture&lt;/h4&gt;&lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;linear&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/f1df46da-0366-45cc-935d-4a609ac42a61"&gt;https://labs.geocaching.com/goto/f1df46da-0366-45cc-935d-4a609ac42a61&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many children, in total, did TORRISI Giuseppe and CASTRO Giuseppina have?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/70dafde7-0a35-4c61-bc0e-9b00386e1054" /&gt;&lt;/p&gt;&lt;p&gt;Make you way to the Migrant Pioneers plaque on the eastern side of the Tree Sculpture to get the answer for the following question.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/5becdec8-45f5-4778-b6c3-3d4822800f7c" /&gt;&lt;/p&gt;&lt;p&gt;We stumbled across this neat location while geocaching in Bunbury. We thought it was an ideal place for an Adventure Lab cache. Have fun!&lt;/p&gt;</groundspeak:long_description>
