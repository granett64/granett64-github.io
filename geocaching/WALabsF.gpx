   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Swarbrick Wander &lt;/h3&gt;&lt;h4&gt;Reflection &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/930cdbde-8d95-45a5-b26f-b66ac0295e80"&gt;https://labs.geocaching.com/goto/930cdbde-8d95-45a5-b26f-b66ac0295e80&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What year was the Walpole Wilderness opened?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c168718c-0fa0-450c-b8b9-35c3eb4bbf6c" /&gt;&lt;/p&gt;&lt;p&gt;The mirrored wall tells a story of the area. Full of interesting titbits from locals and protestors along with a timeline of the area. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/1879aeaf-cd93-481d-927c-e415d1cb8813" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to Swarbrick part of the Walpole Wilderness. Enjoy your walk through the bush and admire the amazing mirrored wall. This area was logged in the late 90s and there was wide spread protesting at the logging of native trees that included Yellow Tingle, a tree only found in a 50k radius of Walpole. Now we are lucky to have a beautiful, peaceful walk where you can see wildflowers and listen to the birds. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
