   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Coogee Community Garden&lt;/h3&gt;&lt;h4&gt;Succulents ideal for hot climates&lt;/h4&gt;&lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;linear&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/80b6c2b4-9f3b-4c6f-ae7b-07fa2d63caec"&gt;https://labs.geocaching.com/goto/80b6c2b4-9f3b-4c6f-ae7b-07fa2d63caec&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Across 2 down 3&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/fe47b51e-90d3-47db-b962-2022ea06b171" /&gt;&lt;/p&gt;&lt;p&gt;Time flies like an arrow. Fruit flies like a banana.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/1992c335-02f5-41c7-b94b-2580c957cb37" /&gt;&lt;/p&gt;&lt;p&gt;Established in 2018, the Coogee Community Garden WA group aims to establish and maintain a community garden in Coogee which is accessible to public.

The garden will promote the art of organic gardening where possible and also have an area dedicated to the history of the indigenous bush tucker and local market gardener families.

How the game is played
all lab points will be avalible to unlock in one location, thats how you get your questions, 
your answers are on one of the five signs, your only hint is the Lab Spot's title.

good luck.

Bonus Cache is at: S 32° 6.???' E 115° 46.???'&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.04725" lon="115.952333">
  <ele>15.0</ele>
  <time>2023-02-26T08:00:00Z</time>
  <name>LBvNMk-01</name>
  <desc>ThornlieLineTr1</desc>
  <url>https://labs.geocaching.com/goto/f1cda1c9-0338-41a6-b26a-89e488331950</url>
  <urlname>Thornlie Line (Transperth) : S1 Thornlie Station by Seabiscuit7</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476910125" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Thornlie Line (Transperth) : S1 Thornlie Station</groundspeak:name>
   <groundspeak:placed_by>Seabiscuit7</groundspeak:placed_by>
   <groundspeak:owner id="">Seabiscuit7</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Thornlie Line (Transperth)&lt;/h3&gt;&lt;h4&gt;Thornlie Station&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/f1cda1c9-0338-41a6-b26a-89e488331950"&gt;https://labs.geocaching.com/goto/f1cda1c9-0338-41a6-b26a-89e488331950&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many Platforms are at this Station? (use numbers)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/8d6af99e-aea8-46fb-97e0-58978a520d0e" /&gt;&lt;/p&gt;&lt;p&gt;Thornlie Station opened in 2005 and is now the terminus of the Thronlie line, the line branches off the Armadale Line after Beckenham Station. To answer this question you can either enter the station or your can peek a peak from the outside.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/1090b8f2-0079-422e-a018-f7649d4ef074" /&gt;&lt;/p&gt;&lt;p&gt;The Thornlie Line is one of the many Train Lines that are in Perth. It is my favourite line and I think Trains in Perth are really interesting. There are many facts about this line so I thought it would be a good idea to showcase them to others in the form of an Adventure Lab. Hope you enjoy! (Please note that during the Whole Line shutdown that lasts from Late 2023 to 2025 this Adventure Lab will not be available)&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.013667" lon="115.94525">
  <ele>12.0</ele>
  <time>2023-02-26T08:00:00Z</time>
  <name>LBvNMk-02</name>
  <desc>ThornlieLineTr2</desc>
  <url>https://labs.geocaching.com/goto/f1cda1c9-0338-41a6-b26a-89e488331950</url>
  <urlname>Thornlie Line (Transperth) : S2 Cannington Station by Seabiscuit7</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476910127" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Thornlie Line (Transperth) : S2 Cannington Station</groundspeak:name>
   <groundspeak:placed_by>Seabiscuit7</groundspeak:placed_by>
   <groundspeak:owner id="">Seabiscuit7</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Thornlie Line (Transperth)&lt;/h3&gt;&lt;h4&gt;Cannington Station&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/f1cda1c9-0338-41a6-b26a-89e488331950"&gt;https://labs.geocaching.com/goto/f1cda1c9-0338-41a6-b26a-89e488331950&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What Stopping Pattern does the Thornlie Line use? (one letter, says on the front of the train)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/d375acde-d098-402c-9271-68bbc9bc6fb9" /&gt;&lt;/p&gt;&lt;p&gt;Cannington Station was built in 1890 and has since been rebuilt in the 1990's as part of the electrification of all the Transperth Rail Lines. The station is served by both Thornlie Line and Armadale Line Trains. The stations is set to be rebuilt in late 2023 as part of the Victoria Park-Canning Level Crossing Removal Program. To answer this question look at the letter on the Thornlie trains Dot Matrix display.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/1090b8f2-0079-422e-a018-f7649d4ef074" /&gt;&lt;/p&gt;&lt;p&gt;The Thornlie Line is one of the many Train Lines that are in Perth. It is my favourite line and I think Trains in Perth are really interesting. There are many facts about this line so I thought it would be a good idea to showcase them to others in the form of an Adventure Lab. Hope you enjoy! (Please note that during the Whole Line shutdown that lasts from Late 2023 to 2025 this Adventure Lab will not be available)&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
