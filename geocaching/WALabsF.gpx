  <url>https://labs.geocaching.com/goto/3555431c-ef2c-44c1-b28b-ef59611a44fe</url>
  <urlname>History of International Geocaching Day : S1 Where it all began! by crabzy11</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9761625" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>History of International Geocaching Day : S1 Where it all began!</groundspeak:name>
   <groundspeak:placed_by>crabzy11</groundspeak:placed_by>
   <groundspeak:owner id="">crabzy11</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
