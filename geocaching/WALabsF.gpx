  <name>LB4CCM4</name>
  <desc>MandurahWarMem4</desc>
  <url>https://labs.geocaching.com/goto/5976675f-4c37-4e93-8716-a38ecfb1993f</url>
  <urlname>Mandurah War Memorial  : S4 The Avenue of Trees by Boyzrule5</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99002434" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Mandurah War Memorial  : S4 The Avenue of Trees</groundspeak:name>
   <groundspeak:placed_by>Boyzrule5</groundspeak:placed_by>
   <groundspeak:owner id="">Boyzrule5</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Mandurah War Memorial &lt;/h3&gt;&lt;h4&gt;The Avenue of Trees&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/5976675f-4c37-4e93-8716-a38ecfb1993f"&gt;https://labs.geocaching.com/goto/5976675f-4c37-4e93-8716-a38ecfb1993f&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Radius: 20m&lt;/p&gt;&lt;p&gt;Stages: 5&lt;/p&gt;&lt;p&gt;Kind of question: single&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the surname of servicemen 3639 and 1845?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/8639d452-4e48-4c40-be3b-f2cce114c051" /&gt;&lt;/p&gt;&lt;p&gt;The memorial is surrounded by a grove of New Zealand Christmas trees. When the red blossoms shed by the trees carpet the ground, this is a powerful reminder of the sacrifice of war. The memorial also features rows of rosemary which grows wild in the hills of Gallipoli. Plantings of olive trees symbolise peace. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/6852750b-7733-4bb6-b95d-6bbcd1362033" /&gt;&lt;/p&gt;&lt;p&gt;This adventure lab is based at the latest War Memorial. The first was located on the western bank of the estuary, opposite the town on Mary Street and Old Coast Road. In 1997 major road works impacted the site. The original structure was removed and remodelled and installed at the City of Mandurah RSL sun-branch on the corner of ANZAC Place and Third Avenue Mandurah. 

Ref: https://www.mandurah.wa.gov.au/explore/arts-and-culture/war-memorial&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.532483" lon="115.714033">
  <ele>6.0</ele>
  <time>2025-09-26T08:00:00Z</time>
