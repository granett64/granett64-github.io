  <urlname>Harvey Bound  : S3 Little Obelia by Paskersfind</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918249" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Harvey Bound  : S3 Little Obelia</groundspeak:name>
   <groundspeak:placed_by>Paskersfind</groundspeak:placed_by>
   <groundspeak:owner id="">Paskersfind</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Harvey Bound &lt;/h3&gt;&lt;h4&gt;Little Obelia &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/ff613d83-102d-451d-8e50-d7fa9244d075"&gt;https://labs.geocaching.com/goto/ff613d83-102d-451d-8e50-d7fa9244d075&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What object is Little Obelia holding in her right hand?  A ...&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/39166b41-a18f-4d63-983a-fe5860e278c0" /&gt;&lt;/p&gt;&lt;p&gt;A short distance further along the river walk path should bring you to a sign with the delightful image of Little Obelia. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/9a1def16-8732-4dfa-9551-a162fcc60280" /&gt;&lt;/p&gt;&lt;p&gt; Welcome to James Stirling Place in beautiful Harvey, WA. The standout feature of this location- Stirling Cottage- is a replica 1850's timber cottage that has been home to WA's First Governor, Sir James Stirling, as well as many pioneering families including that of 'Snugglepot and Cuddlepie' creator, May Gibbs.
This adventure lab takes you on a leisurely stroll along the river walk pathway surrounding the immaculate Heritage Gardens of the cottage and introduces (or reacquaints) you with some of the wonderful, quirky characters May Gibbs created in her award-winning children's stories.
We hope you have fun and perhaps take some time to visit the abundance of other attractions in and around this delightful township.

&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
