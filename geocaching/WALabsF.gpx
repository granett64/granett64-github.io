  <url>https://labs.geocaching.com/goto/c6d33f30-ef20-4ab2-a2a4-549a74392710</url>
  <urlname>Robinson Reserve 2 : S5 Cricket Nets by AndrewB1973</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9673608" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Robinson Reserve 2 : S5 Cricket Nets</groundspeak:name>
   <groundspeak:placed_by>AndrewB1973</groundspeak:placed_by>
   <groundspeak:owner id="">AndrewB1973</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
