  <desc>McDougallFarmS2</desc>
  <url>https://labs.geocaching.com/goto/bb29d142-a49a-463a-896d-3395f3e86a30</url>
  <urlname>McDougall Farm : S2 South Perth Society of Arts and Crafts by Barnzy12</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9671351" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
