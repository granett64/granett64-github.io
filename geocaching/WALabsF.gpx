  <url>https://labs.geocaching.com/goto/90591efc-8a80-4354-8a75-4903bcf3db15</url>
  <urlname>Whistler Walk 1 : S5 Snottygobble by Chwiliwr</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-465" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Whistler Walk 1 : S5 Snottygobble</groundspeak:name>
   <groundspeak:placed_by>Chwiliwr</groundspeak:placed_by>
   <groundspeak:owner id="">Chwiliwr</groundspeak:owner>
