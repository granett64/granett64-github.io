   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #47&lt;/h3&gt;&lt;h4&gt;Home of the America’s Cup:  The 1983 Challenge&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/bb9dbc7c-c98c-43e5-a443-a6510b14c8ae"&gt;https://labs.geocaching.com/goto/bb9dbc7c-c98c-43e5-a443-a6510b14c8ae&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Who designed Australia II’s winged keel?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/deab8a4a-881d-42bc-b63a-6727cc6ebf17" /&gt;&lt;/p&gt;&lt;p&gt;The America’s Cup was a 12- metre class yacht racing series.  By 1983, this cup had been held by US teams for 132 years.
A challenge was launched by an Australian syndicate with the Royal Perth Yacht Club’s Australia II, unique because of its  controversial “winged keel” design.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/3915f6f9-65e0-430f-b3f0-26a63d0ce971" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WA Quokka AdLab Art series which intends to form a giant quokka off the coast of Perth.
There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.052817" lon="115.738883">
