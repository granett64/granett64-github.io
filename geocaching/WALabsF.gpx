   <groundspeak:long_description html="True">&lt;h3&gt;Soldiers Park &lt;/h3&gt;&lt;h4&gt;War memorial&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/eacd1c78-e556-472b-909d-4d6bad14f35f"&gt;https://labs.geocaching.com/goto/eacd1c78-e556-472b-909d-4d6bad14f35f&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Above “World War 2 1939-1945  is what 3 words?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/cb26395e-0ed9-45b1-904b-a288c241d893" /&gt;&lt;/p&gt;&lt;p&gt;The war memorial was made in memory of the men of Collie district who gave their lives in the cause of freedom. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/93066906-e0b1-4635-9dc2-add4c376eca5" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to Soldiers Park in Collie. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a7a4f32e-93b3-40d0-ac37-17cb8ed1f510" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Congratulations&lt;/p&gt;</groundspeak:long_description>
