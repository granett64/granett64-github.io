  <urlname>WAQuokka AdLab Art #061 : S3 WA's bird emblem by ullyssia</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1485" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #061 : S3 WA's bird emblem</groundspeak:name>
   <groundspeak:placed_by>ullyssia</groundspeak:placed_by>
   <groundspeak:owner id="">ullyssia</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
