  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918957" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab #110 : S4 Dragon Boat Racing - commands</groundspeak:name>
   <groundspeak:placed_by>Boyzrule5</groundspeak:placed_by>
   <groundspeak:owner id="">Boyzrule5</groundspeak:owner>
