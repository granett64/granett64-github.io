  <url>https://labs.geocaching.com/goto/d918570b-3b7b-4a91-bc60-95620a86add5</url>
  <urlname>WAQuokka AdLab Art #027 : S5 Weird Place Names - Disaster Bay by chickenhawk07</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918794" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #027 : S5 Weird Place Names - Disaster Bay</groundspeak:name>
   <groundspeak:placed_by>chickenhawk07</groundspeak:placed_by>
   <groundspeak:owner id="">chickenhawk07</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
