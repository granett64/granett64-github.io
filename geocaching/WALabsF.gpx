  <url>https://labs.geocaching.com/goto/39744493-7cb2-44ef-abc1-64bad5ff520c</url>
  <urlname>Ellenbrook Line: The Unity of Life : S5 Ellenbrook Station by Lachlan1.77</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918311" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Ellenbrook Line: The Unity of Life : S5 Ellenbrook Station</groundspeak:name>
   <groundspeak:placed_by>Lachlan1.77</groundspeak:placed_by>
   <groundspeak:owner id="">Lachlan1.77</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Ellenbrook Line: The Unity of Life&lt;/h3&gt;&lt;h4&gt;Ellenbrook Station&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/39744493-7cb2-44ef-abc1-64bad5ff520c"&gt;https://labs.geocaching.com/goto/39744493-7cb2-44ef-abc1-64bad5ff520c&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;The skylights at this station represent what (in Noongar)?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c4303ad6-1c25-4f99-aa4a-75cc6cfdf68c" /&gt;&lt;/p&gt;&lt;p&gt;Locate the plaque and answer the question. The plaque for Ellenbrook Station is located inside the station building.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/2c0024d4-3a76-4482-a7f4-efb44f8fb9e1" /&gt;&lt;/p&gt;&lt;p&gt;The skylights across the Ellenbrook train line form a suite of artworks dedicated to revealing the interrelationships of all living things across these areas. Marcia McGuire explored the Noongar social and ecological interdependence for Ellenbrook and Ballajura, while Penelope Forlano focused on the ecological interdependence of the flora and fauna for Whiteman Park, Morley and Noranda.

A bonus final cache will be placed for this lab (GCB14B3). The bonus final will be placed after the opening day due to the high volume of visitors on the opening day.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.964067" lon="115.837167">
