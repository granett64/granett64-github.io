  <desc>NGNMMRSS5Narrog</desc>
  <url>https://labs.geocaching.com/goto/aa155a58-7237-492e-a955-664960fb5b19</url>
  <urlname>NGN MMRS : S5 Narrogin Croissants by Cirrus_WA</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476909774" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>NGN MMRS : S5 Narrogin Croissants</groundspeak:name>
   <groundspeak:placed_by>Cirrus_WA</groundspeak:placed_by>
   <groundspeak:owner id="">Cirrus_WA</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
