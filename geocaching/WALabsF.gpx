   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Lets get Arty&lt;/h3&gt;&lt;h4&gt;Magpies are cool&lt;/h4&gt;&lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;linear&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/Arty"&gt;https://labs.geocaching.com/goto/Arty&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many fish are in this mural.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c90c0694-28a0-4346-99cf-3f722c125b8b" /&gt;&lt;/p&gt;&lt;p&gt;This mural is painted on the side wall of Coles at Busselton Central. It was painted by Ian Mutch he has painted more murals around Busselton including one at the old Busselton drive in and recently has painted a mural on the roof of his house. This mural was painted in March 2020. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/ebbf7a33-3277-4aa9-8ee0-d02b2d0335bd" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to Busselton learn about our town thru murals , the past and the present.
Cover mural by Sam Allen&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;Award Message:&lt;br /&gt;Congratulations you have completed this Adventure Lab i hope you enjoyed the walk and seen and learnt some info about Busselton&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
