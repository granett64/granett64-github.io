  <urlname>WAQuokka AdLab Art #007 : S4 Stage 4 - Lake Cave by JKJK20</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1316" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
