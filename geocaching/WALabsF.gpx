   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Collie Coalfields &lt;/h3&gt;&lt;h4&gt;Memorial Coal Arch&lt;/h4&gt;&lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;linear&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/df4ac768-35d9-4196-94c6-b0e3207b593e"&gt;https://labs.geocaching.com/goto/df4ac768-35d9-4196-94c6-b0e3207b593e&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What year was the Coal arch located to this location?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/4e70880a-27a3-4a45-8fe2-abdf223f1f1f" /&gt;&lt;/p&gt;&lt;p&gt;he arch was relocated from Western No.1 underground mine entrance and we were told is the only surviving example of a mine entrance from the Collie Coalfields. There is a replica coal skip adjacent, this was erected in 1994 in recognition of the miners who worked the underground pits from 1890 to their closure in 1994. There are two plaques, commemorating the relocation, affixed to the arch. A Memorial Wall stands nearby, this lists names of all miners killed on the Collie coalfields.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/7d7caf73-45ae-4d05-a666-7b934f22c356" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the Collie coalfields explore through some of the history of the Collie Coalfields.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;Award Message:&lt;br /&gt;Venture into the dark where the sun never shines, its hard work in these mines.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
