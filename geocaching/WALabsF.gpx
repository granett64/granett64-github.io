   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Murals of Mount Barker&lt;/h3&gt;&lt;h4&gt;Bella Kelly&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/e30528ba-ef5d-4d95-8618-ecf7a587acae"&gt;https://labs.geocaching.com/goto/e30528ba-ef5d-4d95-8618-ecf7a587acae&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many pens/pencils are in the brush holder? (word)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/0a511538-4d6f-4cb7-8ed8-0dd1c44b3239" /&gt;&lt;/p&gt;&lt;p&gt;Born in Mount Barker in 1915, Bella Kelly painted landscapes of the Great Southern.
She had an innate talent and was self taught. The majority of her paintings have the Stirling Ranges in the background.
Bella painted until she died in 1994.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c99cdff7-04ff-4c99-8b0b-981410b6464b" /&gt;&lt;/p&gt;&lt;p&gt;The locations of the murals have been placed to bring tourists into town by creating an exploration trail through the heart of town.
The murals were painted by visiting international artists during the 2019 Mountains and Murals Festival.
Remember to take note of your answers because you will need them to log a find on the bonus cache!
Enjoy your walk through town.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
