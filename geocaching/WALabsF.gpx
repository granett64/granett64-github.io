  <name>LBasRC-05</name>
  <desc>WAQuokkaAdLa097</desc>
  <url>https://labs.geocaching.com/goto/034e1012-bfa7-4062-9365-3fc82b458a4b</url>
  <urlname>WAQuokka AdLab Art #023 : S5 Prison Tunnels by monkeywand</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918986" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
