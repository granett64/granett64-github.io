   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Maple's Walk&lt;/h3&gt;&lt;h4&gt;Dee Road&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/f34171cf-80f2-484a-afd5-71db4eb087de"&gt;https://labs.geocaching.com/goto/f34171cf-80f2-484a-afd5-71db4eb087de&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;In what year was the sculpture made? (4 digits)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/da9add68-2141-4b8d-b4ad-4bcd9fd1378e" /&gt;&lt;/p&gt;&lt;p&gt;Tony Jones is a Western Australian artist whose career spans more than five decades and includes 20 solo exhibitions, over 100 group exhibitions and more than 60 public art commissions. His paintings, drawings and sculptures feature the key motifs of boat hulls and sail shapes, flags and human figures and represent humanity and its fates.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/91040966-eae1-45e2-8532-35a4d323f68d" /&gt;&lt;/p&gt;&lt;p&gt;This is a quick five stage mosaic and sculpture Adventure lab cache around  Deep Water Point. 
Deep Water Point is a beautiful spot at the Canning River. The area is particular good for some  "Duck43 hunting" &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
