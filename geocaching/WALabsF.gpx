   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Coogee Capers&lt;/h3&gt;&lt;h4&gt;Woodman Point Regional Park&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/a29728dc-def1-43df-8aeb-c8f306a0fd32"&gt;https://labs.geocaching.com/goto/a29728dc-def1-43df-8aeb-c8f306a0fd32&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What particular construction has restricted public access and helped to protect this natural environment?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/750715ca-d31e-45aa-9629-5d6414e48229" /&gt;&lt;/p&gt;&lt;p&gt;Woodman Point is an important regional park in Perth. Natural vegetation in the park has increasingly high conservation value and provides a area conserving vegetation along Perth’s Southern Coast line.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/fcadfa12-a873-4c41-a962-0a7361395bb0" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to Woodman Point a area rich in history with hidden treasures waiting to be found. The MICKS crew have enjoyed exploring this area and would like to share some interesting areas with you through this Adventure Lab.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
