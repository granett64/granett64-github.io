  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99002512" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] "Its All About The Kids" Murder Mystery Adventure! : S2 Clue 2</groundspeak:name>
   <groundspeak:placed_by>BJA3</groundspeak:placed_by>
