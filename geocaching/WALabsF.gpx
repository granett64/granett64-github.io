 <wpt lat="-32.052183" lon="115.738633">
  <ele>1.0</ele>
  <time>2025-05-29T08:00:00Z</time>
  <name>LBN7LR-05</name>
  <desc>WAQuokkaAdLa06B</desc>
  <url>https://labs.geocaching.com/goto/88b248a6-b78b-4089-b480-73b188d92210</url>
