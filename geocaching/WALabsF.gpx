  <ele>3.0</ele>
  <time>2025-06-04T08:00:00Z</time>
  <name>LBCKth-05</name>
  <desc>WAQuokkaAdLa10r</desc>
  <url>https://labs.geocaching.com/goto/b4a08bbc-4bd8-4504-a994-ab3f3be58f00</url>
