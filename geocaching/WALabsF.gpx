  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9746237" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Brookton Memorial Park : S4 National Service</groundspeak:name>
   <groundspeak:placed_by>Barnzy12</groundspeak:placed_by>
   <groundspeak:owner id="">Barnzy12</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Brookton Memorial Park&lt;/h3&gt;
    &lt;h4&gt;National Service&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/dd8f7a47-9001-4058-9e3e-e99af7a03f2d" target="_blank"&gt;https://labs.geocaching.com/goto/dd8f7a47-9001-4058-9e3e-e99af7a03f2d&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 20m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;How many servicemen were conscripted?&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/30e3a856-ebbd-43e0-b959-4bcb3227401b" /&gt;&lt;/p&gt;
    &lt;p&gt;THIS MEMORIAL IS DEDICATED TO
THE 325,811 NATIONAL SERVICEMEN WHO WERE CONSCRIPTED INTO THE AUSTRALIAN DEFENCE FORCE BETWEEN THE YEARS 1951 - 1972
- DURING THIS TIME THERE WERE TWO DISTINCT CALLUR PENOUSE
WHICH SAW MORE THAN 200 YOUNG AUSTRALIANS PAY THE SUPREME SACRIFICE WITH A FURTHER 1479 BEING WOUNDED IN SERVICE&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/08de605a-24c7-4e5c-8ad4-6548492c339b" /&gt;&lt;/p&gt;
    &lt;p&gt;On the 11 November 1921, the War Memorial in Brookton was unveiled after 12 months of fundraising by the RSL. After a united service was held by the various religious bodies, the unveiling service commenced.
&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
