  <urlname>Wanneroo Heritage Artwork : S5 Original Wanneroo Townsite Southern Boundary by FelixII</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9663608" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Wanneroo Heritage Artwork : S5 Original Wanneroo Townsite Southern Boundary</groundspeak:name>
   <groundspeak:placed_by>FelixII</groundspeak:placed_by>
   <groundspeak:owner id="">FelixII</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Wanneroo Heritage Artwork&lt;/h3&gt;
    &lt;h4&gt;Original Wanneroo Townsite Southern Boundary&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/cfb0219a-fee5-4492-a67c-d236997e6565" target="_blank"&gt;https://labs.geocaching.com/goto/cfb0219a-fee5-4492-a67c-d236997e6565&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 20m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;On the power pole there are 4 metal plates all with a common word ending in &amp;#039;e&amp;#039;. What is the word&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a98ca76a-21af-4915-b4c7-d902c1ced276" /&gt;&lt;/p&gt;
    &lt;p&gt;The southern boundary of the original Wanneroo townsite was the 16-mile peg of Wanneroo Road, which marked the edge of the established settlement in 1907. This boundary served as a reference point, with properties along the road using the closest mile peg for addresses until the late 1970s&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/02809708-7164-44e0-b816-533a7fae1177" /&gt;&lt;/p&gt;
    &lt;p&gt;A short tour of Artwork in the City of Wanneroo.  Share in some local history.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.750267" lon="115.805017">
  <ele>54.0</ele>
