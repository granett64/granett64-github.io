  <url>https://labs.geocaching.com/goto/df16e1e5-f12f-47bd-9a04-42e64fc0542f</url>
  <urlname>Katanning Art Trail  : S2 Woolworths Carpark by I C Nothing</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9769964" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Katanning Art Trail  : S2 Woolworths Carpark</groundspeak:name>
   <groundspeak:placed_by>I C Nothing</groundspeak:placed_by>
   <groundspeak:owner id="">I C Nothing</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
