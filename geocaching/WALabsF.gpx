  <url>https://labs.geocaching.com/goto/9a6fc962-495b-4d16-9ec8-3642121f9a11</url>
  <urlname>Fiona Stanley 2 : S1 The boat garden by .K.B.</urlname>
  <sym>Geocache</sym>
