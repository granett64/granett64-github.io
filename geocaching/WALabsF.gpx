 <wpt lat="-30.29225" lon="115.0413">
  <ele>5.0</ele>
  <time>2023-08-16T08:00:00Z</time>
  <name>LBezAb-03</name>
  <desc>JurienWalkTrai3</desc>
  <url>https://labs.geocaching.com/goto/16b2ea94-4a50-4460-8379-be7b8550b2ab</url>
  <urlname>Jurien walk trail : S3 Native Wisteria by yeatesy89</urlname>
