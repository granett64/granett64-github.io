  <url>https://labs.geocaching.com/goto/aec90b74-e1b2-4b94-8c52-d34f4524922c</url>
  <urlname>Kalamunda ARTWALK : S4 Community Art Mural by fratra</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476915766" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Kalamunda ARTWALK : S4 Community Art Mural</groundspeak:name>
   <groundspeak:placed_by>fratra</groundspeak:placed_by>
   <groundspeak:owner id="">fratra</groundspeak:owner>
