  <urlname>[L] Melville Places 2 : S5 Fragment by .tbh</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-621" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Melville Places 2 : S5 Fragment</groundspeak:name>
