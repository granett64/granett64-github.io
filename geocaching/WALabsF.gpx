  <url>https://labs.geocaching.com/goto/d96b4b9c-0cc2-4033-8a39-641e7d60871b</url>
  <urlname>Merredin : S5 Cummins Theatre by geotrakka</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-10" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Merredin : S5 Cummins Theatre</groundspeak:name>
