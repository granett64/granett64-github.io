   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Timed Stops on the 915&lt;/h3&gt;&lt;h4&gt;Bull Creek&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/1e7df1ce-a3b2-4306-bf9a-eaebd772501a"&gt;https://labs.geocaching.com/goto/1e7df1ce-a3b2-4306-bf9a-eaebd772501a&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What stand does 915 depart from? Numbers only&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/5272332e-234a-4813-ba96-95e45e415a3e" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to Bull Creek, where you may find yourself starting this adventure or finishing. You can find yourself transferring on to the Mandurah here. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/54f60cc4-75cd-4e8c-a61e-455f23fb6068" /&gt;&lt;/p&gt;&lt;p&gt;Timed stops on the 915. An introduction to the Perth’s high frequency routes. The reason for creating this ad-lab  is to admire how wonderful it is to have a high frequency route run along here, beautiful communities along the way from Bull Creek to Fremantle. Its road design with bike lanes is pretty cool with a small median in the middle. Great!&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
