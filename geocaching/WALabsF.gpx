   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Lets not Forget&lt;/h3&gt;&lt;h4&gt;Memorial pillar &lt;/h4&gt;&lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;linear&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/Notforget"&gt;https://labs.geocaching.com/goto/Notforget&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;General sir Wm Birdwood Bart unveiled this memorial in what year&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/f213e6a6-45a8-4976-8e5b-33aa12ba682e" /&gt;&lt;/p&gt;&lt;p&gt;This location is a place of  remberance every anzac day when we rember the fallen  and the returned servicemen and women &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/9465ec12-45bd-49d8-b0a1-78eab4aa0fcb" /&gt;&lt;/p&gt;&lt;p&gt;My adventure is unique because it gives you time to reflect and give thanks for what we have today because of the sacrifice of our ancestors. This adventure will have you wandering thru cemetaries,a memorial and a cemotaph. Please be respectful of your surrounding.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;Award Message:&lt;br /&gt;Congratulation move on to step next step&lt;/p&gt;</groundspeak:long_description>
