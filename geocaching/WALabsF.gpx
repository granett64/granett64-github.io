  <desc>JACKADDERJAUNT3</desc>
  <url>https://labs.geocaching.com/goto/402a8d7e-5eb2-40a5-98fc-77fb06b7e28a</url>
  <urlname>JACKADDER JAUNT : S3 SHELTER by m4yb</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-629" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>JACKADDER JAUNT : S3 SHELTER</groundspeak:name>
   <groundspeak:placed_by>m4yb</groundspeak:placed_by>
   <groundspeak:owner id="">m4yb</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;JACKADDER JAUNT&lt;/h3&gt;&lt;h4&gt;SHELTER&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/402a8d7e-5eb2-40a5-98fc-77fb06b7e28a"&gt;https://labs.geocaching.com/goto/402a8d7e-5eb2-40a5-98fc-77fb06b7e28a&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the name of the artist who painted the bird mural, 2 words?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/f24e4363-1c43-45d8-8038-3b9f204ed559" /&gt;&lt;/p&gt;&lt;p&gt;In this area are shaded play areas, picnic shelters and toilet facilities.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c4b40a2d-81ff-431a-8882-99df68628e7d" /&gt;&lt;/p&gt;&lt;p&gt;Jackadder Lake is one of a chain of lakes on the northern Coastal Plain, of which Lake Monger and Herdsman Lake are part. Called Jackadup by the traditional indigenous owners, it was a source of food like tubers, frogs, tortoises and birds.
The first European settlers used the land and water for market gardens and in the 1900’s, a dairy industry.
It is now a popular suburban feature with paths, playgrounds, picnic areas, as well as the home of the Perth Radio Sailing Club with its elaborate model watercraft.
The path around the lake is 1.2 kms and a pleasant walk or run with children and or dog/s..&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
