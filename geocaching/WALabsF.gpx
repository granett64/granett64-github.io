 <wpt lat="-32.161067" lon="115.851567">
  <ele>28.0</ele>
  <time>2025-03-08T08:00:00Z</time>
  <name>LBMtAa-05</name>
  <desc>LTourAroundHam5</desc>
  <url>https://labs.geocaching.com/goto/e73e93e8-5e63-4fed-8d34-9cbda095582e</url>
  <urlname>[L] Tour around Hammond Park  : S5 Christmas Tree Park by I C Nothing</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918617" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Tour around Hammond Park  : S5 Christmas Tree Park</groundspeak:name>
   <groundspeak:placed_by>I C Nothing</groundspeak:placed_by>
   <groundspeak:owner id="">I C Nothing</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Tour around Hammond Park &lt;/h3&gt;&lt;h4&gt;Christmas Tree Park &lt;/h4&gt;&lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;linear&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/e73e93e8-5e63-4fed-8d34-9cbda095582e"&gt;https://labs.geocaching.com/goto/e73e93e8-5e63-4fed-8d34-9cbda095582e&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many fountains are located in the lake?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/df9a4d85-3f90-431a-93b9-7e7de56952a1" /&gt;&lt;/p&gt;&lt;p&gt;Christmas Tree Park is a park many of the local kids love to come to with their bikes.
Enjoying the water, tree cover and the chance to hide amongst the bush.

Remember at this location you will need to remember the answer to the question to assist you finding the Bonus Cache.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/6eda61e1-446d-4714-aa48-63cddc7e93d1" /&gt;&lt;/p&gt;&lt;p&gt;I C Nothing kids love nothing more than jumping on their bikes to explore and play at the local playgrounds. This is their lab to provide you a tour around their local hang out spots.&lt;/p&gt;</groundspeak:long_description>
