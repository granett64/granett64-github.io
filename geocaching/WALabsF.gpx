 <wpt lat="-32.051067" lon="115.740383">
  <ele>3.0</ele>
  <time>2025-06-12T08:00:00Z</time>
  <name>LBZmpT-01</name>
  <desc>WAQuokkaAdLa154</desc>
  <url>https://labs.geocaching.com/goto/12cba197-dfa2-433c-830e-b841ce0ffc13</url>
  <urlname>WAQuokka AdLab Art #101 : S1 The Nullarbor Plain by MummaBear5</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918978" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #101 : S1 The Nullarbor Plain</groundspeak:name>
   <groundspeak:placed_by>MummaBear5</groundspeak:placed_by>
   <groundspeak:owner id="">MummaBear5</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #101&lt;/h3&gt;&lt;h4&gt;The Nullarbor Plain &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/12cba197-dfa2-433c-830e-b841ce0ffc13"&gt;https://labs.geocaching.com/goto/12cba197-dfa2-433c-830e-b841ce0ffc13&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many plant species are found on the Nullarbor?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/9b7e3f4e-1d95-4d20-8423-235d0a3bd83e" /&gt;&lt;/p&gt;&lt;p&gt;Flat, arid, and almost treeless, the Nullarbor Plain is the planet's largest single exposure of limestone bedrock, spanning millions of hectares across the state, and connecting Western Australia with the east. The vast stretch is home to over 390 plant species and serves as a habitat for rare wildlife, including hairy- nosed wombats, Australian sea lions, and pale knob- tailed geckos.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/667dc5c3-5fa9-4675-a5d4-44ea6f7788f4" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.

To join this project, please contact the project Admins on WAQuokkaAdLab@gmail.com
&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.05105" lon="115.7404">
  <ele>3.0</ele>
  <time>2025-06-12T08:00:00Z</time>
  <name>LBZmpT-02</name>
  <desc>WAQuokkaAdLa155</desc>
  <url>https://labs.geocaching.com/goto/12cba197-dfa2-433c-830e-b841ce0ffc13</url>
  <urlname>WAQuokka AdLab Art #101 : S2 Pink Lakes by MummaBear5</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918980" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #101 : S2 Pink Lakes</groundspeak:name>
   <groundspeak:placed_by>MummaBear5</groundspeak:placed_by>
   <groundspeak:owner id="">MummaBear5</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #101&lt;/h3&gt;&lt;h4&gt;Pink Lakes&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/12cba197-dfa2-433c-830e-b841ce0ffc13"&gt;https://labs.geocaching.com/goto/12cba197-dfa2-433c-830e-b841ce0ffc13&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What mixes with the salts to make the pink colour?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/e1a8282e-09fe-4775-9e08-c1b165aed905" /&gt;&lt;/p&gt;&lt;p&gt;Located on the edge of Middle Island, off the Esperance coast, Lake Hillier stands out due to its vibrant pink hue. The water gets its color from the algae that mix with the salts. A narrow strip of fine white sand and a thick cluster of eucalyptus trees, paperbarks, and vegetation surround the lake. Lake Hillier is only accessible by boat or helicopter.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/667dc5c3-5fa9-4675-a5d4-44ea6f7788f4" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.

To join this project, please contact the project Admins on WAQuokkaAdLab@gmail.com
&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.051083" lon="115.7404">
  <ele>3.0</ele>
  <time>2025-06-12T08:00:00Z</time>
  <name>LBZmpT-03</name>
  <desc>WAQuokkaAdLa156</desc>
  <url>https://labs.geocaching.com/goto/12cba197-dfa2-433c-830e-b841ce0ffc13</url>
  <urlname>WAQuokka AdLab Art #101 : S3 World's Happiest Animal, the Quokka by MummaBear5</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
