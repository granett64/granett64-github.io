   <groundspeak:owner id="">Leg5</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Kings Park - Fraser Ave&lt;/h3&gt;&lt;h4&gt;Bali Memorial&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/5863f379-5bdb-42ee-b18b-906281c33058"&gt;https://labs.geocaching.com/goto/5863f379-5bdb-42ee-b18b-906281c33058&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the last word on the Bali Memorial Plaque which has a map on it?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/8734c8c3-f0af-430f-adca-353b74d38a70" /&gt;&lt;/p&gt;&lt;p&gt;On 12 October 2002 terrorism claimed the lives of 202 people on Bali, 88 Australians and 16 were from Western Australia.

The memorial is a place to remember the lost, comfort the issues and honour those courageous who assisted in the time of need.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/e1fa713b-0775-4ace-ad00-6eff90846441" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to King Park, Fraser Ave has a few lesser known monuments and statues of WA’s history.
Ready for the 20 year Memorial of the Bali Bombing in Kuta.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
