   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;History of International Geocaching Day&lt;/h3&gt;
    &lt;h4&gt;Where it all began (2)&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/3555431c-ef2c-44c1-b28b-ef59611a44fe" target="_blank"&gt;https://labs.geocaching.com/goto/3555431c-ef2c-44c1-b28b-ef59611a44fe&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 500m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    multiple choice
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;Where was the first IGD event held?&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/9775ab0d-5f41-44a6-b374-5e1421dfacd3" /&gt;&lt;/p&gt;
    &lt;p&gt;International Geocaching Day began in 2011 to honor the global geocaching community and encourage new players to join the adventure. Created by Geocaching HQ, the event was launched to spotlight the growing popularity of this outdoor activity that blends technology, exploration, and fun.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a040d62c-f1d1-49ee-9fb3-c7916fbeac94" /&gt;&lt;/p&gt;
    &lt;p&gt;2026 marks the 15th Anniversary of the first IGD event held all the way back on August 20th 2011.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
