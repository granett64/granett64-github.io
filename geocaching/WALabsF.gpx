  <urlname>WAQuokka AdLab Art #048 : S1 Kings Park Botanic Garden by fraad112</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1697" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
