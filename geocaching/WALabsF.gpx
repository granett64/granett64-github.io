  <desc>LLakeGoollelal3</desc>
  <url>https://labs.geocaching.com/goto/c88315b5-6eb2-4338-ae09-624913d00fe4</url>
  <urlname>[L] Lake Goollelal Boardwalk : S3 End Seat by iluvtrekking</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9663612" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Lake Goollelal Boardwalk : S3 End Seat</groundspeak:name>
   <groundspeak:placed_by>iluvtrekking</groundspeak:placed_by>
   <groundspeak:owner id="">iluvtrekking</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Lake Goollelal Boardwalk&lt;/h3&gt;
    &lt;h4&gt;End Seat&lt;/h4&gt;

    &lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;
        linear
    &lt;/span&gt;&lt;/p&gt;

&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/c88315b5-6eb2-4338-ae09-624913d00fe4" target="_blank"&gt;https://labs.geocaching.com/goto/c88315b5-6eb2-4338-ae09-624913d00fe4&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 25m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;How many frogs on this bench seat?&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/e6bcb7ad-79e1-40c9-b13e-f1e39a66d1a9" /&gt;&lt;/p&gt;
    &lt;p&gt;The first day we visited the boardwalk, the lake water was lapping over the edge of the platform. It will be interesting to see the changes in water level over the seasons.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/6d2a9f01-7fc0-40a6-a0f2-ed8e44a54042" /&gt;&lt;/p&gt;
    &lt;p&gt;The Goollelal Boardwalk is a new 380-meter walkway featuring two viewing platforms that extend over Lake Goollelal in Yellagonga Regional Park. Now complete, the boardwalk is part of the Yellagonga Regional Park Improvement Project and offers improved accessibility to the lake&amp;#039;s biodiversity and historic sites, including the former Luisini Winery. The area is also undergoing development with new amenities, including a café and playground, to enhance nature-based tourism and community engagement. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
