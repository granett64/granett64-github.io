   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;John Oldham Park&lt;/h3&gt;&lt;h4&gt;Caring for the Bird Life&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/3b67a8de-59e9-4f20-b075-5c3509df2952"&gt;https://labs.geocaching.com/goto/3b67a8de-59e9-4f20-b075-5c3509df2952&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;The illustrations on this sign were done by Pamela who?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c7581409-571c-446c-b8de-e7c6c35d7923" /&gt;&lt;/p&gt;&lt;p&gt;It is important for birds to feed from their natural environment. Feeding the birds is detrimental to both the lake ecosystem and the birds heath; potentially leading to malnutrition, sickness and imbalanced populations of some species.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a1dd3cce-a333-4b3c-97fc-1bbab4db19c8" /&gt;&lt;/p&gt;&lt;p&gt;This park was constructed when the Narrows Bridge was constructed over the Swan River in the 1950's. The park was designed between the interchanges and the Swan River, and would act as "green lungs", breathing life and oxygen into what would otherwise be an inhospitable traffic environment. This park was to be covered in exotic plants with a series of lakes and small waterfalls.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
