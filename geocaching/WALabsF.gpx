   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Kununurra Stars&lt;/h3&gt;&lt;h4&gt;He brought the Hollywood Stars to Kununurra&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/3b29f6c4-2c3c-4184-801a-a11c5aa6b157"&gt;https://labs.geocaching.com/goto/3b29f6c4-2c3c-4184-801a-a11c5aa6b157&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What month did Baz plant his tree?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a101739f-f1ae-4737-bb8e-c1dcd9226069" /&gt;&lt;/p&gt;&lt;p&gt;Baz Luhrmann (whose name is spelt incorrectly on his plaque) is an Australian director, writer, and producer who brought the Hollywood lights to Kununurra to film the 2008 movie Australia. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/5f6ac709-80eb-4b23-b845-5a1a0c1931e8" /&gt;&lt;/p&gt;&lt;p&gt;It's time WA spread its AdLab wings and headed to the far north - here you will find a short pleasant wander around Kununurra's Celebrity Tree Park finding the famous folk who have planted trees.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/1866ae07-72b4-4ac2-a13f-8a2778fad245" /&gt;&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
