  <urlname>Mandurah’s Western Foreshore : S4 Meeting Place by hunterzed</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-898" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Mandurah’s Western Foreshore : S4 Meeting Place</groundspeak:name>
   <groundspeak:placed_by>hunterzed</groundspeak:placed_by>
