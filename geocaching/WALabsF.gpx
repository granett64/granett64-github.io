   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Views from Victoria Gardens&lt;/h3&gt;&lt;h4&gt;Illa Kuri  (Sacred Dreaming Path)&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/9e9751cb-08fc-4aa6-a067-95ffb7755852"&gt;https://labs.geocaching.com/goto/9e9751cb-08fc-4aa6-a067-95ffb7755852&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many large granite rocks stand as "silent sentries"?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/89c60838-f17f-4875-bff2-341a8ae7a7e4" /&gt;&lt;/p&gt;&lt;p&gt;This sacred path represents the Illa Kuri journey of young Noongar initiates through the Claisebrook Valley.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/54f60d21-1384-489d-b0f3-125fb31b97b6" /&gt;&lt;/p&gt;&lt;p&gt;Now just might be a great time to visit beautiful Victoria Gardens in East Perth. Located on an elevated peninsula above Claisebrook Cove, these gardens were one of the earliest public parks in Perth and offer stunning views of the Swan River and its surrounds together with a variety of artworks that celebrate Indigenous history and the early culture of this area.  All five locations can be found within the immediate vicinity and can be done in any order as you stroll to  all corners of the park. 
&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/8aa3dcfd-0bd1-4c07-aa25-d2fb104ad149" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;More amazing views. Enjoy and keep counting!&lt;/p&gt;</groundspeak:long_description>
