   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Wrights Lake - Champion Lakes&lt;/h3&gt;&lt;h4&gt;Champion Lakes - Park Run&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/eb2ff215-10c1-45a4-844c-021ee15d8cd2"&gt;https://labs.geocaching.com/goto/eb2ff215-10c1-45a4-844c-021ee15d8cd2&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the number on the electrical cabinet?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/d05e65a5-fa05-4b9e-b7d0-f436b6147176" /&gt;&lt;/p&gt;&lt;p&gt;A free, fun and friendly, weekly community event. Walk, jog, run, volunteer or spectate… it’s up to you. The course around the lake is a full 5kms on good, even paths. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/97f243f0-989c-4a11-8524-4e2ef5d8f03a" /&gt;&lt;/p&gt;&lt;p&gt;Wrights Lake in Kelmscott was named for an early settler Charles Wright, who received the land grant in the 1830’s. The lake was originally a natural drainage line and timber reserve.
The lake and it’s surrounding parkland were developed into an aquatic facility with an international rowing course, with the master plan endorsed in 2000 and completed after the Tonkin Highway extension in 2005. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
