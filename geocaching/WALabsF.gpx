 <wpt lat="-30.91395" lon="118.207283">
  <ele>313.0</ele>
  <time>2022-12-15T08:00:00Z</time>
  <name>LB94vP-05</name>
  <desc>LRunAMuckInM950</desc>
  <url>https://labs.geocaching.com/goto/bb5134e3-b76c-4d8a-95f3-42a968d73c14</url>
  <urlname>[L] Run a muck in Muka! : S5 1950’s working farm shed by PollyMichele</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99008936" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Run a muck in Muka! : S5 1950’s working farm shed</groundspeak:name>
   <groundspeak:placed_by>PollyMichele</groundspeak:placed_by>
   <groundspeak:owner id="">PollyMichele</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Run a muck in Muka!&lt;/h3&gt;&lt;h4&gt;1950’s working farm shed&lt;/h4&gt;&lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;linear&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/bb5134e3-b76c-4d8a-95f3-42a968d73c14"&gt;https://labs.geocaching.com/goto/bb5134e3-b76c-4d8a-95f3-42a968d73c14&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many flowers are there?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/f291e9e8-9fc5-4682-b8f3-2d102aa428a9" /&gt;&lt;/p&gt;&lt;p&gt;Normally most towns have a mens shed, but Mukinbudin believes everyone should have a place to come together and create or just have a chat. It is situated in the middle of town where a passionate community group work to retain their heritage. Restored machinery is on display and this is located close to the unique heritage grain silo which is an amazing engineering feat from times gone by.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/50f80758-536c-4460-99bd-c4815feb252f" /&gt;&lt;/p&gt;&lt;p&gt;Mukinbudin is three and a half hours drive from Perth in the Wheatbelt region of Western Australia. The district is famous for its wheat and sheep farming. 
The town was gazetted in 1922 and has many interesting historical and natural features. Not too mention the hidden talent of many locals of which I plan to take you to see some of their work on this adventure. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-30.91285" lon="118.207067">
  <ele>312.0</ele>
  <time>2022-12-15T08:00:00Z</time>
  <name>LB94vP-04</name>
  <desc>LRunAMuckInMuk4</desc>
  <url>https://labs.geocaching.com/goto/bb5134e3-b76c-4d8a-95f3-42a968d73c14</url>
  <urlname>[L] Run a muck in Muka! : S4 Stockyards by PollyMichele</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99008934" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Run a muck in Muka! : S4 Stockyards</groundspeak:name>
