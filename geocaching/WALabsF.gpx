   <groundspeak:owner id="">J2V</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WA Sports Venues&lt;/h3&gt;&lt;h4&gt;Perth HPC&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/cf865ebe-2e5a-448a-bb62-82715ec2a2cc"&gt;https://labs.geocaching.com/goto/cf865ebe-2e5a-448a-bb62-82715ec2a2cc&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the five-letter word on the short limestone wall?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/58bb57b0-3ce4-4b5c-9e7f-eede2dc35ebd" /&gt;&lt;/p&gt;&lt;p&gt;This complex first opened in 1986 and was first called Perth Superdrome. It has since been named Challenge Stadium, HBF Stadium and now Perth High Performance Centre. As well as catering for elite sport, many clubs call the venue home for swimming, triathlon, diving, water polo, gymnastics and other sports.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/6c9238ae-200c-4c14-9bb3-3be0e4166fb6" /&gt;&lt;/p&gt;&lt;p&gt;This adventure takes you around some of the State sports venues in Mt Claremont. The five stops are at Bendat Basketball Centre, WA Athletics Stadium, Perth High Performance Centre, WA Institute of Sport and an unusual memorial in the bush. 

You can drive between the locations or take a walk. For an added challenge, find the path through the bush that links the basketball centre to the oval (and the WAIS building). After completing the adventure there is a bonus traditional geocache to fine nearby.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.950233" lon="115.782883">
