  <url>https://labs.geocaching.com/goto/780515ab-6fd5-4222-84e5-1bac01822f3f</url>
  <urlname>Augusta Amble : S5 The Landing Place by fratra</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918654" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Augusta Amble : S5 The Landing Place</groundspeak:name>
   <groundspeak:placed_by>fratra</groundspeak:placed_by>
   <groundspeak:owner id="">fratra</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
