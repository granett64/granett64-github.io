  <url>https://labs.geocaching.com/goto/f246ece8-a9c4-4171-8d45-47b8898daa23</url>
  <urlname>Watering holes in Guildford : S1 Stirling Arms Hotel by Puzzzzler</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99002427" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
