  <name>LBCKth-04</name>
  <desc>WAQuokkaAdLa10N</desc>
  <url>https://labs.geocaching.com/goto/b4a08bbc-4bd8-4504-a994-ab3f3be58f00</url>
  <urlname>WAQuokka AdLab Art #100 : S4 North West Ore Trains by WayneO</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918881" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #100 : S4 North West Ore Trains</groundspeak:name>
   <groundspeak:placed_by>WayneO</groundspeak:placed_by>
   <groundspeak:owner id="">WayneO</groundspeak:owner>
