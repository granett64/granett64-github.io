   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #048&lt;/h3&gt;&lt;h4&gt;Kings Park Botanic Garden&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/24c0957c-9ecd-48a6-b80f-b330e29477b9"&gt;https://labs.geocaching.com/goto/24c0957c-9ecd-48a6-b80f-b330e29477b9&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Which Western Australian plant is the floral emblem of WA?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/8582bea7-3195-482e-85e7-23a4d8bad86e" /&gt;&lt;/p&gt;&lt;p&gt;Kings Park is one of the world’s largest inner-city parks and a treasure trove of Western Australian flora. The Botanic Garden showcases over 3,000 species of native plants, many of which are found nowhere else on Earth. It’s a perfect place to see the famous red and green Kangaroo Paw — WA’s floral emblem — along with stunning wildflowers in spring&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/57699da9-98a1-4550-9272-4ffbf1c50c94" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.


To join this project, please contact the project Admins on WAQuokkaAdLab@gmail.com

This AdLab celebrates fascinating features of plant biodiversity. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.052917" lon="115.73895">
