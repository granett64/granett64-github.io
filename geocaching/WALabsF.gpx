  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-518" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>The (old) Road to Bunbury : S2 Waroona</groundspeak:name>
   <groundspeak:placed_by>Granett</groundspeak:placed_by>
   <groundspeak:owner id="">Granett</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
