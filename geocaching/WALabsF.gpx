  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1423" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #102 : S1 Stage One - Fremantle Arts Centre</groundspeak:name>
   <groundspeak:placed_by>JKJK20</groundspeak:placed_by>
   <groundspeak:owner id="">JKJK20</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
