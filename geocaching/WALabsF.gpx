  <desc>BunburyHiddenA4</desc>
  <url>https://labs.geocaching.com/goto/043949a8-b601-43a6-a32f-1ee304f3891b</url>
  <urlname>Bunbury Hidden Art  : S4 At the Wharf by Rach2</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99003637" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Bunbury Hidden Art  : S4 At the Wharf</groundspeak:name>
   <groundspeak:placed_by>Rach2</groundspeak:placed_by>
   <groundspeak:owner id="">Rach2</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Bunbury Hidden Art &lt;/h3&gt;&lt;h4&gt;At the Wharf&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/043949a8-b601-43a6-a32f-1ee304f3891b"&gt;https://labs.geocaching.com/goto/043949a8-b601-43a6-a32f-1ee304f3891b&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the surname of the artist who painted this mural? It's on the wall ? 6000&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/5f5fe369-e2cf-40cb-a99a-bbbbfb7c165a" /&gt;&lt;/p&gt;&lt;p&gt;This mural covers two walls. So make sure you walk around the corner. It was painted by  Jerome Davenport, a WA artist know internationally by a different name. You'll find that answer on the wall. You don't need the numbers. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/f09837e4-c26c-467b-ba85-94ea3e6f6d99" /&gt;&lt;/p&gt;&lt;p&gt;Down the alleyways and back streets of Bunbury you can find a wide range of murals by world renowned and local artists. This is only a small sample of the murals that dot the city.  So put on your walking shoes and get out or hire an e-scooter and enjoy your Adventure Lab. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a23d5f02-fcf5-4852-83f4-44dc7e5229ed" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Well done &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
