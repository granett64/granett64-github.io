   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #031&lt;/h3&gt;&lt;h4&gt;AFL&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/dbbc9230-bf2c-4782-af53-db53fbfa9d2c"&gt;https://labs.geocaching.com/goto/dbbc9230-bf2c-4782-af53-db53fbfa9d2c&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;The name of the Fremantle AFL team is the ?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/91ac7190-28d3-4177-bfc3-0c8a55c4fb88" /&gt;&lt;/p&gt;&lt;p&gt;Fremantle Harbour is Western Australia's largest and busiest general cargo port and an important historical site. The inner harbour handles a large volume of sea containers, vehicle imports and livestock exports, cruise shipping and naval visits, and operates 24 hours a day.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/0a2bfcaf-b7ec-4e96-befd-9f7ded3d2cda" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka
off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs
to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry
Terminal.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
