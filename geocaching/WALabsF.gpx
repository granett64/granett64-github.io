   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Helena and Aurora Ranges&lt;/h3&gt;&lt;h4&gt;The T Junction&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/f7059ba0-3bf4-4259-ad7e-350219e24bdf"&gt;https://labs.geocaching.com/goto/f7059ba0-3bf4-4259-ad7e-350219e24bdf&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What name is on the bottom board? &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/98fd4b73-7295-40a8-8292-f88e54c9e7fc" /&gt;&lt;/p&gt;&lt;p&gt;Here you will decide whether to head East towards the base of the Peak which you can continue by foot or West around past the campsite and the other way to the Peak via 4WD. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/b5bcddd4-446f-4e3c-823f-b801633c5b4b" /&gt;&lt;/p&gt;&lt;p&gt;Sazpazza love coming out to the gorgeous Helena Aurora Range (Bungalbin). It is remote enough to get some peace and quiet yet close enough to Perth for a few days away. The region is the largest, highest and steepest banded ironstone formation in Western Australia. No higher land form can be seen in a 400km radius, making the Helena Aurora Range sight not to be missed when travelling through southern WA.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
