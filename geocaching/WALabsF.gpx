  <desc>FremantleLineT5</desc>
  <url>https://labs.geocaching.com/goto/2dd70f6e-870c-43ef-acc6-582fe8369255</url>
  <urlname>Fremantle Line (Transperth) : S5 West Leederville Station by Seabiscuit7</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-960" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Fremantle Line (Transperth) : S5 West Leederville Station</groundspeak:name>
   <groundspeak:placed_by>Seabiscuit7</groundspeak:placed_by>
   <groundspeak:owner id="">Seabiscuit7</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Fremantle Line (Transperth)&lt;/h3&gt;&lt;h4&gt;West Leederville Station &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/2dd70f6e-870c-43ef-acc6-582fe8369255"&gt;https://labs.geocaching.com/goto/2dd70f6e-870c-43ef-acc6-582fe8369255&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What was the name of the Stadium that once sat near this Station?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/e6139899-487a-4669-b39b-571431e3f298" /&gt;&lt;/p&gt;&lt;p&gt;West Leederville railway station is on the Transperth network in Western Australia. It is located on the Fremantle line and Airport line, 2.7 kilometres from Perth station on the boundary between West Leederville and Subiaco. It was the main station for the former Subiaco Oval containing a special event platform no longer in use.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/9167c011-5506-4743-8851-7bc3196b5250" /&gt;&lt;/p&gt;&lt;p&gt;The Fremantle Line is one of Perth's suburban rail lines running from Perth Station to Fremantle Station. The Line originally opened on the 1st March 1881 and since then it has undergone major changes like the electrification of the line which took place in the early 1990's. It is now one of Perth's busiest rail lines carrying around 5 million passengers per year. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
