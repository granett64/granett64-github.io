  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9697066" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>BYOM 10 AdLab Art #09 : S3 Australian Native Animals - Platypus</groundspeak:name>
