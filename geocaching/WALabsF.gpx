  <urlname>WAQuokka AdLab Art #021 : S2 The Triffids by megawat60</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918856" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #021 : S2 The Triffids</groundspeak:name>
   <groundspeak:placed_by>megawat60</groundspeak:placed_by>
   <groundspeak:owner id="">megawat60</groundspeak:owner>
