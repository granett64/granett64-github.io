  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9705550" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>North Perth Heritage Buildings : S3 Church of Saint Nikola</groundspeak:name>
   <groundspeak:placed_by>familysteiner</groundspeak:placed_by>
   <groundspeak:owner id="">familysteiner</groundspeak:owner>
