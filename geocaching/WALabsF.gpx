 <wpt lat="-34.238467" lon="116.148917">
  <ele>282.0</ele>
  <time>2025-07-10T08:00:00Z</time>
  <name>LBgpuR-01</name>
  <desc>ManjimupHerita1</desc>
  <url>https://labs.geocaching.com/goto/00042f75-d1bf-4c38-a081-da6d225f4169</url>
  <urlname>Manjimup Heritage Connections : S1 The Butter Factory by orrsom</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-2124" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Manjimup Heritage Connections : S1 The Butter Factory</groundspeak:name>
   <groundspeak:placed_by>orrsom</groundspeak:placed_by>
   <groundspeak:owner id="">orrsom</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Manjimup Heritage Connections&lt;/h3&gt;&lt;h4&gt;The Butter Factory&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/00042f75-d1bf-4c38-a081-da6d225f4169"&gt;https://labs.geocaching.com/goto/00042f75-d1bf-4c38-a081-da6d225f4169&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many palm trees stand in front of you and what year where they planted? (Number,Year)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/d87c382d-0f80-446f-a6d7-09087727bb0a" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to a sculpture about the butter factory which use to stand in front you where the woolworths complex is today. The palm trees you can see are also the original trees planted by the Walter Palmer in 1929. Feel free to read the plaque in front of you as it has an interesting history to tell.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/46bfd7ba-b6f3-47a8-a735-eb6d4917f93b" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the sleepy town of Manjimup in WA's lower south west. Manjimup has a rich history of thriving industries that can still be seen today. These include the apple orchards of the that surround the town, the butter factory that brought industrialisation to the farmers of the community, the trails that the farmers drove there cattle on there seasonal grazing patterns, the cream truck which connected Walpole to the Manjimup area and lastly one very important figure in the history of Northcliffe 'Doc' Ryan who served for 43 years bringing much needed medical expertise to the region. This adlab aims to take you to all these important sites and learn a little about the history of the Shire.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-34.241783" lon="116.14755">
  <ele>281.0</ele>
  <time>2025-07-10T08:00:00Z</time>
  <name>LBgpuR-02</name>
  <desc>ManjimupHerita2</desc>
  <url>https://labs.geocaching.com/goto/00042f75-d1bf-4c38-a081-da6d225f4169</url>
  <urlname>Manjimup Heritage Connections : S2 The Apple Picker by orrsom</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-2125" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Manjimup Heritage Connections : S2 The Apple Picker</groundspeak:name>
   <groundspeak:placed_by>orrsom</groundspeak:placed_by>
   <groundspeak:owner id="">orrsom</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Manjimup Heritage Connections&lt;/h3&gt;&lt;h4&gt;The Apple Picker &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/00042f75-d1bf-4c38-a081-da6d225f4169"&gt;https://labs.geocaching.com/goto/00042f75-d1bf-4c38-a081-da6d225f4169&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What apple variety was first commercially grown in the Southern Forests before anywhere else in the world? (2 words)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/91cffb68-00cd-4817-b928-0a5bd3c28232" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the apple picker sculpture. This sculpture highlights the importance that the Manjimup apple orchards have been in shaping both the local and global apple market. The orchards were even shipping apples back to London by the year 1900.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/46bfd7ba-b6f3-47a8-a735-eb6d4917f93b" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the sleepy town of Manjimup in WA's lower south west. Manjimup has a rich history of thriving industries that can still be seen today. These include the apple orchards of the that surround the town, the butter factory that brought industrialisation to the farmers of the community, the trails that the farmers drove there cattle on there seasonal grazing patterns, the cream truck which connected Walpole to the Manjimup area and lastly one very important figure in the history of Northcliffe 'Doc' Ryan who served for 43 years bringing much needed medical expertise to the region. This adlab aims to take you to all these important sites and learn a little about the history of the Shire.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
