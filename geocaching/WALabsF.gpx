  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99002365" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Jurien walk trail : S5 Memorial Park</groundspeak:name>
   <groundspeak:placed_by>yeatesy89</groundspeak:placed_by>
   <groundspeak:owner id="">yeatesy89</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Jurien walk trail&lt;/h3&gt;&lt;h4&gt;Memorial Park&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/16b2ea94-4a50-4460-8379-be7b8550b2ab"&gt;https://labs.geocaching.com/goto/16b2ea94-4a50-4460-8379-be7b8550b2ab&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many flag poles do you see?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/fba58151-585d-4517-9788-ce70d022659d" /&gt;&lt;/p&gt;&lt;p&gt;A great tribute to our war hero’s.  They hold an Anzac service here every year and are lucky enough to be able to have the Air force fly over during the service.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/19605aa4-3ecb-4f45-8682-423cca9679cc" /&gt;&lt;/p&gt;&lt;p&gt;Jurien Bay has this amazing walk/cycle path that is over 12kms long.  There are some amazing ocean views and if you time it right great sunsets.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
