  <url>https://labs.geocaching.com/goto/fe304deb-7b07-4465-a6c9-c89eee63b1cb</url>
  <urlname>WAQuokka AdLab Art #107 : S3 Perth's Tall Buildings - Palace Tower by ArmchairWizard</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918859" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #107 : S3 Perth's Tall Buildings - Palace Tower</groundspeak:name>
