  <desc>WoodanillingH32</desc>
  <url>https://labs.geocaching.com/goto/1cfe4d21-9bb5-41fd-86d0-6e7b904ed939</url>
  <urlname>Woodanilling History Walk 3 : S2 Railing out the grain by EGB2020</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9769946" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Woodanilling History Walk 3 : S2 Railing out the grain</groundspeak:name>
   <groundspeak:placed_by>EGB2020</groundspeak:placed_by>
   <groundspeak:owner id="">EGB2020</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Woodanilling History Walk 3&lt;/h3&gt;
    &lt;h4&gt;Railing out the grain&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/1cfe4d21-9bb5-41fd-86d0-6e7b904ed939" target="_blank"&gt;https://labs.geocaching.com/goto/1cfe4d21-9bb5-41fd-86d0-6e7b904ed939&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 20m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;George ploughed how many acres in 1898&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/e2dbe379-b6a9-435f-8e80-0af6d52e116e" /&gt;&lt;/p&gt;
    &lt;p&gt;While land around Woodanilling was originally taken up for sheep runs, it was not long before wheat became a major local product.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/e5e44ba2-346f-4bd9-9c0b-7f446a0c851c" /&gt;&lt;/p&gt;
    &lt;p&gt;Opened in 2008, the Woodanilling Heritage Walk consists of 13 panels on a short walk around the townsite. There are old black and white photos on each panel together with stories about Woodanilling’s people and places. Heritage Walk guides are available at the Shire office.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-33.562567" lon="117.431683">
  <ele>284.0</ele>
  <time>2026-07-19T08:00:00Z</time>
