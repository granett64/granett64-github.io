                                                                                                                                        &lt;h3&gt;Bruce Rock&lt;/h3&gt;
    &lt;h4&gt;Railway Station&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/ca44cb3c-5f3a-4bcb-a3f0-c7bf57cc8b76" target="_blank"&gt;https://labs.geocaching.com/goto/ca44cb3c-5f3a-4bcb-a3f0-c7bf57cc8b76&lt;/a&gt;&lt;/p&gt;

