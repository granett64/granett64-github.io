  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476909762" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Waterfalls and Rapids : S4 Noble Falls</groundspeak:name>
   <groundspeak:placed_by>Boyzrule5</groundspeak:placed_by>
