   <groundspeak:long_description html="True">&lt;h3&gt;Robin Reserve&lt;/h3&gt;&lt;h4&gt;The Bushland&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/ae8be077-1ee7-4469-851b-da2d6d806bba"&gt;https://labs.geocaching.com/goto/ae8be077-1ee7-4469-851b-da2d6d806bba&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the full name of the photographer who took these photos? (2 words)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/19211fa9-4d3e-4973-aa73-ea2f3cf4bab1" /&gt;&lt;/p&gt;&lt;p&gt;'The Bushland' is cared for by local volunteers, Friends of Robin Park Bushland, in conjunction with the Cify of Joondalup.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/223873bd-6d91-4105-a9ac-e7fb88b9fb20" /&gt;&lt;/p&gt;&lt;p&gt;Robin Park, located on Parnell Ave in Sorrento, is a designated dog park that offers a secure environment for dogs and their owners. It includes a playground for children and an oval used seasonally for athletics, football, and cricket. The park also provides toilets, waste bins, cricket nets, a water station and ample parking. Robin Park, or Robin Reserve as it is also known, features many shaded areas to protect against the summer sun, making it a practical option for outdoor activities with kids and dogs.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
