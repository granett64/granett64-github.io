   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Soldiers Park &lt;/h3&gt;&lt;h4&gt;Archway Entrance&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/eacd1c78-e556-472b-909d-4d6bad14f35f"&gt;https://labs.geocaching.com/goto/eacd1c78-e556-472b-909d-4d6bad14f35f&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;On the plaque in the middle of the archway, Australians have been serving on United Nations peacekeeping operations since? &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/abd99c70-1a98-49df-b258-1e558526fa5b" /&gt;&lt;/p&gt;&lt;p&gt;In the centre of the archway is a plaque commemorating Australia’s peacekeeping efforts around the world. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/93066906-e0b1-4635-9dc2-add4c376eca5" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to Soldiers Park in Collie. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a8d316f2-01cf-45b0-91ce-d9e2a750a2e5" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Congratulations &lt;/p&gt;</groundspeak:long_description>
