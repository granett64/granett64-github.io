  <desc>HarveyBoundS1Th</desc>
  <url>https://labs.geocaching.com/goto/ff613d83-102d-451d-8e50-d7fa9244d075</url>
  <urlname>Harvey Bound  : S1 The Gum Nut Babies by Paskersfind</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918245" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Harvey Bound  : S1 The Gum Nut Babies</groundspeak:name>
   <groundspeak:placed_by>Paskersfind</groundspeak:placed_by>
   <groundspeak:owner id="">Paskersfind</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Harvey Bound &lt;/h3&gt;&lt;h4&gt;The Gum Nut Babies&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/ff613d83-102d-451d-8e50-d7fa9244d075"&gt;https://labs.geocaching.com/goto/ff613d83-102d-451d-8e50-d7fa9244d075&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many Gumnut Babies are depicted in the illustration?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/1ce35958-4472-43ae-9a22-9d24cf313dd5" /&gt;&lt;/p&gt;&lt;p&gt;If you are standing in front of a sign illustrated with coy Gumnut Babies hiding behind a display of gum leaves, you are in the right place. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/9a1def16-8732-4dfa-9551-a162fcc60280" /&gt;&lt;/p&gt;&lt;p&gt; Welcome to James Stirling Place in beautiful Harvey, WA. The standout feature of this location- Stirling Cottage- is a replica 1850's timber cottage that has been home to WA's First Governor, Sir James Stirling, as well as many pioneering families including that of 'Snugglepot and Cuddlepie' creator, May Gibbs.
This adventure lab takes you on a leisurely stroll along the river walk pathway surrounding the immaculate Heritage Gardens of the cottage and introduces (or reacquaints) you with some of the wonderful, quirky characters May Gibbs created in her award-winning children's stories.
We hope you have fun and perhaps take some time to visit the abundance of other attractions in and around this delightful township.

&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
