  <name>LBLY9y-02</name>
  <desc>LHMASSydneyIIM2</desc>
  <url>https://labs.geocaching.com/goto/890d2d1b-386c-4e34-9b99-05a9ede1de0c</url>
  <urlname>[L] HMAS Sydney II Memorial : S2 The Sanctuary by Barnzy12</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476910089" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] HMAS Sydney II Memorial : S2 The Sanctuary</groundspeak:name>
   <groundspeak:placed_by>Barnzy12</groundspeak:placed_by>
   <groundspeak:owner id="">Barnzy12</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;HMAS Sydney II Memorial&lt;/h3&gt;&lt;h4&gt;The Sanctuary&lt;/h4&gt;&lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;linear&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/890d2d1b-386c-4e34-9b99-05a9ede1de0c"&gt;https://labs.geocaching.com/goto/890d2d1b-386c-4e34-9b99-05a9ede1de0c&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;On the propellor, what is the word engraved next to manganese &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c8d9e138-8003-48ec-ae9d-ddcd46696988" /&gt;&lt;/p&gt;&lt;p&gt;The sanctuary is the centre point of the memorial precinct with a dome formed of 645 stainless steel gulls representing those lost. The concept was inspired by the incident which took place when a flock of silver hills swooped over the assembled crowd during the memorial site dedication on the 19th November 1998. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/7e5bfe44-2aab-4337-8a32-4fcfa5eb4147" /&gt;&lt;/p&gt;&lt;p&gt;The HMAS Sydney II Memorial comprises many symbolic elements expressing the tragic loss of 645 lives on board the HMAS Sydney II.

There is a bonus box to this lab - GC9R0XT&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/1621ac64-2607-456d-b596-8136592f3589" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Congratulations&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-28.773" lon="114.615867">
