  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1550" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #18 : S4 Fremantle Harbour</groundspeak:name>
   <groundspeak:placed_by>m4yb</groundspeak:placed_by>
   <groundspeak:owner id="">m4yb</groundspeak:owner>
