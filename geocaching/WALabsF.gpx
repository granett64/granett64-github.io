  <desc>PingellyWA2S222</desc>
  <url>https://labs.geocaching.com/goto/a2abc443-231a-42ff-b26b-ac1b06853f02</url>
  <urlname>Pingelly, WA (2) : S2 The Exchange Tavern by Everlasting</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476909928" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Pingelly, WA (2) : S2 The Exchange Tavern</groundspeak:name>
   <groundspeak:placed_by>Everlasting</groundspeak:placed_by>
   <groundspeak:owner id="">Everlasting</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
