 <wpt lat="-32.05225" lon="115.73825">
  <ele>2.0</ele>
  <time>2025-07-04T08:00:00Z</time>
  <name>LBHhvU-02</name>
  <desc>WAQuokkaAdLa178</desc>
  <url>https://labs.geocaching.com/goto/3dce4f37-4ff8-47a6-bbea-488c43e48fb9</url>
  <urlname>WAQuokka AdLab Art #020 : S2 To the Fishermen by Kapelula</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1793" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #020 : S2 To the Fishermen</groundspeak:name>
   <groundspeak:placed_by>Kapelula</groundspeak:placed_by>
   <groundspeak:owner id="">Kapelula</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #020&lt;/h3&gt;&lt;h4&gt;To the Fishermen&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/3dce4f37-4ff8-47a6-bbea-488c43e48fb9"&gt;https://labs.geocaching.com/goto/3dce4f37-4ff8-47a6-bbea-488c43e48fb9&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What do you think the fisherman would be catching in his pot?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/5915f8a9-d9f2-4bc2-88e8-848a6d5eb3d6" /&gt;&lt;/p&gt;&lt;p&gt;Many families have contributed to the fishing industry in Fremantle and Fishing Boat Harbour is where it all began.  Many hardships were endured and this sculpture honours the men and women for their pioneering spirit.  The greatest number of fishermen came from Italy - mainly Sicily and Puglia.  Hence Fremantle's strong Italian cultural influence especially with food and community presence.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/0f42b880-ed35-471e-b0c2-002711ea8456" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.

To join this project, please contact the project Admins on WAQuokkaAdLab@gmail.com

In this Adventure Lab you will discover a few of the iconic bronze statues and their history in the Fremantle City Centre.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.0523" lon="115.73815">
  <ele>3.0</ele>
  <time>2025-07-04T08:00:00Z</time>
  <name>LBHhvU-01</name>
  <desc>WAQuokkaAdLa02c</desc>
  <url>https://labs.geocaching.com/goto/3dce4f37-4ff8-47a6-bbea-488c43e48fb9</url>
  <urlname>WAQuokka AdLab Art #020 : S1 Bon Scott by Kapelula</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1792" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #020 : S1 Bon Scott</groundspeak:name>
