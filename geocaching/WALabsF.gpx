  <desc>LTheStoryOfYag3</desc>
  <url>https://labs.geocaching.com/goto/775a8e5c-f81c-4941-8524-66b0d69e1509</url>
  <urlname>[L] The Story of Yagan : S3 Law by neva2old</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-228" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] The Story of Yagan : S3 Law</groundspeak:name>
   <groundspeak:placed_by>neva2old</groundspeak:placed_by>
   <groundspeak:owner id="">neva2old</groundspeak:owner>
