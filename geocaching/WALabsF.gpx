  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476919008" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #043 : S5 Giants Cave</groundspeak:name>
   <groundspeak:placed_by>BJA3</groundspeak:placed_by>
   <groundspeak:owner id="">BJA3</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #043&lt;/h3&gt;&lt;h4&gt;Giants Cave&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/9b58ce02-7869-4e6f-a798-02744b023a76"&gt;https://labs.geocaching.com/goto/9b58ce02-7869-4e6f-a798-02744b023a76&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Which European is credited with discovering the cave?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/4f40b1cc-e895-4286-b74a-f31092b84bfe" /&gt;&lt;/p&gt;&lt;p&gt;Giants Cave, located in the Leeuwin-Naturaliste National Park near Margaret River, WA, is known for its impressive doline entrance, formed by a cave roof collapse thousands of years ago. 

It's also an important archaeological site, with evidence of Wadandi Noongar occupation dating back over 55,000 years. 

The cave was further developed with staircases in the 1920s for adventure caving and has yielded significant fossil discoveries. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/378568d3-abe1-413c-a381-19d06c1b18a6" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.0531" lon="115.739183">
