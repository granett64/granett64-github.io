  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918851" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #099 : S4 BIG CROC - Wyndham WA</groundspeak:name>
   <groundspeak:placed_by>Snoopy1976</groundspeak:placed_by>
