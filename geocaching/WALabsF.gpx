  <urlname>WAQuokka AdLab Art #007 : S3 Stage 3 - Lake Ballard by JKJK20</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1315" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #007 : S3 Stage 3 - Lake Ballard</groundspeak:name>
   <groundspeak:placed_by>JKJK20</groundspeak:placed_by>
   <groundspeak:owner id="">JKJK20</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
