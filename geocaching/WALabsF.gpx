   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #45&lt;/h3&gt;&lt;h4&gt;Fish #3&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/088444e3-ad3d-479a-a28d-874872871882"&gt;https://labs.geocaching.com/goto/088444e3-ad3d-479a-a28d-874872871882&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What fish am i?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/75b8740f-56bc-499c-996a-85dde2049d58" /&gt;&lt;/p&gt;&lt;p&gt;This pretty sea creature one belongs to the Pipefish family. Its found only in the waters from Jurien Bay in WA through to Wilsons Promontory in Victoria. Its found no where else in the world. It resembles floating pieces of seaweed, which is excellent camouflage to protect them from potential predators. They can reach a length of 45cm. Most adults area a green to yellowish-brown, with thin bands/stripes across its body.  They are able to change colour to match their surroundings. Its favourite food is Mysid shrimps or sea lice.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/be0c4763-e30d-4df6-953f-a8138b34f844" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the4 WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.
To join this project, please contact the project admins on WAQuokkaAdLab@gmail.com&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
