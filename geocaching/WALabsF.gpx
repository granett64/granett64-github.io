  <name>LBV8Y3-3</name>
  <desc>PerthRailways23</desc>
  <url>https://labs.geocaching.com/goto/a9af3667-a4e8-4b3c-a7dc-0283f9a11d66</url>
  <urlname>Perth Railways 2 : S3 High Wycombe Station by GHFB</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9783159" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Perth Railways 2 : S3 High Wycombe Station</groundspeak:name>
   <groundspeak:placed_by>GHFB</groundspeak:placed_by>
   <groundspeak:owner id="">GHFB</groundspeak:owner>
