  <name>LB1h66-01</name>
  <desc>JohnOldhamPark1</desc>
  <url>https://labs.geocaching.com/goto/3b67a8de-59e9-4f20-b075-5c3509df2952</url>
  <urlname>John Oldham Park : S1 Indigenous History by Leg5</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918235" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>John Oldham Park : S1 Indigenous History</groundspeak:name>
   <groundspeak:placed_by>Leg5</groundspeak:placed_by>
   <groundspeak:owner id="">Leg5</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;John Oldham Park&lt;/h3&gt;&lt;h4&gt;Indigenous History&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/3b67a8de-59e9-4f20-b075-5c3509df2952"&gt;https://labs.geocaching.com/goto/3b67a8de-59e9-4f20-b075-5c3509df2952&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the Nyoongar name for this park?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/e045dc3c-97f2-4243-8ce0-054a36cf3c9c" /&gt;&lt;/p&gt;&lt;p&gt;This place was one of many camping sites of the Nyoongar Elder Yellagonga at the time of British occupation. There was a permanent spring which provided fresh water, and it was the home to a variety of food sources such as gilgies (freshwater crayfish), goodinyal (cobbler fish) and ducks.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a1dd3cce-a333-4b3c-97fc-1bbab4db19c8" /&gt;&lt;/p&gt;&lt;p&gt;This park was constructed when the Narrows Bridge was constructed over the Swan River in the 1950's. The park was designed between the interchanges and the Swan River, and would act as "green lungs", breathing life and oxygen into what would otherwise be an inhospitable traffic environment. This park was to be covered in exotic plants with a series of lakes and small waterfalls.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-35.028533" lon="117.88315">
  <ele>5.0</ele>
  <time>2024-11-02T08:00:00Z</time>
  <name>LBusgx-03</name>
