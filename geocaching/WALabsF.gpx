   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Kununurra Stars&lt;/h3&gt;&lt;h4&gt;The one and only Voice&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/3b29f6c4-2c3c-4184-801a-a11c5aa6b157"&gt;https://labs.geocaching.com/goto/3b29f6c4-2c3c-4184-801a-a11c5aa6b157&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What year did John Farnham plant his Raintree?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/37433000-fefa-4f3f-b866-2dfca7efeba7" /&gt;&lt;/p&gt;&lt;p&gt;John Farnham may be an Aussie entertaining legend but to us Poms he will always just be 'The Voice'. See if you can continue this Ad Lab without bursting into song or at least hatching an earworm.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/5f6ac709-80eb-4b23-b845-5a1a0c1931e8" /&gt;&lt;/p&gt;&lt;p&gt;It's time WA spread its AdLab wings and headed to the far north - here you will find a short pleasant wander around Kununurra's Celebrity Tree Park finding the famous folk who have planted trees.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/bd2d8c16-695d-4dda-b234-dfc1547166f9" /&gt;&lt;/p&gt;</groundspeak:long_description>
