   <groundspeak:name>John Oldham Park : S3 Fix the Bike</groundspeak:name>
   <groundspeak:placed_by>Leg5</groundspeak:placed_by>
   <groundspeak:owner id="">Leg5</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;John Oldham Park&lt;/h3&gt;&lt;h4&gt;Fix the Bike&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/3b67a8de-59e9-4f20-b075-5c3509df2952"&gt;https://labs.geocaching.com/goto/3b67a8de-59e9-4f20-b075-5c3509df2952&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What company made the bike station (plaque on top of post)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/686f9c7f-bf9a-4a0f-9720-e73a2021aa4a" /&gt;&lt;/p&gt;&lt;p&gt;A very busy spot for cyclists heading into and out of the Perth city near the Narrows Bridge. The needed tools plus a pump to get some air into the tyres.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a1dd3cce-a333-4b3c-97fc-1bbab4db19c8" /&gt;&lt;/p&gt;&lt;p&gt;This park was constructed when the Narrows Bridge was constructed over the Swan River in the 1950's. The park was designed between the interchanges and the Swan River, and would act as "green lungs", breathing life and oxygen into what would otherwise be an inhospitable traffic environment. This park was to be covered in exotic plants with a series of lakes and small waterfalls.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
