  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9678130" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Geo-Cake-ing In The Park : S3 Lamingtons</groundspeak:name>
   <groundspeak:placed_by>TeamBarritts</groundspeak:placed_by>
   <groundspeak:owner id="">TeamBarritts</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
