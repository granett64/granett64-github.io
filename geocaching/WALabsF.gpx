  <url>https://labs.geocaching.com/goto/798602c9-7976-4e1d-b1bf-89d262d721a4</url>
  <urlname>Harewood Forest Walk Trail : S3 Big Business by richlink</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918191" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Harewood Forest Walk Trail : S3 Big Business</groundspeak:name>
