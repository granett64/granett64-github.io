 <wpt lat="-33.5635" lon="117.4336">
  <ele>289.0</ele>
  <time>2026-07-19T08:00:00Z</time>
  <name>LBTV69-2</name>
  <desc>WoodanillingH22</desc>
  <url>https://labs.geocaching.com/goto/74f81494-2d7d-4005-85d9-c89186720bba</url>
  <urlname>Woodanilling Heritage Walk 2 : S2 Store by cravo10</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9769958" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Woodanilling Heritage Walk 2 : S2 Store</groundspeak:name>
   <groundspeak:placed_by>cravo10</groundspeak:placed_by>
   <groundspeak:owner id="">cravo10</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Woodanilling Heritage Walk 2&lt;/h3&gt;
    &lt;h4&gt;Store&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/74f81494-2d7d-4005-85d9-c89186720bba" target="_blank"&gt;https://labs.geocaching.com/goto/74f81494-2d7d-4005-85d9-c89186720bba&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 20m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;It merged with the Co-Op from Broomehill and ?&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/3607e93b-6ac3-4d52-9ce5-c17fcf0a7cdc" /&gt;&lt;/p&gt;
    &lt;p&gt;Passions were high at the public meeting addressed by Mr Dival in 1916. The war had drained the community of men and resources, yet many (including Mr Dival) blamed local farmers for "not doing their business in town".
. It was from this climate of recession laced with local fervour that the first moves were made to establish the Woodanilling Co-operative.
By the beginning of 1918 trading operations had commenced, with the company being formed in 1921.
After several temporary locations proved unsuitable this building was constructed in 1922, using stone from the demolished Agricultural Hall (west of the railway line). For 25 years the Woodanilling Cooperative was a highly efficient operation, returning substantial dividends to its local shareholders.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/7d0df806-d3d6-4a70-af9b-12adcc3665a6" /&gt;&lt;/p&gt;
    &lt;p&gt;Opened in 2008, the Woodanilling Heritage Walk consists of 13 panels on a short walk around the townsite. There are old black and white photos on each panel together with stories about Woodanilling’s people and places. Heritage Walk guides are available at the Shire office.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-33.5636" lon="117.434117">
  <ele>289.0</ele>
  <time>2026-07-19T08:00:00Z</time>
  <name>LBTV69-3</name>
  <desc>WoodanillingH23</desc>
  <url>https://labs.geocaching.com/goto/74f81494-2d7d-4005-85d9-c89186720bba</url>
  <urlname>Woodanilling Heritage Walk 2 : S3 Cottage Hospital by cravo10</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9769959" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Woodanilling Heritage Walk 2 : S3 Cottage Hospital</groundspeak:name>
   <groundspeak:placed_by>cravo10</groundspeak:placed_by>
   <groundspeak:owner id="">cravo10</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Woodanilling Heritage Walk 2&lt;/h3&gt;
    &lt;h4&gt;Cottage Hospital&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/74f81494-2d7d-4005-85d9-c89186720bba" target="_blank"&gt;https://labs.geocaching.com/goto/74f81494-2d7d-4005-85d9-c89186720bba&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 20m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;During 1919, how many cases were treated at the cottage?&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/f45830eb-ef5e-4b00-8146-4716b45d58b5" /&gt;&lt;/p&gt;
    &lt;p&gt;A district nurse was first appointed to Woodanilling in 1914, but it was not until 1916 that a firm proposal was put forward to build a hospital in town. A committee was established to commence raising funds but before construction could begin, the 1918 influenza epidemic struck the district as it swept around the world. Late that year sufficient funds were raised to allow building to begin.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/7d0df806-d3d6-4a70-af9b-12adcc3665a6" /&gt;&lt;/p&gt;
    &lt;p&gt;Opened in 2008, the Woodanilling Heritage Walk consists of 13 panels on a short walk around the townsite. There are old black and white photos on each panel together with stories about Woodanilling’s people and places. Heritage Walk guides are available at the Shire office.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-33.6888" lon="117.549133">
  <ele>322.0</ele>
