   <groundspeak:owner id="">Puzzzzler</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Watering holes in Guildford&lt;/h3&gt;&lt;h4&gt;Stirling Arms Hotel&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/f246ece8-a9c4-4171-8d45-47b8898daa23"&gt;https://labs.geocaching.com/goto/f246ece8-a9c4-4171-8d45-47b8898daa23&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Radius: 100m&lt;/p&gt;&lt;p&gt;Stages: 4&lt;/p&gt;&lt;p&gt;Kind of question: single&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;In what year was the Stirling Arms Est.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a1b1a759-cf74-43c2-974e-db7ed31c4ca1" /&gt;&lt;/p&gt;&lt;p&gt;This hotel is in historic Guildford, just 5km from the airport and close to the Swan Valley. The Stirling arms offers a great range of classic pub food with gluten free and vegan options available. Woodfired pizzas are available Thurs to sun. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/cc7adf02-64b6-4ff1-a61a-4558773d2023" /&gt;&lt;/p&gt;&lt;p&gt;This adventure lab will take you around the town of Guildford, close to the Swan Valley and Midland. 
It features 4 historic hotels and 1 liquor merchant. Well known for their craft beers and a variety of cuisines. 
Guilford is well known for its historic colonial architecture, it was established in 1929 on the Swan River. Serving as the first inland port. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.89795" lon="115.971817">
  <ele>18.0</ele>
  <time>2025-09-26T08:00:00Z</time>
  <name>LB4CE33</name>
  <desc>WateringHolesI3</desc>
  <url>https://labs.geocaching.com/goto/f246ece8-a9c4-4171-8d45-47b8898daa23</url>
  <urlname>Watering holes in Guildford : S3 Guildford Hotel by Puzzzzler</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99002429" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Watering holes in Guildford : S3 Guildford Hotel</groundspeak:name>
   <groundspeak:placed_by>Puzzzzler</groundspeak:placed_by>
   <groundspeak:owner id="">Puzzzzler</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Watering holes in Guildford&lt;/h3&gt;&lt;h4&gt;Guildford Hotel&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/f246ece8-a9c4-4171-8d45-47b8898daa23"&gt;https://labs.geocaching.com/goto/f246ece8-a9c4-4171-8d45-47b8898daa23&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Radius: 100m&lt;/p&gt;&lt;p&gt;Stages: 4&lt;/p&gt;&lt;p&gt;Kind of question: single&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Find on stand alone plaque.  In what year was the Guildford gutted by fire?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/7917a4be-3a0f-44c6-90c9-16992b0807d8" /&gt;&lt;/p&gt;&lt;p&gt;The town of Guildford is 12km north east of Perth. The town was established in 1829 as a market centre for the surrounding agricultural areas, making it crucial to WAs trade and prosperity. 
The Guildford Hotel was built in the late 180o's and has always been the centre of the towns life. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/cc7adf02-64b6-4ff1-a61a-4558773d2023" /&gt;&lt;/p&gt;&lt;p&gt;This adventure lab will take you around the town of Guildford, close to the Swan Valley and Midland. 
It features 4 historic hotels and 1 liquor merchant. Well known for their craft beers and a variety of cuisines. 
Guilford is well known for its historic colonial architecture, it was established in 1929 on the Swan River. Serving as the first inland port. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
