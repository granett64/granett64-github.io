  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99002430" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Watering holes in Guildford : S4 Copper and Oak liquor Merchants</groundspeak:name>
   <groundspeak:placed_by>Puzzzzler</groundspeak:placed_by>
   <groundspeak:owner id="">Puzzzzler</groundspeak:owner>
