   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Kingsway Regional Sporting Complex&lt;/h3&gt;
    &lt;h4&gt;Kingsway Baseball&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/9c9700fe-2746-42ff-a367-3446646c0e37" target="_blank"&gt;https://labs.geocaching.com/goto/9c9700fe-2746-42ff-a367-3446646c0e37&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 50m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;How many baseball diamonds are located here?&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/64cf4404-eb8a-4652-babb-bba2b55b1f1e" /&gt;&lt;/p&gt;
    &lt;p&gt;Wanneroo Giants Baseball Club is the biggest sporting club located at the Kingsway Sports Complex. Founded in 1975 and winning 6  x 1st Grade (State League) titles in the past 16 years, making it the most successful WA baseball club in recent years.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/98b69b8a-1f76-407b-98a1-744abc209e94" /&gt;&lt;/p&gt;
    &lt;p&gt;The Kingsway Sporting Complex is home to a number of clubs and sporting codes. This massive open space in Kingsway houses various sports, netball, AFL football, Soccer, Cricket, Rugby, Baseball and athletics. It also has several playgrounds, a lot of grass, and several lake areas around its 70 acres area. It also has a great path, perfect for bike riding around the various locations and through the park. There&amp;#039;s also picnic and barbecue facilities available throughout the place.
&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
