   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-33.646433" lon="115.346283">
  <ele>8.0</ele>
  <time>2020-07-20T08:00:00Z</time>
  <name>LB3amM-04</name>
  <desc>LLnFS4TheOldest</desc>
  <url>https://labs.geocaching.com/goto/Notforget</url>
  <urlname>[L] Lets not Forget : S4 The oldest of the old. by Falcon351</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476909739" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Lets not Forget : S4 The oldest of the old.</groundspeak:name>
   <groundspeak:placed_by>Falcon351</groundspeak:placed_by>
   <groundspeak:owner id="">Falcon351</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Lets not Forget&lt;/h3&gt;&lt;h4&gt;The oldest of the old. &lt;/h4&gt;&lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;linear&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/Notforget"&gt;https://labs.geocaching.com/goto/Notforget&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Where did Roger Guerin pass away&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/62f48841-e2fe-4bf1-8e70-d46542776a42" /&gt;&lt;/p&gt;&lt;p&gt;This cemetery is the old pioneer cemetery.  Walk around and discover a lot of Busselton names , look at the ages of people who passed . In bygone years people passed away at young ages with sometime simple diseases . In this cemetery there is a lot of tragedy. You need to look for a certain headstone that will give you the information you will require for the answer.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/9465ec12-45bd-49d8-b0a1-78eab4aa0fcb" /&gt;&lt;/p&gt;&lt;p&gt;My adventure is unique because it gives you time to reflect and give thanks for what we have today because of the sacrifice of our ancestors. This adventure will have you wandering thru cemetaries,a memorial and a cemotaph. Please be respectful of your surrounding.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;Award Message:&lt;br /&gt;Hope you had a wander and were enlightened about the hardship of our pioneers.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-33.646367" lon="115.33995">
  <ele>8.0</ele>
  <time>2020-07-20T08:00:00Z</time>
  <name>LB3amM-05</name>
  <desc>LLnFS5OceanView</desc>
  <url>https://labs.geocaching.com/goto/Notforget</url>
  <urlname>[L] Lets not Forget : S5 Ocean views by Falcon351</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476909741" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Lets not Forget : S5 Ocean views</groundspeak:name>
