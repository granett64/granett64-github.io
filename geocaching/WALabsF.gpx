   <groundspeak:name>Bayswater Street Art : S5 Bayswater Library and Community Centre</groundspeak:name>
   <groundspeak:placed_by>Guinness12</groundspeak:placed_by>
   <groundspeak:owner id="">Guinness12</groundspeak:owner>
