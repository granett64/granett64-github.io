  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99003717" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Wagin : S4 WAGIN - A town of country hospitality</groundspeak:name>
   <groundspeak:placed_by>sevabo</groundspeak:placed_by>
