  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9769953" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Woodanilling Heritage Walk 1 : S3 Richardsons Store</groundspeak:name>
   <groundspeak:placed_by>Leg5</groundspeak:placed_by>
   <groundspeak:owner id="">Leg5</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
