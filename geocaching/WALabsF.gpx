   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #071&lt;/h3&gt;&lt;h4&gt;Rainbow &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/65dc793a-8aaf-4175-81a7-53e90db1229c"&gt;https://labs.geocaching.com/goto/65dc793a-8aaf-4175-81a7-53e90db1229c&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the name of the sculpter who designed the “Rainbow”?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/02a1f95e-1715-44ad-bf01-f496447ebdd3" /&gt;&lt;/p&gt;&lt;p&gt;The ‘Rainbow’ was installed between the bridges at Beach Reserve overlooking the Fremantle port in 2016. At nine-metres high and19-metres long, and tipping the scales at 66 tonnes Rainbow is not your average public art piece.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/7a027cb5-953b-4bcb-aa16-94006b15712d" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.  This series will take you on a quick tour of some of my fav public Art installations in Fremantle. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.051967" lon="115.739617">
