  <url>https://labs.geocaching.com/goto/d9a0eb8f-3ca4-4138-9ed6-e4690307ee51</url>
  <urlname>ANZAC Peace Park : S4 The Gathering by Barnzy12</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918233" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
