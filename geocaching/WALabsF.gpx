  <name>LB9Kym-04</name>
  <desc>CoogeeCapersS4C</desc>
  <url>https://labs.geocaching.com/goto/a29728dc-def1-43df-8aeb-c8f306a0fd32</url>
  <urlname>Coogee Capers : S4 Clarence Settlement by I C Nothing</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-780" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Coogee Capers : S4 Clarence Settlement</groundspeak:name>
   <groundspeak:placed_by>I C Nothing</groundspeak:placed_by>
   <groundspeak:owner id="">I C Nothing</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Coogee Capers&lt;/h3&gt;&lt;h4&gt;Clarence Settlement &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/a29728dc-def1-43df-8aeb-c8f306a0fd32"&gt;https://labs.geocaching.com/goto/a29728dc-def1-43df-8aeb-c8f306a0fd32&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many members were there of "Thomas Peel's" failed venture?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/e7af77b2-30ac-49c9-bfe6-395b753dc567" /&gt;&lt;/p&gt;&lt;p&gt;Whilst walking along this walk track, we came across this memorial for the Clarence Settlement. People arrived on three ships, Gilmore, Hooghly and Rockingham between December 1829 and May 1830. They set up makeshift camps in primitive condition. In the first year 40 settlers died of scurvy, dysentery and other ailments including six women due to childbirth. The majority of the deceased were originally buried at this location with a number re in - interred in the Old Alma Street Cemetery in Fremantle.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/fcadfa12-a873-4c41-a962-0a7361395bb0" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to Woodman Point a area rich in history with hidden treasures waiting to be found. The MICKS crew have enjoyed exploring this area and would like to share some interesting areas with you through this Adventure Lab.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
