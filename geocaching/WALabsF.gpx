   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Northam Sights&lt;/h3&gt;&lt;h4&gt;Hugo Throssell&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/NorthamSights"&gt;https://labs.geocaching.com/goto/NorthamSights&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What month in 1919 did Hugo address the crowd? (use word)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/cfd12a4b-c7c7-45ac-af38-8736d6b356a5" /&gt;&lt;/p&gt;&lt;p&gt;A local Hero, who stood at this exact spot on his horse to give his speech after his extreme devotion to duty and bravery earn't him the Victorian Cross during WWll.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/74f2cf0c-62b8-46b9-bc98-7d9c3780b3b8" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to Northam the heart of the picturesque Avon Valley. Only an hour from Perth, Northam is home to a diverse range of tourist and heritage attractions. Come relax by the Avon River, take in some of the town’s rich history, or walk across the suspension bridge to view WAs only colony of white swans. Other attractions include, walking trails, historic buildings, the Avon Decent and much more. Seasonal canola splashing fields of yellow, rolling hills and bright coloured hot air balloons are just some of the visual delights to be enjoyed.
There is a bonus cache after collecting the clues. Saving Mount Ommanney till last will stop you having to backtrack.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/5e065186-3957-4c08-ab53-a794e919d2ff" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Awesome! 
Take note of the clue to get to the final
D=3&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
