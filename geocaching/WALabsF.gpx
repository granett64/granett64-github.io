  <name>LBRrvs-03</name>
  <desc>WAQuokkaAdLab46</desc>
  <url>https://labs.geocaching.com/goto/088444e3-ad3d-479a-a28d-874872871882</url>
  <urlname>WAQuokka AdLab Art #45 : S3 Fish #3 by LOLOACacheIC</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1620" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #45 : S3 Fish #3</groundspeak:name>
   <groundspeak:placed_by>LOLOACacheIC</groundspeak:placed_by>
