   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Manjimup Heritage Connections&lt;/h3&gt;&lt;h4&gt;Doc Ryan&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/00042f75-d1bf-4c38-a081-da6d225f4169"&gt;https://labs.geocaching.com/goto/00042f75-d1bf-4c38-a081-da6d225f4169&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What was Doc Ryan's first name? (One word))&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/44a07829-948a-4cef-b03e-42f2bdb0ce69" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the Doc Ryan. This plaque tells you about the history of him in the region and how impactful he was and as a side note he was also my uncle.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/46bfd7ba-b6f3-47a8-a735-eb6d4917f93b" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the sleepy town of Manjimup in WA's lower south west. Manjimup has a rich history of thriving industries that can still be seen today. These include the apple orchards of the that surround the town, the butter factory that brought industrialisation to the farmers of the community, the trails that the farmers drove there cattle on there seasonal grazing patterns, the cream truck which connected Walpole to the Manjimup area and lastly one very important figure in the history of Northcliffe 'Doc' Ryan who served for 43 years bringing much needed medical expertise to the region. This adlab aims to take you to all these important sites and learn a little about the history of the Shire.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-34.9758" lon="116.731533">
  <ele>14.0</ele>
  <time>2025-07-10T08:00:00Z</time>
  <name>LBgpuR-05</name>
  <desc>ManjimupHerita5</desc>
  <url>https://labs.geocaching.com/goto/00042f75-d1bf-4c38-a081-da6d225f4169</url>
  <urlname>Manjimup Heritage Connections : S5 Walpole Cream Truck by orrsom</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-2128" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Manjimup Heritage Connections : S5 Walpole Cream Truck</groundspeak:name>
   <groundspeak:placed_by>orrsom</groundspeak:placed_by>
   <groundspeak:owner id="">orrsom</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Manjimup Heritage Connections&lt;/h3&gt;&lt;h4&gt;Walpole Cream Truck&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/00042f75-d1bf-4c38-a081-da6d225f4169"&gt;https://labs.geocaching.com/goto/00042f75-d1bf-4c38-a081-da6d225f4169&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What was Roy "......" Burton's Nickname? (One word)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/2c3f1571-65d8-4ea4-acce-96e5aec52d4a" /&gt;&lt;/p&gt;&lt;p&gt;The many dairy farmers in the Walpole region were unhappy with the great southern butter factory and all banded together to send there cream north to Manjimup. The journey was long and rough but was vital for the farmers of the area.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/46bfd7ba-b6f3-47a8-a735-eb6d4917f93b" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the sleepy town of Manjimup in WA's lower south west. Manjimup has a rich history of thriving industries that can still be seen today. These include the apple orchards of the that surround the town, the butter factory that brought industrialisation to the farmers of the community, the trails that the farmers drove there cattle on there seasonal grazing patterns, the cream truck which connected Walpole to the Manjimup area and lastly one very important figure in the history of Northcliffe 'Doc' Ryan who served for 43 years bringing much needed medical expertise to the region. This adlab aims to take you to all these important sites and learn a little about the history of the Shire.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.127583" lon="116.0651">
  <ele>66.0</ele>
  <time>2025-07-18T08:00:00Z</time>
  <name>LBsfe7-02</name>
  <desc>RoleyPoolReser2</desc>
  <url>https://labs.geocaching.com/goto/35be7d2b-cbbf-4ef3-8447-70e332241d3b</url>
  <urlname>Roley Pool Reserve - Boardwalk Trail : S2 A Rat by Any Other Name? by Paskersfind</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476919013" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Roley Pool Reserve - Boardwalk Trail : S2 A Rat by Any Other Name?</groundspeak:name>
   <groundspeak:placed_by>Paskersfind</groundspeak:placed_by>
   <groundspeak:owner id="">Paskersfind</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Roley Pool Reserve - Boardwalk Trail&lt;/h3&gt;&lt;h4&gt;A Rat by Any Other Name?&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/35be7d2b-cbbf-4ef3-8447-70e332241d3b"&gt;https://labs.geocaching.com/goto/35be7d2b-cbbf-4ef3-8447-70e332241d3b&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the correct and preferred term used to refer to our 'Native Otter'?  (1 word)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/2a63189e-44c3-4039-85b7-91c956b33771" /&gt;&lt;/p&gt;&lt;p&gt;A quick stop here to peruse the sign and garner some insight into our diverse native fauna.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c4b21827-121a-4284-8366-a72e02925533" /&gt;&lt;/p&gt;&lt;p&gt;Roley Pool Reserve is a little hidden gem in the Perth Hills. Follow the trail along the Canning River  through the steep sided Canning Valley and if you're lucky, you may spot a 'Native Otter', Quenda or Brushtail Possum in the unspoilt bushland. The core of this Reserve is Roley Pool itself which was the original Roleystone swimming hole. Winter is the perfect time to take the short stroll from Soldiers Road lower carpark, past the Information Shelter to complete the Adlab or, for those up for it, continue on to Nature's spa and the end of the trail.
There is a bonus cache attached to this lab.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
