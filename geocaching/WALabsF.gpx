 <wpt lat="-33.324833" lon="115.636367">
  <ele>9.0</ele>
  <time>2022-06-02T08:00:00Z</time>
  <name>LBQiAU-01</name>
  <desc>BunburyHiddenA1</desc>
  <url>https://labs.geocaching.com/goto/043949a8-b601-43a6-a32f-1ee304f3891b</url>
  <urlname>Bunbury Hidden Art  : S1 Art Alley by Rach2</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99003631" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Bunbury Hidden Art  : S1 Art Alley</groundspeak:name>
   <groundspeak:placed_by>Rach2</groundspeak:placed_by>
   <groundspeak:owner id="">Rach2</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Bunbury Hidden Art &lt;/h3&gt;&lt;h4&gt;Art Alley&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/043949a8-b601-43a6-a32f-1ee304f3891b"&gt;https://labs.geocaching.com/goto/043949a8-b601-43a6-a32f-1ee304f3891b&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the surname of the artist who painted the mural of the girl in the blue dress falling?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/d12d8878-c3cc-4cff-b891-4629c2d25d69" /&gt;&lt;/p&gt;&lt;p&gt;This alleyway has a whole wall painted by several artists one hot summers day. It was great spot to watch their ideas transform an old ugly wall. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/f09837e4-c26c-467b-ba85-94ea3e6f6d99" /&gt;&lt;/p&gt;&lt;p&gt;Down the alleyways and back streets of Bunbury you can find a wide range of murals by world renowned and local artists. This is only a small sample of the murals that dot the city.  So put on your walking shoes and get out or hire an e-scooter and enjoy your Adventure Lab. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/abdfbc76-f2b2-4ac5-a481-f0fe12b9a683" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Well done. Sarah Mills is an award winning Bunbury artist.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
