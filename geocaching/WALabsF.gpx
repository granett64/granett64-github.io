   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Visit Collie&lt;/h3&gt;&lt;h4&gt;Collie Mural Trail&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/7daca72b-534f-405b-9d53-da4e5e1b0d19"&gt;https://labs.geocaching.com/goto/7daca72b-534f-405b-9d53-da4e5e1b0d19&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What year is mentioned on the silver plaque at the end of the wall?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/bd9a92cc-045c-41bc-b2f8-8ad6d85c221e" /&gt;&lt;/p&gt;&lt;p&gt;The collie mural trail is a collection of 40 murals in the collie area by over 30 artists, the largest of which is located on the Wellington Dam Wall. Mural 4 is located at the visitors centre by Sioux Tempestt which is based on the trails of Collie. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/800f5ebc-30b3-461c-b444-c75ba469f54b" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the Collie Visitors Centre. This adventure lab will take you around the visitors centre precinct. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/975a766f-c596-4c55-ad4b-182f1777be71" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Congratulations&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
