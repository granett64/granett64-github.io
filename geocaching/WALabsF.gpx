  <urlname>The (old) Road to Bunbury : S3 Yarloop by Granett</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-519" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>The (old) Road to Bunbury : S3 Yarloop</groundspeak:name>
   <groundspeak:placed_by>Granett</groundspeak:placed_by>
