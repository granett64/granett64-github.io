  <name>LBBcsP-01</name>
  <desc>GoldenPipelineU</desc>
  <url>https://labs.geocaching.com/goto/707c666c-a724-4ee6-a2df-2550cc44b397</url>
  <urlname>Golden Pipeline Trail: Ghooli  : S1 Stacked Up by cravo10</urlname>
  <sym>Geocache</sym>
