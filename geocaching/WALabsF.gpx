 <wpt lat="-28.77575" lon="114.605633">
  <ele>8.0</ele>
  <time>2022-07-20T08:00:00Z</time>
  <name>LB4hze-03</name>
  <desc>LDiscoverGeral3</desc>
  <url>https://labs.geocaching.com/goto/2125fac9-bf70-4b8b-b775-57a9f3010a23</url>
  <urlname>[L] Discover Geraldton : S3 One building, many stories. by Ian&amp;Sue - Team Pathfinder</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918372" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Discover Geraldton : S3 One building, many stories.</groundspeak:name>
   <groundspeak:placed_by>Ian&amp;Sue - Team Pathfinder</groundspeak:placed_by>
   <groundspeak:owner id="">Ian&amp;Sue - Team Pathfinder</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Discover Geraldton&lt;/h3&gt;&lt;h4&gt;One building, many stories.&lt;/h4&gt;&lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;linear&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/2125fac9-bf70-4b8b-b775-57a9f3010a23"&gt;https://labs.geocaching.com/goto/2125fac9-bf70-4b8b-b775-57a9f3010a23&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many men stand at the Glideaway?   &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a4ac03e3-57f6-474a-ac22-8e0924b35ca6" /&gt;&lt;/p&gt;&lt;p&gt;Built in 1878 to serve as the railway station on the Geraldton to Northampton line, this building was originally single storey.  An active railway line running down the centre of Marine Terrace, (now the Mall), proved to be challenging with pedestrians and other traffic.  By 1895 it had been closed and the rails removed.  It sat derelict for years until in 1910, saved from being torn down, it became the library which remained in the building until 1975.

From 1979 until 2000 it housed the WA Museum, when they moved on the building again fell into disrepair.  In the last ten years it has been restored and housed the visitor information centre until recently.  &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/6da70222-27e7-491d-82ab-bb449c046563" /&gt;&lt;/p&gt;&lt;p&gt;Discover Geraldton will take you on a short stroll / cycle around town sharing with you some of Geraldtons’ history which is often overlooked.

A short stroll - approximately 30 minutes.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-28.775233" lon="114.60695">
  <ele>9.0</ele>
