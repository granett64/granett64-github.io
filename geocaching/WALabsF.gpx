  <desc>WAQuokkaAdLa01W</desc>
  <url>https://labs.geocaching.com/goto/dfc54184-8622-46d7-b5e0-287e85178253</url>
  <urlname>WAQuokka AdLab Art #010 : S3 Whats down south to see? by neva2old</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1370" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
