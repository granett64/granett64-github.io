  <desc>GoldenPipelineB</desc>
  <url>https://labs.geocaching.com/goto/707c666c-a724-4ee6-a2df-2550cc44b397</url>
  <urlname>Golden Pipeline Trail: Ghooli  : S5 Bike Pump by cravo10</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476910030" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
