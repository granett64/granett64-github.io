 <wpt lat="-32.0528" lon="115.738617">
  <ele>1.0</ele>
  <time>2025-06-02T08:00:00Z</time>
  <name>LBRrvs-01</name>
  <desc>WAQuokkaAdLab4F</desc>
  <url>https://labs.geocaching.com/goto/088444e3-ad3d-479a-a28d-874872871882</url>
  <urlname>WAQuokka AdLab Art #45 : S1 Fish #1 by LOLOACacheIC</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1618" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #45 : S1 Fish #1</groundspeak:name>
   <groundspeak:placed_by>LOLOACacheIC</groundspeak:placed_by>
   <groundspeak:owner id="">LOLOACacheIC</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #45&lt;/h3&gt;&lt;h4&gt;Fish #1&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/088444e3-ad3d-479a-a28d-874872871882"&gt;https://labs.geocaching.com/goto/088444e3-ad3d-479a-a28d-874872871882&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the name of this fish?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/3712a2f3-9125-4a48-b18b-7af4767363f1" /&gt;&lt;/p&gt;&lt;p&gt;This fish is found off the coast of WA. It is exclusive to waters from Shark bay in the north of WA to Esperance in the south of WA. This fish prefers rocky outcrops and ledges and can usually be found in the water about 20-50m deep. This fish has big eyes and cavernous mouth which they use to prey on other fish, crustaceans and molluscs. The adult male is often larger than the female. Males can also be identified by a longer filament on their dorsal fin (the fin on top of their back). It grows to a good size and tastes great. What am i?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/be0c4763-e30d-4df6-953f-a8138b34f844" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the4 WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.
To join this project, please contact the project admins on WAQuokkaAdLab@gmail.com&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.052817" lon="115.73865">
  <ele>1.0</ele>
