   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;The Beauty of Fitzgerald National Park&lt;/h3&gt;
    &lt;h4&gt;4 Mile Beach&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/cf729cac-9d38-42eb-b7a3-224538fd48e2" target="_blank"&gt;https://labs.geocaching.com/goto/cf729cac-9d38-42eb-b7a3-224538fd48e2&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 500m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;Do not explore …(one word)&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/e2af9e6b-4b33-46c8-ad74-ca7f9a7abb15" /&gt;&lt;/p&gt;
    &lt;p&gt;Four Mile Beach stretches from Culham Inlet to Barrens Beach. Along the way there is a lovely picnic area overlooking soft white sand and the deep blue of the vast Southern Ocean. The picnic area is just a 200m walk along a formed path from Four Mile Campground. This is a convenient place to camp when visiting East Mount Barren, Barrens Beach, Mylies Beach and West Beach.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/2523b7ba-0f93-4463-b4d9-0b140de15f9d" /&gt;&lt;/p&gt;
    &lt;p&gt;Welcome to the diverse beauty and grandeur of this special national park. There are specific flora here not to be found elsewhere and the sweep of beaches is outstanding. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
