 <wpt lat="-31.637983" lon="116.675717">
  <ele>154.0</ele>
  <time>2020-10-26T08:00:00Z</time>
  <name>LBsxjg-03</name>
  <desc>NSS3MorbyCottag</desc>
  <url>https://labs.geocaching.com/goto/NorthamSights</url>
  <urlname>Northam Sights : S3 Morby Cottage by geotrakka</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-53" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Northam Sights : S3 Morby Cottage</groundspeak:name>
   <groundspeak:placed_by>geotrakka</groundspeak:placed_by>
   <groundspeak:owner id="">geotrakka</groundspeak:owner>
