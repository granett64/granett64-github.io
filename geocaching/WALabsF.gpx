  <urlname>Strickland Street Stroll : S1 Co-Operative Store by richlink</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9653498" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Strickland Street Stroll : S1 Co-Operative Store</groundspeak:name>
   <groundspeak:placed_by>richlink</groundspeak:placed_by>
   <groundspeak:owner id="">richlink</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
