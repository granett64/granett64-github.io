  <url>https://labs.geocaching.com/goto/ac934a77-d235-471b-a72c-01a2a0303adf</url>
  <urlname>[L] Mandurah Art Trail : S5 Swimming in the Shade of Days Gone By by jinta29</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-431" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Mandurah Art Trail : S5 Swimming in the Shade of Days Gone By</groundspeak:name>
   <groundspeak:placed_by>jinta29</groundspeak:placed_by>
   <groundspeak:owner id="">jinta29</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Mandurah Art Trail&lt;/h3&gt;&lt;h4&gt;Swimming in the Shade of Days Gone By&lt;/h4&gt;&lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;linear&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/ac934a77-d235-471b-a72c-01a2a0303adf"&gt;https://labs.geocaching.com/goto/ac934a77-d235-471b-a72c-01a2a0303adf&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many poles support the artwork?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a90d838d-d405-451d-871a-b1e8eda8bdf7" /&gt;&lt;/p&gt;&lt;p&gt;Elevated on jarrah poles, the aluminium canopy reflects the movement of water and marine life and casts interesting shadows on the pavement below.

Artists: Jahne Rees &amp; Rob McCulloch&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/069ec840-778a-473e-a13d-ffc58c460f26" /&gt;&lt;/p&gt;&lt;p&gt;Mandurah is filled with a lot of public art but not all of it is as obvious as you might think. Hidden down laneways, on the pavement or on the facades of buildings, artworks are all around this area and we’re going to help you find some of them.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;Award Message:&lt;br /&gt;I hope you enjoyed your short walk around some of Mandurah's public art.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.534533" lon="115.719767">
  <ele>5.0</ele>
  <time>2020-11-22T08:00:00Z</time>
  <name>LBqifJ-04</name>
  <desc>LMandurahArtTr4</desc>
  <url>https://labs.geocaching.com/goto/ac934a77-d235-471b-a72c-01a2a0303adf</url>
  <urlname>[L] Mandurah Art Trail : S4 Lady Bananas by jinta29</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476910149" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Mandurah Art Trail : S4 Lady Bananas</groundspeak:name>
   <groundspeak:placed_by>jinta29</groundspeak:placed_by>
   <groundspeak:owner id="">jinta29</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Mandurah Art Trail&lt;/h3&gt;&lt;h4&gt;Lady Bananas&lt;/h4&gt;&lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;linear&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/ac934a77-d235-471b-a72c-01a2a0303adf"&gt;https://labs.geocaching.com/goto/ac934a77-d235-471b-a72c-01a2a0303adf&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;One of the monkeys is wearing a blue vest. How many buttons are on the blue vest?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/dddb5687-adf2-4068-8add-7e01dc19c93f" /&gt;&lt;/p&gt;&lt;p&gt;This series of contemporary urban murals wrap round the building to form a colourful, engaging and eye catching modern artwork.

Artist: Lady Bananas &amp; Ladie Poise &amp; Pore&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/069ec840-778a-473e-a13d-ffc58c460f26" /&gt;&lt;/p&gt;&lt;p&gt;Mandurah is filled with a lot of public art but not all of it is as obvious as you might think. Hidden down laneways, on the pavement or on the facades of buildings, artworks are all around this area and we’re going to help you find some of them.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;Award Message:&lt;br /&gt;Woohoo, one more to go!&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.563233" lon="115.68055">
