   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Welcome to Perth&lt;/h3&gt;&lt;h4&gt;Jandakot Airport&lt;/h4&gt;&lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;linear&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/80c1d3e9-402f-4f2e-b66d-305b908dbdb8"&gt;https://labs.geocaching.com/goto/80c1d3e9-402f-4f2e-b66d-305b908dbdb8&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;There is an essential Aussie medical service is based at Jandakot. What does RFDS stand for? (four words)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/4993d663-1ade-4d2b-863f-ba5730af37df" /&gt;&lt;/p&gt;&lt;p&gt;In the 2011 fiscal year Jandakot airport was named as the busiest civilian airport in Australia in terms of aircraft movements, 275,506 to be precise, and regularly appears in the top 10.

The airport is the base of many of our airborne emergency services as well as being a training ground for civilian and commercial airline pilots. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/dc289c8f-ab76-4013-9afa-872188ca6ddc" /&gt;&lt;/p&gt;&lt;p&gt;Perth Airport is not the world's largest transfer hub but it (in normal times) does handle approx 1.3 million passengers per month! That's a lot of passengers twiddling their thumbs with not much to do. So here is a small AdLab to pass 5 minutes or more.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.936367" lon="115.971683">
