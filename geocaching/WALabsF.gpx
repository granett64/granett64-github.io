 <wpt lat="-31.9965" lon="116.031217">
  <ele>158.0</ele>
  <time>2022-05-12T08:00:00Z</time>
  <name>LBa1oe-05</name>
  <desc>LLesmurdieFall5</desc>
  <url>https://labs.geocaching.com/goto/ddf93f00-840a-4a2a-b88d-36ace2986019</url>
  <urlname>[L] Lesmurdie Falls Adventure Lab : S5 A different perspective: view from the side by Paskersfind</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-145" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Lesmurdie Falls Adventure Lab : S5 A different perspective: view from the side</groundspeak:name>
   <groundspeak:placed_by>Paskersfind</groundspeak:placed_by>
   <groundspeak:owner id="">Paskersfind</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Lesmurdie Falls Adventure Lab&lt;/h3&gt;&lt;h4&gt;A different perspective: view from the side&lt;/h4&gt;&lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;linear&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/ddf93f00-840a-4a2a-b88d-36ace2986019"&gt;https://labs.geocaching.com/goto/ddf93f00-840a-4a2a-b88d-36ace2986019&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What geological feature defines the face of Lesmurdie Falls? [2 words]&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/da4dd180-2729-4479-8f5a-2a52a300db10" /&gt;&lt;/p&gt;&lt;p&gt;Take the trail further down the valley to the lower observation platform. This spot offers panoramic views right across to the Perth CBD.  A very informative information board by the Department of Conservation can be found at the entrance to the  platform. Look closely at the two photos in the centre for your answer to the final question.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/07c74bad-d79f-46c9-82d9-3dcb1dce29c3" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the Lesmurdie Falls Adventure Lab. Lesmurdie Falls is the spectacular point where Lesmurdie Brook plummets 40 metres over the granite edge of the Darling Scarp into the lush valley below. 
Located within the Mundy Regional Park, the area around the falls offers stunning views over the Swan Coastal Plain as well as access to lookouts and relatively short and easy hiking trails ranging from the short 300m Cascades Walk to the 3km Valley Loop Trail.
This adlab extends from the Cascades down to the Lesmurdie Falls lookouts, a distance of less than 1km.
At the starting point, there is a large carpark, picnic tables and toilet facilities. Please note there is no potable drinking water available, dogs are permitted on a leash and there is an optional mystery bonus cache available.
[We respectfully acknowledge the Beeloo people, the traditional owners and the first people of these lands.]&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/fded87f3-442f-4e77-8bf6-df6e8e0bc05a" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;100%  done. We hope you have enjoyed your visit. Final Mystery clue: I am also know as Katter Kish by the local Noongar people.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.996117" lon="116.031417">
  <ele>144.0</ele>
  <time>2022-05-12T08:00:00Z</time>
  <name>LBa1oe-04</name>
  <desc>LLesmurdieFall4</desc>
  <url>https://labs.geocaching.com/goto/ddf93f00-840a-4a2a-b88d-36ace2986019</url>
  <urlname>[L] Lesmurdie Falls Adventure Lab : S4 Head of the Falls Lookout by Paskersfind</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-144" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Lesmurdie Falls Adventure Lab : S4 Head of the Falls Lookout</groundspeak:name>
   <groundspeak:placed_by>Paskersfind</groundspeak:placed_by>
   <groundspeak:owner id="">Paskersfind</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Lesmurdie Falls Adventure Lab&lt;/h3&gt;&lt;h4&gt;Head of the Falls Lookout&lt;/h4&gt;&lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;linear&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/ddf93f00-840a-4a2a-b88d-36ace2986019"&gt;https://labs.geocaching.com/goto/ddf93f00-840a-4a2a-b88d-36ace2986019&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How many steps did you take from the trail down to this viewing platform? &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/4d03e5e4-7231-4dd3-ac9b-61161da212a9" /&gt;&lt;/p&gt;&lt;p&gt;A few steps down and you have arrived at the top of the falls viewing platform where amazing views down the Lesmurdie Brook valley and across the Swan coastal plain can be enjoyed.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/07c74bad-d79f-46c9-82d9-3dcb1dce29c3" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the Lesmurdie Falls Adventure Lab. Lesmurdie Falls is the spectacular point where Lesmurdie Brook plummets 40 metres over the granite edge of the Darling Scarp into the lush valley below. 
Located within the Mundy Regional Park, the area around the falls offers stunning views over the Swan Coastal Plain as well as access to lookouts and relatively short and easy hiking trails ranging from the short 300m Cascades Walk to the 3km Valley Loop Trail.
This adlab extends from the Cascades down to the Lesmurdie Falls lookouts, a distance of less than 1km.
At the starting point, there is a large carpark, picnic tables and toilet facilities. Please note there is no potable drinking water available, dogs are permitted on a leash and there is an optional mystery bonus cache available.
[We respectfully acknowledge the Beeloo people, the traditional owners and the first people of these lands.]&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/2ef44d93-9793-47c5-b790-ff31516c7e85" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;80%...Almost there! Mystery clue: I am around 15m high and around 110m long!&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
