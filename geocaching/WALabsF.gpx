  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918832" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #47 : S5 Home of the America’s Cup no more</groundspeak:name>
   <groundspeak:placed_by>m4yb</groundspeak:placed_by>
