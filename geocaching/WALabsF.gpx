   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Quotation from Anzac's&lt;/h3&gt;&lt;h4&gt;16.05.1915&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/723f82f6-0f37-4af4-9f37-b3a3496d406c"&gt;https://labs.geocaching.com/goto/723f82f6-0f37-4af4-9f37-b3a3496d406c&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Whom was the quote from?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/92ba2682-e6f4-4acc-988a-e9d3910d2aba" /&gt;&lt;/p&gt;&lt;p&gt;When I got hit, of course, the
first thing I knew I was on
my back. A chap in a trench
save me and ran out and
pulled me in. I thought I
would go grey with the pain.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/6bdf135f-9261-41a1-8c1d-f96365ea26b9" /&gt;&lt;/p&gt;&lt;p&gt;Take a walk up to the Desert Mounted Corps Memorial. Taking in some nice views and some quotes from letter sent home from the Anzac's.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
