   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #023&lt;/h3&gt;&lt;h4&gt;Brenden Abbott &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/034e1012-bfa7-4062-9365-3fc82b458a4b"&gt;https://labs.geocaching.com/goto/034e1012-bfa7-4062-9365-3fc82b458a4b&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the media's nickname for Brendan Abbott? &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/5fa78aea-f440-49f3-acf4-da9fc1fd95ee" /&gt;&lt;/p&gt;&lt;p&gt;Brenden James Abbott  is a convicted Australian bank robber. He is reported to have stolen and hidden millions of dollars. Having escaped and been on the run multiple times, Abbott is currently being held at Casuarina Prison. He will be eligible for parole in 2026. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/e623438e-fd44-4ad6-b804-36293b09b351" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on the stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal. 

To join this project, please contact the project admins at WAQuokkaAdLab@gmail.com&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.0528" lon="115.73945">
  <ele>1.0</ele>
  <time>2025-06-01T08:00:00Z</time>
  <name>LBMZFM-01</name>
  <desc>WAQuokkaAdLa087</desc>
  <url>https://labs.geocaching.com/goto/9415d44b-02bd-47cb-bc72-5d3510666b87</url>
  <urlname>WAQuokka AdLab Art #052 : S1  Coastline by MummaBear5</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1608" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #052 : S1  Coastline</groundspeak:name>
   <groundspeak:placed_by>MummaBear5</groundspeak:placed_by>
   <groundspeak:owner id="">MummaBear5</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #052&lt;/h3&gt;&lt;h4&gt; Coastline&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/9415d44b-02bd-47cb-bc72-5d3510666b87"&gt;https://labs.geocaching.com/goto/9415d44b-02bd-47cb-bc72-5d3510666b87&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Approximately how many beaches are there in W.A?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/d736a2be-6ede-46ee-b946-32dbbaf95d3e" /&gt;&lt;/p&gt;&lt;p&gt;With 12,500 kilometres of coastline and about 3,500 beaches, Western Australia is a beach bum haven. Here you'll find some of the world's most gorgeous sceneries, cleanest waters, mesmerizing sunsets, abundant coral reefs, and a diverse range of the rarest wildlife. The best thing about it is you don't have to hustle for beach space. On the contrary, you can have some spots all to yourself.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/23d691a8-a479-4c3d-8128-a93d3a462fe7" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.

To join this project, please contact the project Admins on WAQuokkaAdLab@gmail.com
&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.0528" lon="115.7394">
  <ele>1.0</ele>
  <time>2025-06-01T08:00:00Z</time>
  <name>LBMZFM-02</name>
  <desc>WAQuokkaAdLa05u</desc>
  <url>https://labs.geocaching.com/goto/9415d44b-02bd-47cb-bc72-5d3510666b87</url>
  <urlname>WAQuokka AdLab Art #052 : S2 Busseton Jetty by MummaBear5</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1609" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #052 : S2 Busseton Jetty</groundspeak:name>
   <groundspeak:placed_by>MummaBear5</groundspeak:placed_by>
   <groundspeak:owner id="">MummaBear5</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #052&lt;/h3&gt;&lt;h4&gt;Busseton Jetty &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/9415d44b-02bd-47cb-bc72-5d3510666b87"&gt;https://labs.geocaching.com/goto/9415d44b-02bd-47cb-bc72-5d3510666b87&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;How long is the Busselton Jetty?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/eaa8cdde-0f27-4ab5-8b72-e79bd356cac3" /&gt;&lt;/p&gt;&lt;p&gt;Stretching over 1.8 kilometres into the waters of Geographe Bay, the 155-year-old Busselton Jetty is the longest timber-piled pier in the Southern Hemisphere. This world heritage dock takes about 25 minutes to walk each way. There is an underwater observatory at the end of the jetty, where you can descend eight metres below the waves to view over 300 marine species.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/23d691a8-a479-4c3d-8128-a93d3a462fe7" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.

To join this project, please contact the project Admins on WAQuokkaAdLab@gmail.com
&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.05195" lon="115.739417">
