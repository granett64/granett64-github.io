   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;State War Memorial&lt;/h3&gt;&lt;h4&gt;Pool of Reflection&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/7a6e9012-f72d-4f8e-bfb8-02ba69341b4a"&gt;https://labs.geocaching.com/goto/7a6e9012-f72d-4f8e-bfb8-02ba69341b4a&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;At this location there is a plaque with four countries listed. What is the first country listed?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/617bdd82-f6f7-49f9-891d-99f78256fb65" /&gt;&lt;/p&gt;&lt;p&gt;The centrepiece of the Pool of Reflection in the commemorative courtyard is the Eternal Flame. It is a perpetual reminder of the service and sacrifice of more than 100,000 Australians who have given their lives in war. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/fb354e4e-60af-40f6-aaa8-cb25e295c76b" /&gt;&lt;/p&gt;&lt;p&gt;The State War Memorial Precinct is located on Mount Eliza overlooking Perth Water. The precinct comprises of the Cenotaph, Court of Contemplation, Flame of Remembrance and Pool of Reflection; with memorials to various battles, military units, prisoners of war and other groups found throughout the parklands.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/41f3b956-ad32-4819-8ef4-6bcc5bb70ec8" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Congratulations&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.9606" lon="115.843633">
  <ele>71.0</ele>
  <time>2022-06-09T08:00:00Z</time>
  <name>LBXsWP-01</name>
  <desc>StateWarMemori1</desc>
  <url>https://labs.geocaching.com/goto/7a6e9012-f72d-4f8e-bfb8-02ba69341b4a</url>
  <urlname>State War Memorial : S1 Court of Contemplation by Barnzy12</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99003661" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>State War Memorial : S1 Court of Contemplation</groundspeak:name>
   <groundspeak:placed_by>Barnzy12</groundspeak:placed_by>
   <groundspeak:owner id="">Barnzy12</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;State War Memorial&lt;/h3&gt;&lt;h4&gt;Court of Contemplation&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/7a6e9012-f72d-4f8e-bfb8-02ba69341b4a"&gt;https://labs.geocaching.com/goto/7a6e9012-f72d-4f8e-bfb8-02ba69341b4a&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;In the break in the wall, there is a plaque that commemorates the placing of a …… by Queen Elizabeth (one word - 6 letters)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/30518825-aebb-48da-b7df-a71a07864842" /&gt;&lt;/p&gt;&lt;p&gt;The Court of Contemplation is located at the western side of the precinct and was unveiled on 6 November 1955 by Sir Charles Gardner. It commemorates the conflicts in which Western Australians have fallen, with the walls featuring the names of major battlefields.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/fb354e4e-60af-40f6-aaa8-cb25e295c76b" /&gt;&lt;/p&gt;&lt;p&gt;The State War Memorial Precinct is located on Mount Eliza overlooking Perth Water. The precinct comprises of the Cenotaph, Court of Contemplation, Flame of Remembrance and Pool of Reflection; with memorials to various battles, military units, prisoners of war and other groups found throughout the parklands.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/3a1cea42-7988-434d-8c4f-17afc2cd6a73" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Congratulations &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
