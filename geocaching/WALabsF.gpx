   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Fremantle Line (Transperth)&lt;/h3&gt;&lt;h4&gt;Subiaco Station &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/2dd70f6e-870c-43ef-acc6-582fe8369255"&gt;https://labs.geocaching.com/goto/2dd70f6e-870c-43ef-acc6-582fe8369255&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Was this Station the first underground railway station in Perth?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/db757124-b1e8-491c-84a3-20fb94959e78" /&gt;&lt;/p&gt;&lt;p&gt;Subiaco railway station is a railway station on the Transperth network in Western Australia. It is located on the Fremantle line and Airport line, 3.7 kilometres (2.3 mi) from Perth station serving the suburbs of Subiaco and Wembley.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/9167c011-5506-4743-8851-7bc3196b5250" /&gt;&lt;/p&gt;&lt;p&gt;The Fremantle Line is one of Perth's suburban rail lines running from Perth Station to Fremantle Station. The Line originally opened on the 1st March 1881 and since then it has undergone major changes like the electrification of the line which took place in the early 1990's. It is now one of Perth's busiest rail lines carrying around 5 million passengers per year. &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
