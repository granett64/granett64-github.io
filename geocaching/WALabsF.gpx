  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9733318" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Lancelin- A Water Paradise (2) : S5 A place to relax in the sun?</groundspeak:name>
   <groundspeak:placed_by>Paskersfind</groundspeak:placed_by>
   <groundspeak:owner id="">Paskersfind</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Lancelin- A Water Paradise (2)&lt;/h3&gt;
    &lt;h4&gt;A place to relax in the sun?&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/e38f93af-6fd7-4cc1-9a4c-ff634eb7e3f7" target="_blank"&gt;https://labs.geocaching.com/goto/e38f93af-6fd7-4cc1-9a4c-ff634eb7e3f7&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 20m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;How many vertical wooden planks make up the back of this chair? (1 digit)&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c57c28b6-202b-4d91-b96c-e0fa5c984878" /&gt;&lt;/p&gt;
    &lt;p&gt;Another quirky, oversized "photo op" in Lancelin, this giant deck chair has seen quite a few incarnations and is currently painted as a reminder to drive safely. [April,2026]  It is designed to celebrate Lancelin&amp;#039;s laid-back beach culture and give visitors a memorable spot to stop, stretch their legs and take a classic shot on their way to the dunes or wherever !&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/938fe1a2-5130-4120-90e1-c655bce3f723" /&gt;&lt;/p&gt;
    &lt;p&gt;This Adventure Lab continues the tour around Lancelin that began in the Welcome to Lancelin (1).&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.014667" lon="115.328617">
  <ele>9.0</ele>
  <time>2026-04-28T08:00:00Z</time>
  <name>LBRK28-3</name>
  <desc>LancelinAWate23</desc>
  <url>https://labs.geocaching.com/goto/e38f93af-6fd7-4cc1-9a4c-ff634eb7e3f7</url>
  <urlname>Lancelin- A Water Paradise (2) : S3 Jetty - Seal of Approval by Paskersfind</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9733316" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Lancelin- A Water Paradise (2) : S3 Jetty - Seal of Approval</groundspeak:name>
   <groundspeak:placed_by>Paskersfind</groundspeak:placed_by>
   <groundspeak:owner id="">Paskersfind</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Lancelin- A Water Paradise (2)&lt;/h3&gt;
    &lt;h4&gt;Jetty - Seal of Approval&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/e38f93af-6fd7-4cc1-9a4c-ff634eb7e3f7" target="_blank"&gt;https://labs.geocaching.com/goto/e38f93af-6fd7-4cc1-9a4c-ff634eb7e3f7&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 20m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;How many metres on land is it recommended that you keep away from sea lions? (2digits)&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/602a3dbb-4327-44a5-9a2b-5acc19ceab10" /&gt;&lt;/p&gt;
    &lt;p&gt;This information sign details facts about the Australian Sea Lions which are one of the rarest sea lion species in the world and live only along the western and southern Australian coasts. Lancelin Island is one of their hangouts and visitors venture there at their own risk.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
