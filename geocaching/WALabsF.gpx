 <wpt lat="-33.326067" lon="115.6368">
  <ele>15.0</ele>
  <time>2021-10-10T08:00:00Z</time>
  <name>LBBq4i-04</name>
  <desc>RSHPS4JohnForre</desc>
  <url>https://labs.geocaching.com/goto/91e60a96-a610-4881-8d81-0500d6c563b5</url>
  <urlname>[L] Roundabouts, Sculptures, and high points : S4 John Forrest by LAXA</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918634" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Roundabouts, Sculptures, and high points : S4 John Forrest</groundspeak:name>
   <groundspeak:placed_by>LAXA</groundspeak:placed_by>
   <groundspeak:owner id="">LAXA</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Roundabouts, Sculptures, and high points&lt;/h3&gt;&lt;h4&gt;John Forrest&lt;/h4&gt;&lt;p&gt;&lt;span style="background:#990000;color:#fff;border-radius:5px;padding:3px 5px;"&gt;linear&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/91e60a96-a610-4881-8d81-0500d6c563b5"&gt;https://labs.geocaching.com/goto/91e60a96-a610-4881-8d81-0500d6c563b5&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What year was the St Paul's Anglican church built on this site?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/8da72266-cb8d-499b-93d0-b983157025dd" /&gt;&lt;/p&gt;&lt;p&gt;Sir John Forrest GCMG (22 August 1847 – 2 September 1918) was an Australian explorer and politician. 
Born in Bunbury, Western Australia, to Scottish immigrant parents.
He was the first premier of Western Australia (1890–1901) and a long-serving cabinet minister in federal politics.
Close to the bust of Sir John Forrest, you will find an additional plaque commemorating the St Paul's Anglican church built on this site. 

&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/61bb6502-37b6-4311-96ed-7401fe9c8920" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to Bunbury's first Adventure labcache.

This little tour of a little under 2 km will take you to some interesting artwork and spectacular views. 
Please note: there is no bonus cache as we are too far to maintain one.
&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/1ca86a74-fe3c-46f9-b6a7-9f8a4e70b560" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Well done &lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
