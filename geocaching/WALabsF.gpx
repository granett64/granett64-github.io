  <name>LBxRVg-01</name>
  <desc>WAQuokkaAdLab47</desc>
  <url>https://labs.geocaching.com/goto/bb9dbc7c-c98c-43e5-a443-a6510b14c8ae</url>
  <urlname>WAQuokka AdLab Art #47 : S1 Home of the America’s Cup:  The 1983 Challenge by m4yb</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-1552" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #47 : S1 Home of the America’s Cup:  The 1983 Challenge</groundspeak:name>
   <groundspeak:placed_by>m4yb</groundspeak:placed_by>
