   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Dunsborough Travels&lt;/h3&gt;&lt;h4&gt;Fun and food&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/379e47bd-a4d6-483d-b017-abb87b4090a7"&gt;https://labs.geocaching.com/goto/379e47bd-a4d6-483d-b017-abb87b4090a7&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is the later year on the sign&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/1eefd5ee-5467-4ccf-88af-82ec36f1bf00" /&gt;&lt;/p&gt;&lt;p&gt;This location is a great little asset for the surrounding area it has a playground, exercise equipment, bbq, quick access to the beach, shade even a shower to wash of the sand after. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/1ce9e081-814b-4a64-be6a-1a5bc01f3a7c" /&gt;&lt;/p&gt;&lt;p&gt;This is a unique adventure because it involves visiting locations that have outstanding beauty and includes places that have piqued our geocaching adventures&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;Award Message:&lt;br /&gt;Congratulations on finding this little oasis&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
