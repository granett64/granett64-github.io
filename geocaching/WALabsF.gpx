   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">
                                                                                                                                        &lt;h3&gt;Woodanilling Heritage Walk 1&lt;/h3&gt;
    &lt;h4&gt;CWA&lt;/h4&gt;


&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/71c0ff60-43b7-4697-8c23-780a79189d85" target="_blank"&gt;https://labs.geocaching.com/goto/71c0ff60-43b7-4697-8c23-780a79189d85&lt;/a&gt;&lt;/p&gt;

    &lt;p&gt;Radius: 20m&lt;/p&gt;

    &lt;p&gt;Stages: 5&lt;/p&gt;


    &lt;p&gt;Kind of question:
                    single
            &lt;/p&gt;
    &lt;p&gt;Question:&lt;br /&gt;When was the CWA Hall completed?&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Waypoint Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/cb9c871d-21c5-4816-88d7-a598a9213e8a" /&gt;&lt;/p&gt;
    &lt;p&gt;The inaugural meeting of the local branch of the Country Women&amp;#039;s Association (C.W.A.) was held in September
1934. After 8 months of operation it had 14 members and soon it became the "caterer of choice for all kinds of sporting, social, community and business events.&lt;/p&gt;

    &lt;hr /&gt;
    &lt;h5&gt;Adventure Lab Description&lt;/h5&gt;
    &lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/51ad4b75-6c9c-491d-aba2-d8bce663a9bb" /&gt;&lt;/p&gt;
    &lt;p&gt;Opened in 2008, the Woodanilling Heritage Walk consists of 13 panels on a short walk around the townsite. There are old black and white photos on each panel together with stories about Woodanilling’s people and places. Heritage Walk guides are available at the Shire office.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-33.563567" lon="117.432483">
  <ele>289.0</ele>
  <time>2026-07-19T08:00:00Z</time>
  <name>LBTV63-5</name>
  <desc>WoodanillingH15</desc>
  <url>https://labs.geocaching.com/goto/71c0ff60-43b7-4697-8c23-780a79189d85</url>
  <urlname>Woodanilling Heritage Walk 1 : S5 Shire Hall by Leg5</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9769955" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Woodanilling Heritage Walk 1 : S5 Shire Hall</groundspeak:name>
   <groundspeak:placed_by>Leg5</groundspeak:placed_by>
   <groundspeak:owner id="">Leg5</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
