   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Centenary Park&lt;/h3&gt;&lt;h4&gt;War Memorial&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/80116ab4-5884-4d7f-9c67-a189511315fe"&gt;https://labs.geocaching.com/goto/80116ab4-5884-4d7f-9c67-a189511315fe&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;To the right of the large pillar is a small pillar which has the badge of the Royal ………. … ….. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/d32197d4-1bd6-498e-a171-3b8c0b6a3190" /&gt;&lt;/p&gt;&lt;p&gt;The war memorial is the first place you walk into when entering Centenary Park off Memorial Road. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/3cdf6088-e8c2-4881-860e-0246555679c5" /&gt;&lt;/p&gt;&lt;p&gt;Centenary park is located on Albany Highway at the junction of Memorial Avenue, opposite the Plantagenet District Hall.  It encompasses the War Memorial and the We Remember Them Walk.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
