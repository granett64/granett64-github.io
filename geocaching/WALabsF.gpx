   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Manjimup Heritage Connections&lt;/h3&gt;&lt;h4&gt;Cattle Trails &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/00042f75-d1bf-4c38-a081-da6d225f4169"&gt;https://labs.geocaching.com/goto/00042f75-d1bf-4c38-a081-da6d225f4169&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What month would they bring cattle back from the coast? (One word)&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/72e060d6-b9f7-4f2b-83db-e4800cca83fc" /&gt;&lt;/p&gt;&lt;p&gt;This plaque here commemorates those whose drove cattle to the coast for their annual summer grazing. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/46bfd7ba-b6f3-47a8-a735-eb6d4917f93b" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the sleepy town of Manjimup in WA's lower south west. Manjimup has a rich history of thriving industries that can still be seen today. These include the apple orchards of the that surround the town, the butter factory that brought industrialisation to the farmers of the community, the trails that the farmers drove there cattle on there seasonal grazing patterns, the cream truck which connected Walpole to the Manjimup area and lastly one very important figure in the history of Northcliffe 'Doc' Ryan who served for 43 years bringing much needed medical expertise to the region. This adlab aims to take you to all these important sites and learn a little about the history of the Shire.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
