  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9750005" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Creery Wetlands Reserve : S5 The End Of The Boardwalk</groundspeak:name>
   <groundspeak:placed_by>CanD3s</groundspeak:placed_by>
   <groundspeak:owner id="">CanD3s</groundspeak:owner>
