  <url>https://labs.geocaching.com/goto/Notforget</url>
  <urlname>[L] Lets not Forget : S2 Oldest stone church by Falcon351</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476909735" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>[L] Lets not Forget : S2 Oldest stone church</groundspeak:name>
