 <wpt lat="-31.908667" lon="115.793567">
  <ele>11.0</ele>
  <time>2022-12-05T08:00:00Z</time>
  <name>LBanU1-02</name>
  <desc>JACKADDERJAUNT2</desc>
  <url>https://labs.geocaching.com/goto/402a8d7e-5eb2-40a5-98fc-77fb06b7e28a</url>
  <urlname>JACKADDER JAUNT : S2 BIODIVERSITY by m4yb</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-628" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>JACKADDER JAUNT : S2 BIODIVERSITY</groundspeak:name>
