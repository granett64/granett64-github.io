   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #023&lt;/h3&gt;&lt;h4&gt;Prison Tunnels &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/034e1012-bfa7-4062-9365-3fc82b458a4b"&gt;https://labs.geocaching.com/goto/034e1012-bfa7-4062-9365-3fc82b458a4b&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What was the purpose of the tunnels? &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/b59571dc-2371-4248-8ea2-2cdf7184d230" /&gt;&lt;/p&gt;&lt;p&gt;A tunnel network exists under the prison, including a one-kilometre (0.6 mi) connection to South Beach in South Fremantle. The tunnels shut down in 1910, but water still irrigates the prison gardens.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/e623438e-fd44-4ad6-b804-36293b09b351" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on the stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal. 

To join this project, please contact the project admins at WAQuokkaAdLab@gmail.com&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
