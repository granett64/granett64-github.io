  <desc>LSSBS3DairyCatt</desc>
  <url>https://labs.geocaching.com/goto/StarSwampBushland</url>
  <urlname>[L] Star Swamp Bushland : S3 Dairy Cattle by iluvtrekking</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
