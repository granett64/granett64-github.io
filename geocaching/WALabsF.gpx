  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="9678125" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Kings Park Memorials at Saw Avenue : S4 2/28th Infantry Battalion &amp; 24th Anti Tank Company</groundspeak:name>
   <groundspeak:placed_by>GandJWA</groundspeak:placed_by>
   <groundspeak:owner id="">GandJWA</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
