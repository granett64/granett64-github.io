   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Hidden Suburban Art &lt;/h3&gt;&lt;h4&gt;Australia at the Railway markets&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/7152a471-7de7-4efc-8e35-b2905d5f4cae"&gt;https://labs.geocaching.com/goto/7152a471-7de7-4efc-8e35-b2905d5f4cae&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What TYPE of animal can you see in the bottom right hand corner of the red mural part?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/8b49700f-15f7-40a7-a70e-c5924b07bd94" /&gt;&lt;/p&gt;&lt;p&gt;Facing the wall at this location you will find a colourful depiction of people and animals of Australia.
&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/979c4783-24fa-4cc7-abaa-9609b17fa833" /&gt;&lt;/p&gt;&lt;p&gt;This little tour will take you around the heart of Gosnells to some obvious and some less obvious examples of suburban street art, celebrating culture, heritage and diversity in the City.
You can park your car at the first location (the Railway markets in Gosnells), the tour will loop you back here, should you choose to do them in order. We can recommend a stop at the nearby pub as a reward. &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/38e72a5f-731f-4b04-a687-b587f26bed0a" /&gt;&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.069867" lon="116.001317">
