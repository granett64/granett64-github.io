  <urlname>[L] Melville Places 2 : S4 Weather Figure by .tbh</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-620" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
