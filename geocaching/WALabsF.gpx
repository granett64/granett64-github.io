  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="-175" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Historical Buildings of York : S5 The Court House</groundspeak:name>
   <groundspeak:placed_by>Diadem</groundspeak:placed_by>
   <groundspeak:owner id="">Diadem</groundspeak:owner>
