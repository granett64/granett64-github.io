   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Lake Goollelal - Western Side&lt;/h3&gt;&lt;h4&gt;Southern end &lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/c94d66a4-2fd8-41af-9a5f-f8e0782aeef6"&gt;https://labs.geocaching.com/goto/c94d66a4-2fd8-41af-9a5f-f8e0782aeef6&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;On the sign with 3 plaques. The middle plaque what animal is displayed?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/54961f26-fb23-472c-bfe8-e1ed655d17f2" /&gt;&lt;/p&gt;&lt;p&gt;This is the southern end of Lake Goollelal. I wonder if you will return the same way or continue around the Lake. Have you seen any wildflowers?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/712b541b-e31b-40d7-8dd0-87eeb8f53888" /&gt;&lt;/p&gt;&lt;p&gt;Walk or cycle on the 4.5 kilometre path around Lake Goollelal and enjoy the richness and beauty of Perth metropolitan bushland in Yellagonga Regional Park. This Adventure Lab will help you enjoy the Eastern side of the Lake.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
