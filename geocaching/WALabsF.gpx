  <urlname>Golden Pipeline Trail - Meckering : S3 Salisbury Ruins by geotrakka</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476915757" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Golden Pipeline Trail - Meckering : S3 Salisbury Ruins</groundspeak:name>
   <groundspeak:placed_by>geotrakka</groundspeak:placed_by>
   <groundspeak:owner id="">geotrakka</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Golden Pipeline Trail - Meckering&lt;/h3&gt;&lt;h4&gt;Salisbury Ruins&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/944ff8d0-ccde-4143-8931-2e6fa251610c"&gt;https://labs.geocaching.com/goto/944ff8d0-ccde-4143-8931-2e6fa251610c&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What time did the earthquake hit? &lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/7846214d-9810-4f35-af37-e97178c3e4b7" /&gt;&lt;/p&gt;&lt;p&gt;Mr &amp; Mrs Snooke and their toddler incredibly managed to live to tell the story after their house was destroyed in the earthquake.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/2607e740-9581-4825-8507-65fe73ace4d1" /&gt;&lt;/p&gt;&lt;p&gt;The Golden Pipeline Heritage Trail follows the water pipeline conceived by C.Y.O'Connor to supply the Goldfields of Western Australia with much needed fresh water.
Meckering - a town along the way, benefited from the pipeline and still does today. Once a thriving country town, the devastation of an earthquake in 1968 flattened the town and it has never fully recovered.
This Adventure Lab will take you on a trip into the history of this little town.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.6326" lon="117.00685">
  <ele>205.0</ele>
