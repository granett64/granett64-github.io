  <urlname>Turquoise Way Path- Jurien Bay : S1  Historical Old Jetty  Memorial Site by neva2old</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="99000338" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>Turquoise Way Path- Jurien Bay : S1  Historical Old Jetty  Memorial Site</groundspeak:name>
   <groundspeak:placed_by>neva2old</groundspeak:placed_by>
   <groundspeak:owner id="">neva2old</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country>Australia</groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;Turquoise Way Path- Jurien Bay&lt;/h3&gt;&lt;h4&gt; Historical Old Jetty  Memorial Site&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/a686750b-5c7f-432e-8e55-2399a75d2552"&gt;https://labs.geocaching.com/goto/a686750b-5c7f-432e-8e55-2399a75d2552&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What type of manure was shipped by early settlers?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/df194fb0-9244-4a7b-afa2-fa221566a9d5" /&gt;&lt;/p&gt;&lt;p&gt;The jetty was built in 1885 and this memorial marks the location of a structure that is no more. The memorial consists of a limestone boulder with two plaques affixed and at the rear, a limestone block structure with information panels. Worth a look for the history.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/c2f40ad7-e469-4443-a865-1ec5ebc4c973" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to The Turquoise Way Path which starts at the Jurien Bay Boat Harbour and extends 13.5km to the mouth of the Hill River. The path is fully sealed and suitable of  walking, running, cycling, skating, prams and scooters and will take  you along the beautiful coastline.&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Award Information&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/e31dabed-76e7-4669-ac34-80f985685b48" /&gt;&lt;/p&gt;&lt;p&gt;Award Message:&lt;br /&gt;Excellent!  Keep on moving there is so much to see.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-31.95665" lon="115.95685">
