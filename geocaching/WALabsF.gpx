 <wpt lat="-32.052083" lon="115.74115">
  <ele>2.0</ele>
  <time>2025-06-07T08:00:00Z</time>
  <name>LBHYZm-03</name>
  <desc>WAQuokkaAdLa137</desc>
  <url>https://labs.geocaching.com/goto/fc0c18e4-cb6c-4f15-995e-4a16636e1b9a</url>
  <urlname>WAQuokka AdLab Art #086 : S3 Matt Parkinson by BernieH</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918943" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #086 : S3 Matt Parkinson</groundspeak:name>
   <groundspeak:placed_by>BernieH</groundspeak:placed_by>
   <groundspeak:owner id="">BernieH</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #086&lt;/h3&gt;&lt;h4&gt;Matt Parkinson&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/fc0c18e4-cb6c-4f15-995e-4a16636e1b9a"&gt;https://labs.geocaching.com/goto/fc0c18e4-cb6c-4f15-995e-4a16636e1b9a&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What is Matt's nickname on the TV show, The Chase?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/7ffbfb80-0970-4724-9dbf-6b1acf4e8db5" /&gt;&lt;/p&gt;&lt;p&gt;Matt Parkinson began his career in theatre but is best known for his work in comedy. As one half of the comedy duo Empty Pockets, he gained national attention through regular appearances on The Big Gig and Full Frontal. He later became a familiar voice on Triple M’s The Cage and a comedic presence on shows like The Einstein Factor, Comedy Slapdown, and Sleuth 101. Known for his sharp wit and quick thinking, Parkinson's comedy credentials helped earn him a role on The Chase Australia, where he continues to showcase his blend of intelligence and humour.
Born in Perth!&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/d32df207-a7f6-447f-a938-ac235d53a4cb" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.0521" lon="115.741183">
  <ele>2.0</ele>
  <time>2025-06-07T08:00:00Z</time>
  <name>LBHYZm-04</name>
  <desc>WAQuokkaAdLa138</desc>
  <url>https://labs.geocaching.com/goto/fc0c18e4-cb6c-4f15-995e-4a16636e1b9a</url>
  <urlname>WAQuokka AdLab Art #086 : S4 Sarah Lawrence by BernieH</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918945" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #086 : S4 Sarah Lawrence</groundspeak:name>
   <groundspeak:placed_by>BernieH</groundspeak:placed_by>
   <groundspeak:owner id="">BernieH</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #086&lt;/h3&gt;&lt;h4&gt;Sarah Lawrence&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/fc0c18e4-cb6c-4f15-995e-4a16636e1b9a"&gt;https://labs.geocaching.com/goto/fc0c18e4-cb6c-4f15-995e-4a16636e1b9a&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;What TV show did Sarah host?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/4979148b-1d1e-4fe6-9f30-90c357d5b07a" /&gt;&lt;/p&gt;&lt;p&gt;Sarah Lawrence began her career in modelling and television, appearing on Australia’s Next Top Model and later hosting roles on Wake Up! WA and MTV's VJ search. After moving to Melbourne, she worked extensively in live events and media before shifting her focus to comedy. Her breakout acting role in the comedy film Stone Bros. earned critical acclaim and multiple award nominations, showcasing her natural comedic talent. Now, she is increasingly recognised for her sharp wit and engaging presence as a comedian.
Born in Perth!&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/d32df207-a7f6-447f-a938-ac235d53a4cb" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
 <wpt lat="-32.052133" lon="115.741217">
  <ele>2.0</ele>
  <time>2025-06-07T08:00:00Z</time>
  <name>LBHYZm-05</name>
  <desc>WAQuokkaAdLa139</desc>
  <url>https://labs.geocaching.com/goto/fc0c18e4-cb6c-4f15-995e-4a16636e1b9a</url>
  <urlname>WAQuokka AdLab Art #086 : S5 Terry Scanlon by BernieH</urlname>
  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476918947" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>WAQuokka AdLab Art #086 : S5 Terry Scanlon</groundspeak:name>
   <groundspeak:placed_by>BernieH</groundspeak:placed_by>
   <groundspeak:owner id="">BernieH</groundspeak:owner>
   <groundspeak:type>Lab Cache</groundspeak:type>
   <groundspeak:container>Virtual</groundspeak:container>
   <groundspeak:attributes>
   </groundspeak:attributes>
   <groundspeak:difficulty>1</groundspeak:difficulty>
   <groundspeak:terrain>1</groundspeak:terrain>
   <groundspeak:country></groundspeak:country>
   <groundspeak:state>Western Australia</groundspeak:state>
   <groundspeak:short_description html="True"> </groundspeak:short_description>
   <groundspeak:long_description html="True">&lt;h3&gt;WAQuokka AdLab Art #086&lt;/h3&gt;&lt;h4&gt;Terry Scanlon&lt;/h4&gt;&lt;p&gt;&lt;a href="https://labs.geocaching.com/goto/fc0c18e4-cb6c-4f15-995e-4a16636e1b9a"&gt;https://labs.geocaching.com/goto/fc0c18e4-cb6c-4f15-995e-4a16636e1b9a&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Question:&lt;br /&gt;Scanlon performed alongside artists such as?&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Waypoint Description&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/a73609f9-9139-4f15-9c9a-677d62b8d903" /&gt;&lt;/p&gt;&lt;p&gt;Terry Scanlon was an Australian comedian and pantomime artist. He was one of Australia's top comedians; he worked with some of the early greats of Australian comedy, including Roy Rene and George Wallace. In the 1930s, however, he was one of the vanguards to modernise comedy out of baggy suits, funny face make up and slapstick into the more modern stand up style comedian - in a tailored suit, the only prop a cigarette in hand, delivering gags. His role in the evolution of Australian comedy was acknowledged in a tribute by Joe Martin when he was honoured as a life member of the "ECHINDAS" by his peers years later.
Born In Perth!&lt;/p&gt;&lt;hr /&gt;&lt;h5&gt;Adventure Lab Descriptions&lt;/h5&gt;&lt;p&gt;&lt;img src="https://gsmediadata.blob.core.windows.net/mediacontainer/d32df207-a7f6-447f-a938-ac235d53a4cb" /&gt;&lt;/p&gt;&lt;p&gt;Welcome to the WAQuokka AdLab art series - which intends to form a giant quokka off the coast of Perth. There is a 500m geofence on stages which allows the AdLabs to be solved from between the Fremantle Maritime Museum and the Rottnest Ferry Terminal.&lt;/p&gt;</groundspeak:long_description>
    <groundspeak:encoded_hints></groundspeak:encoded_hints>
   <groundspeak:logs>
  </groundspeak:logs>
   <groundspeak:travelbugs>
   </groundspeak:travelbugs>
</groundspeak:cache>
</wpt>
