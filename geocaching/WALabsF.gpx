  <sym>Geocache</sym>
  <type>Geocache|Lab Cache</type>
  <groundspeak:cache id="1476915769" available="True" archived="False" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
   <groundspeak:name>"Its All About The Kids" in Toodyay! : S1 Toodyay Mini Railway</groundspeak:name>
